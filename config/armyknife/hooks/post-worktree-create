#!/bin/bash
# post-worktree-create hook for armyknife.
# Called by `a agent new --worktree` after creating a git worktree.
#
# armyknife discovers this file at $XDG_CONFIG_HOME/armyknife/hooks/post-worktree-create
# (defaults to ~/.config/armyknife/hooks/post-worktree-create).
# See: https://github.com/fohte/armyknife/blob/main/src/shared/hooks.rs
#
# Environment variables set by armyknife:
#   ARMYKNIFE_WORKTREE_PATH - absolute path to the newly created worktree
#   ARMYKNIFE_BRANCH_NAME   - branch name associated with the worktree
#   ARMYKNIFE_REPO_ROOT     - root path of the original git repository
#
# A failing hook rolls back the worktree and branch: new branches are deleted,
# and existing branches overwritten with --force are restored to their prior tip.
set -euo pipefail

hook_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "${ARMYKNIFE_WORKTREE_PATH:-}" ]]; then
  exit 0
fi

# Record the delegated task's motivation (set by delegate skill) so
# create-pr can use it as the highest-priority source for the PR body's Why.
# `|| true`: a failure here must not roll back the whole worktree over metadata.
if [[ -n "${DELEGATE_TASK_PURPOSE:-}" ]]; then
  git -C "$ARMYKNIFE_WORKTREE_PATH" config \
    "branch.${ARMYKNIFE_BRANCH_NAME:-}.x-purpose" \
    "$DELEGATE_TASK_PURPOSE" || true
fi

# Read by the delegate's create-pr skill to link its PR to the delegating session's task.
if [[ -n "${DELEGATE_TQ_TASK_ID:-}" ]]; then
  git -C "$ARMYKNIFE_WORKTREE_PATH" config \
    "branch.${ARMYKNIFE_BRANCH_NAME:-}.x-tq-task-id" \
    "$DELEGATE_TQ_TASK_ID" || true
fi

# Keep the item ID on its branch so parallel delegates cannot link to the wrong checklist item.
if [[ -n "${DELEGATE_TQ_CHECKLIST_ITEM_ID:-}" ]]; then
  git -C "$ARMYKNIFE_WORKTREE_PATH" config \
    "branch.${ARMYKNIFE_BRANCH_NAME:-}.x-tq-checklist-item-id" \
    "$DELEGATE_TQ_CHECKLIST_ITEM_ID" || true
fi

# Run bootstrap script if present (e.g. mise install, dependency install).
# --worktree skips lefthook install since worktrees share the parent's .git/hooks.
# Non-fatal: branches under repair often carry a stale lockfile, and a rollback
# here pushes callers to --skip-hooks, which also drops the trust registration below.
bootstrap="$ARMYKNIFE_WORKTREE_PATH/scripts/bootstrap"
if [[ -x "$bootstrap" ]]; then
  "$bootstrap" --worktree ||
    echo "warning: $bootstrap failed; dependencies may be missing in $ARMYKNIFE_WORKTREE_PATH" >&2
fi

# Create .marksman.toml in new worktrees so that marksman LSP can detect the project root.
# In worktrees, .git is a file (not a directory), which marksman's Directory.Exists() check
# doesn't recognize. .marksman.toml serves as an alternative root marker.
if [ ! -f "$ARMYKNIFE_WORKTREE_PATH/.marksman.toml" ]; then
  touch "$ARMYKNIFE_WORKTREE_PATH/.marksman.toml"
fi

# Copy git-ignored .env files from the original repo root to the new worktree.
# Tracked .env files are already present via git worktree, so only ignored ones
# (containing local secrets, overrides, etc.) need to be copied explicitly.
if [[ -n "${ARMYKNIFE_REPO_ROOT:-}" ]]; then
  for f in "$ARMYKNIFE_REPO_ROOT"/.env*; do
    [[ -f "$f" ]] || continue
    basename="$(basename "$f")"
    # Skip if the file is tracked by git (not ignored)
    if git -C "$ARMYKNIFE_REPO_ROOT" check-ignore -q "$f" 2> /dev/null; then
      cp "$f" "$ARMYKNIFE_WORKTREE_PATH/$basename"
    fi
  done
fi

# Trust registration is non-critical metadata, so errors must not roll back the
# worktree creation.
# shellcheck source=register-project-trust.bash disable=SC1091
if source "$hook_dir/register-project-trust.bash"; then
  register_project_trust "$ARMYKNIFE_WORKTREE_PATH" || true
fi
