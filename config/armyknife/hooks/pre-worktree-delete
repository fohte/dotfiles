#!/bin/bash
# pre-worktree-delete hook for armyknife.
# Called by `a wm delete` (aliases: d, rm) before removing the worktree directory.
#
# armyknife discovers this file at $XDG_CONFIG_HOME/armyknife/hooks/pre-worktree-delete
# (defaults to ~/.config/armyknife/hooks/pre-worktree-delete).
# See: https://github.com/fohte/armyknife/blob/master/docs/hooks.md
#
# Environment variables set by armyknife:
#   ARMYKNIFE_WORKTREE_PATH - absolute path to the worktree being deleted
#   ARMYKNIFE_BRANCH_NAME   - branch name of the worktree (may be empty)
#   ARMYKNIFE_REPO_ROOT     - root path of the parent repository
#
# Hook errors are non-fatal (best-effort): armyknife logs a warning and
# deletes the worktree anyway.
set -euo pipefail

if [[ -z "${ARMYKNIFE_WORKTREE_PATH:-}" ]]; then
  exit 0
fi

# Stop the crit (https://crit.md) review daemon serving this worktree. Without
# this, the daemon outlives the directory it was serving and hangs on git/file
# operations against a path that no longer exists: it has no idle timeout and
# only detaches from its cwd once the client is gone.
#
# crit resolves the daemon from cwd + branch, hence the cd. A daemon started in a
# subdirectory of the worktree, or left on a branch that is no longer checked
# out, is not resolved and still leaks.
cd "$ARMYKNIFE_WORKTREE_PATH"

# `crit stop` exits non-zero when it resolves no daemon, which is the normal
# state for a worktree that was never reviewed; the gate keeps that out of
# armyknife's warning path.
daemon_running="$(crit status --json | jq -r '.daemon.running')"
if [[ "$daemon_running" == "true" ]]; then
  crit stop > /dev/null
fi
