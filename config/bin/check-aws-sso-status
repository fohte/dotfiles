#!/bin/bash
#
# check-aws-sso-status - Check AWS SSO session status
#
# Exit codes:
#   0: session is valid
#   1: session is expired/invalid
#   2: AWS SSO not configured
#
# Runs on every starship prompt, where spawning a subprocess costs more than any
# work done here, so the file scan and the JSON read use only builtins.

set -euo pipefail

cache_dir="${HOME}/.aws/sso/cache"
if [[ ! -d "$cache_dir" ]]; then
  exit 2
fi

# awscli writes these flat, so a non-recursive glob reaches all of them.
shopt -s nullglob
newest=
for f in "$cache_dir"/*.json; do
  if [[ -z "$newest" || "$f" -nt "$newest" ]]; then
    newest="$f"
  fi
done
if [[ -z "$newest" ]]; then
  exit 1
fi

# `-d ''` slurps the whole file. No NUL is ever found, so read reports EOF with
# status 1 even though it filled the variable.
content=
IFS= read -r -d '' content < "$newest" || true

expires_at="${content#*\"expiresAt\"}"
if [[ "$expires_at" == "$content" ]]; then
  exit 1
fi
# Drop the `: ` separator up to the value's opening quote, then the rest of the
# document from its closing quote on.
expires_at="${expires_at#*\"}"
expires_at="${expires_at%%\"*}"
if [[ -z "$expires_at" ]]; then
  exit 1
fi

# GNU date, for `-d` parsing of the ISO 8601 value.
if ! expires_epoch=$(date -d "$expires_at" "+%s" 2> /dev/null); then
  exit 1
fi
now=$(date "+%s")

if ((expires_epoch <= now)); then
  exit 1
fi

# Session is valid
exit 0
