#!/usr/bin/env bash

set -euo pipefail

tmp_stdout=
tmp_stderr=

cleanup() {
  if [[ -n "$tmp_stdout" && -e "$tmp_stdout" ]]; then
    rm "$tmp_stdout"
  fi
  if [[ -n "$tmp_stderr" && -e "$tmp_stderr" ]]; then
    rm "$tmp_stderr"
  fi
}
trap cleanup EXIT

approval_path() {
  local repo_root="${1:-.}" git_dir
  git_dir="$(git -C "$repo_root" rev-parse --absolute-git-dir 2> /dev/null)" || return 1
  printf '%s/crit-approval-head\n' "$git_dir"
}

record_approval() {
  local head path
  head="$(git rev-parse --verify HEAD)" || return 1
  path="$(approval_path)" || return 1
  printf '%s\n' "$head" > "$path"
}

check_approval() {
  local repo_root branch default_branch default_ref default_candidates current_head approved_head path

  if [[ -z "${CLAUDECODE:-}" && -z "${CODEX_THREAD_ID:-}" ]]; then
    return 0
  fi

  repo_root="$(git rev-parse --show-toplevel 2> /dev/null)" || return 0
  branch="$(git -C "$repo_root" branch --show-current)"
  [[ -n "$branch" ]] || return 0

  default_ref="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2> /dev/null || true)"
  default_branch="${default_ref#origin/}"
  if [[ -z "$default_branch" ]]; then
    default_candidates="$(git -C "$repo_root" branch -l master main | sed 's/^[*+ ]*//')"
    case "$default_candidates" in
      master | main) default_branch="$default_candidates" ;;
      *)
        printf 'Skipping crit approval check: set origin/HEAD to identify the default branch.\n' >&2
        return 0
        ;;
    esac
  fi
  [[ -n "$default_branch" && "$branch" == "$default_branch" ]] || return 0

  current_head="$(git -C "$repo_root" rev-parse --verify HEAD)"
  path="$(approval_path "$repo_root")"
  approved_head="$(cat "$path" 2> /dev/null || true)"
  if [[ "$approved_head" != "$current_head" ]]; then
    printf 'Blocked: agent commits on the default branch require crit approval for the current HEAD.\n' >&2
    printf 'Run the crit-approval-review skill, then retry the commit.\n' >&2
    return 1
  fi
}

if [[ "${DOTFILES_CRIT_APPROVAL_CHECK:-}" == "1" ]]; then
  if [[ $# -gt 0 ]]; then
    printf 'Unexpected arguments for crit-approval-check.\n' >&2
    exit 2
  fi
  check_approval
  exit
fi

tmp_stdout="$(mktemp /tmp/crit-approval-stdout.XXXXXX)"
tmp_stderr="$(mktemp /tmp/crit-approval-stderr.XXXXXX)"
# A PR or range approval does not approve the current commit on the default branch.
record_approval_allowed=true
for arg in "$@"; do
  case "$arg" in
    --pr | --pr=* | --range | --range=*)
      record_approval_allowed=false
      ;;
  esac
done

# Reads the client's stderr to EOF: tee dies on SIGPIPE if this exits early.
notify_client_started() {
  local line re='^(Connected to|Started) crit daemon at ([^[:space:]]+)' notified=false
  while IFS= read -r line; do
    if [[ "$notified" == false && "$line" =~ $re ]]; then
      notified=true
      # --pid is this script, which outlives the crit client. Best-effort: an old `a` without this subcommand must not break crit.
      a agent crit client-started --url "${BASH_REMATCH[2]}" --pid "$$" > /dev/null 2>&1 &
    fi
  done
}

set +e
# stdout is a pipeline stage, not a process substitution: a process substitution inherits the pipe of every earlier one, so a slow `a` started by the notifier would keep the stdout tee open and block callers that capture stdout.
{
  crit "$@" 2> >(tee >(notify_client_started) "$tmp_stderr" >&2)
  crit_status=$?
  # A bare `wait` covers only the last process substitution; the approval check below needs this tee to have finished.
  wait
  exit "$crit_status"
} | tee "$tmp_stdout"
crit_status="${PIPESTATUS[0]}"
set -e

if [[ "$record_approval_allowed" == true ]] &&
  grep -Eq '^[[:space:]]*(\{[[:space:]]*)?"?approved"?[[:space:]]*:[[:space:]]*"?true"?([[:space:]]*\})?[[:space:]]*$' "$tmp_stdout" "$tmp_stderr"; then
  record_approval
fi

cleanup
trap - EXIT
exit "$crit_status"
