#!/usr/bin/env bash
set -euo pipefail

# Resolve dotfiles directory from this script's location, following symlinks.
# This works even before `dot` is on PATH (initial deployment via `config/bin/dot deploy`).
_dot_src="${BASH_SOURCE[0]}"
while [ -L "$_dot_src" ]; do
  _dot_dir="$(cd -P "$(dirname "$_dot_src")" && pwd)"
  _dot_src="$(readlink "$_dot_src")"
  [[ $_dot_src != /* ]] && _dot_src="$_dot_dir/$_dot_src"
done
_dot_bin_dir="$(cd -P "$(dirname "$_dot_src")" && pwd)"
# dot lives at <DOTFILES_DIR>/config/bin/dot
DOTFILES_DIR="$(cd -P "$_dot_bin_dir/../.." && pwd)"
unset _dot_src _dot_dir

# shellcheck source=config/bin/lib/deploy.bash disable=SC1091
source "$_dot_bin_dir/lib/deploy.bash"

usage() {
  cat << EOS
Usage: dot <command> [options...]

Commands:
    deploy    Deploy dotfiles symlinks
    refresh   Refresh dotfiles and tools (pull, deploy, install, etc.)
    role      Manage the machine role (private/work) used to resolve overlays
    path      Print the dotfiles directory path
    help      Show this help message

Deploy options:
    --dry-run, -n    Show the commands to create symlinks
    --force, -f      Re-deploy symlinks even if they already exist
    --tags, -t       Deploy only the specified comma-separated tags (e.g. nvim,git)
    --debug, -d      Enable debug output (set -x)
EOS
}

# Set git_dir / common_dir (physical absolute paths) for directory $1. Fails
# outside a repo or without git. Paths are resolved by hand because
# `rev-parse --path-format=absolute` needs git >= 2.31 and older git echoes the
# unknown flag back as if it were a path.
read_git_dirs() {
  { read -r git_dir && read -r common_dir; } < <(cd "$1" && git rev-parse --git-dir --git-common-dir 2> /dev/null) || return 1
  git_dir="$(cd "$1" && cd -P "$git_dir" && pwd)" || return 1
  common_dir="$(cd "$1" && cd -P "$common_dir" && pwd)" || return 1
}

# Abort when deploying from a linked git worktree. Symlinks pointing into one
# dangle once the worktree is removed, and a PATH `dot` from inside one deploys
# the main checkout, not the worktree's files. Skipped when git is unavailable
# or DOTFILES_DIR is not a repo, so the initial deploy keeps working.
refuse_linked_worktree() {
  local action="$1" git_dir common_dir dot_git dot_common reason

  read_git_dirs "$DOTFILES_DIR" || return 0
  dot_git="$git_dir" dot_common="$common_dir"

  if [ "$dot_git" != "$dot_common" ]; then
    reason="$DOTFILES_DIR is a linked git worktree; symlinks under \$HOME would dangle once it is removed."
  elif read_git_dirs "$PWD" && [ "$git_dir" != "$common_dir" ] && [ "$common_dir" = "$dot_common" ]; then
    reason="$PWD is a linked git worktree; 'dot $action' would deploy the main repository, not this worktree."
  else
    return 0
  fi

  {
    echo "Error: $reason"
    echo "Run it from the main repository instead:"
    printf '    cd %q && ./config/bin/dot %s\n' "${dot_common%/.git}" "$action"
  } >&2
  exit 1
}

cmd_deploy() {
  refuse_linked_worktree deploy

  # These variables are consumed by helpers in lib/deploy.bash and `symlinks`.
  local tags="" DRYRUN="" FORCE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --debug | -d)
        set -x
        shift
        ;;
      --dry-run | -n)
        DRYRUN=1
        shift
        ;;
      --force | -f)
        FORCE=1
        shift
        ;;
      --tags | -t)
        tags="$(tr ',' '\n' <<< "$2")"
        shift 2
        ;;
      -*)
        echo "Error: invalid option '$1'" >&2
        usage
        exit 1
        ;;
    esac
  done
  # shellcheck disable=SC2034  # consumed by lib/deploy.bash and `symlinks`
  : "$tags" "$DRYRUN" "$FORCE"

  cd "$DOTFILES_DIR"
  # Bootstrap runs in a child process, so a fresh shell may not have mise on PATH.
  export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$HOME/.local/bin:$PATH"

  # Require .role to be set so overlay-aware tools (zsh, jsonnet builds, etc.) know
  # which machine role to apply.
  if ! "$_dot_bin_dir/dot-role" get > /dev/null 2>&1; then
    echo "Error: machine role is not set." >&2
    echo "Run one of the following before deploying:" >&2
    echo "    dot role set private" >&2
    echo "    dot role set work repo=<owner>/<name>" >&2
    exit 1
  fi

  # Run build steps for matching tags that have a Makefile.
  # With --force, run `make clean` first so the build starts from a clean state
  # (e.g. bypassing drift checks that compare against previously-installed artifacts).
  for dir in config/*/; do
    tag="$(basename "$dir")"
    # These build steps target macOS services or input methods.
    if ! is_macos && [[ $tag == aquaskk || $tag == launchd || $tag == macos ]]; then
      continue
    fi
    if match_tag "$tag" && [ -f "$dir/Makefile" ]; then
      if is_force && make -C "$dir" -n clean > /dev/null 2>&1; then
        log-exec make -C "$dir" clean
      fi
      log-exec make -C "$dir"
    fi
  done

  # shellcheck disable=SC1091
  source symlinks
}

cmd_refresh() {
  refuse_linked_worktree refresh

  cd "$DOTFILES_DIR"
  mise run refresh "$@"
}

cmd_role() {
  exec "$_dot_bin_dir/dot-role" "$@"
}

cmd_path() {
  echo "$DOTFILES_DIR"
}

# --- main ---

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

command="$1"
shift

case "$command" in
  deploy) cmd_deploy "$@" ;;
  refresh) cmd_refresh "$@" ;;
  role) cmd_role "$@" ;;
  path) cmd_path "$@" ;;
  help | --help | -h) usage ;;
  *)
    echo "Error: unknown command '$command'" >&2
    usage
    exit 1
    ;;
esac
