#!/bin/bash
# Dynamic template generator for Claude Code.
# Reads a config.yaml with variables and a gomplate template,
# evaluates variable commands, and renders the final Markdown to stdout.
#
# Usage:
#   gen-claude-template context <name> - render a single context template
#   gen-claude-template context        - render all context templates
#
# Directory layout (~/.claude/contexts/):
#   <name>/config.yaml - context templates
#
# config.yaml format:
#   variables:
#     <name>: <shell command whose stdout becomes the variable value>
#   template: <template file path relative to config.yaml>
#
# Variable values are passed to gomplate as a YAML datasource "vars".
# In templates, access them via: {{ (ds "vars").<name> }}
# If a command outputs JSON, it is accessible as nested objects.

set -euo pipefail

contexts_dir="${HOME}/.claude/contexts"
work_dir=$(mktemp -d)
trap 'rm -r "$work_dir" || true' EXIT

commands=()
context_dirs=()
context_config_files=()
context_templates=()
command_pids=()
render_pids=()

add_context() {
  local context_dir="$1"
  local config="${context_dir}/config.yaml"

  if [[ ! -f "$config" ]]; then
    echo "Error: config not found: $config" >&2
    return 1
  fi

  context_dirs+=("$context_dir")
  context_config_files+=("$config")
}

collect_variables() {
  local configs_json_file="${work_dir}/configs.json"
  local entries_file="${work_dir}/entries"
  local context_index template variable_count key cmd saved_cmd command_index found
  local variable_index

  if [[ "${#context_config_files[@]}" -eq 0 ]]; then
    return 0
  fi

  yq -o=json '.' "${context_config_files[@]}" > "$configs_json_file"
  jq -s -j 'to_entries[] | (.key | tostring), "\u0000", .value.template, "\u0000", ((.value.variables // {}) | length | tostring), "\u0000", (.value.variables // {} | to_entries[] | .key, "\u0000", .value, "\u0000")' "$configs_json_file" > "$entries_file"

  for context_index in "${!context_dirs[@]}"; do
    : > "${work_dir}/context-${context_index}.map"
  done

  exec 3< "$entries_file"
  while IFS= read -r -d '' context_index && IFS= read -r -d '' template && IFS= read -r -d '' variable_count; do
    context_templates[context_index]="$template"
    for ((variable_index = 0; variable_index < variable_count; variable_index++)); do
      IFS= read -r -d '' key <&3
      IFS= read -r -d '' cmd <&3
      command_index=0
      found=false
      if [[ "${#commands[@]}" -gt 0 ]]; then
        for saved_cmd in "${commands[@]}"; do
          if [[ "$saved_cmd" == "$cmd" ]]; then
            found=true
            break
          fi
          command_index=$((command_index + 1))
        done
      fi
      if [[ "$found" == false ]]; then
        commands+=("$cmd")
        command_index=$((${#commands[@]} - 1))
      fi
      printf '%s\t%s\n' "$key" "$command_index" >> "${work_dir}/context-${context_index}.map"
    done
  done <&3
  exec 3<&-
}

render_context() {
  local context_index="$1"
  local context_dir="${context_dirs[$context_index]}"
  local template="${context_templates[context_index]}"
  local map_file="${work_dir}/context-${context_index}.map"
  local vars_json_file="${work_dir}/context-${context_index}.vars.json"
  local key command_index value_file
  local variable_index=0
  local jq_filter='{}'
  local jq_args=()

  while IFS=$'\t' read -r key command_index; do
    value_file="${work_dir}/value-${command_index}"
    jq_args+=(--arg "k${variable_index}" "$key")
    jq_args+=(--rawfile "v${variable_index}" "$value_file")
    jq_filter="${jq_filter} | .[\$k${variable_index}] = (if (\$v${variable_index} | (startswith(\"{\") or startswith(\"[\"))) then try (\$v${variable_index} | fromjson) catch \$v${variable_index} else \$v${variable_index} end)"
    variable_index=$((variable_index + 1))
  done < "$map_file"

  if [[ "${#jq_args[@]}" -gt 0 ]]; then
    jq -n "${jq_args[@]}" "$jq_filter" > "$vars_json_file"
  else
    jq -n "$jq_filter" > "$vars_json_file"
  fi
  gomplate -d "vars=stdin:///vars.json" -f "${context_dir}/${template}" < "$vars_json_file"
}

render_selected_contexts() {
  local wait_status=0
  local index
  local pid

  if [[ "${#context_dirs[@]}" -eq 0 ]]; then
    return 0
  fi
  for index in "${!context_dirs[@]}"; do
    (render_context "$index") > "${work_dir}/render-${index}" &
    render_pids+=("$!")
  done

  for pid in "${render_pids[@]}"; do
    if wait "$pid"; then
      :
    else
      wait_status=1
    fi
  done
  if [[ "$wait_status" -ne 0 ]]; then
    return 1
  fi

  for index in "${!context_dirs[@]}"; do
    if [[ "$index" -ne 0 ]]; then
      printf '\n'
    fi
    cat "${work_dir}/render-${index}"
  done
}

type="${1:?Usage: gen-claude-template context [<name>]}"

case "$type" in
  context)
    if [[ -n "${2:-}" ]]; then
      add_context "${contexts_dir}/${2}"
    else
      for dir in "${contexts_dir}"/*/; do
        [[ -d "$dir" ]] || continue
        add_context "$dir"
      done
    fi

    collect_variables
    for ((index = 0; index < ${#commands[@]}; index++)); do
      (
        eval "${commands[$index]}" < /dev/null > "${work_dir}/value-${index}.raw" 2> /dev/null || true
      ) &
      command_pids+=("$!")
    done
    if [[ "${#command_pids[@]}" -gt 0 ]]; then
      for pid in "${command_pids[@]}"; do
        wait "$pid" || true
      done
    fi
    for ((index = 0; index < ${#commands[@]}; index++)); do
      value=$(< "${work_dir}/value-${index}.raw")
      printf '%s' "$value" > "${work_dir}/value-${index}"
    done

    render_selected_contexts
    ;;
  *)
    echo "Error: unknown type '${type}'. Use 'context'." >&2
    exit 1
    ;;
esac
