#!/bin/bash
#
# langfuse-mcp-headers - emit the Basic auth header for the Langfuse MCP server.
#
# Invoked as `op-run-cached langfuse-mcp-headers` via `headersHelper`, with
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY set to op:// refs by the caller.
# Claude Code re-runs headersHelper on every connection with no caching and a
# 10s timeout, which a cold 1Password read can exceed on its own;
# op-run-cached keeps it to a Keychain lookup instead.

set -euo pipefail

# base64 wraps long input on some platforms; a folded header value is invalid.
auth=$(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64 | tr -d '\n')

jq -n --arg auth "Basic $auth" '{Authorization: $auth}'
