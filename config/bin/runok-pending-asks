#!/bin/bash
#
# Pass `runok audit --json` output through, dropping entries that are no longer
# `ask`/`pass` under the current ruleset or that match an IGNORE_COMMANDS regex.
# `pass` (no runok rule matched, deferred to Claude Code) is as triage-worthy
# as `ask`, since it is the unmatched-rule fallback.
# Designed to be consumed by the `runok-review-asks` Claude skill.
#
# Output: the original `runok audit --json` JSONL, unmodified, with non-matching
# entries omitted. The script does not reshape, dedupe, or aggregate — that is
# the LLM's job.

set -euo pipefail

# Extended regular expressions matched against the top-level `.command` field.
# Matching entries are never proposed for allow-listing.
IGNORE_COMMANDS=(
  '^a cc new'
  # Claude Code drives Renovate PR approve -> merge, but a blanket allow
  # is too broad (any PR, not just vetted Renovate ones), so keep ask.
  '^gh (-R [^ ]+ |--repo [^ ]+ )?pr review .* --approve'
  '^gh (-R [^ ]+ |--repo [^ ]+ )?pr merge'
  # Direct pushes to a master-push-repos entry (no PR safety net) should
  # always be confirmed, including from a `.worktrees/` checkout.
  '^git( -C [^ ]+)? push$'
  '^git( -C [^ ]+)? push origin (main|master)$'
  '^git( -C [^ ]+)? push -u origin HEAD$'
)

ignore_regex=$(printf '|%s' "${IGNORE_COMMANDS[@]}")
ignore_regex=${ignore_regex:1}

# `runok audit --action` only accepts a single allow/deny/ask value (it
# doesn't know about `pass`), so it can't filter for ask+pass together.
# Fetch everything and filter in jq below, unless the caller passed their
# own --action.
has_action=0
for a in "$@"; do
  case "$a" in
    --action | --action=*) has_action=1 ;;
  esac
done

if [[ $has_action -eq 0 ]]; then
  action_filter='(.action.type == "ask" or .action.type == "pass")'
else
  action_filter='true'
fi

runok audit --json "$@" |
  jq -c --arg ignore "$ignore_regex" "select(($action_filter) and ((.command | test(\$ignore)) | not))" |
  while IFS= read -r line; do
    cmd=$(jq -r '.command' <<< "$line")
    # `runok check` evaluates each stdin line as a separate command, so a
    # heredoc-bearing compound yields multiple JSON docs. Treat the entry as
    # still-pending if ANY sub-decision is ask/pass (otherwise long heredoc
    # compounds whose middle subcommands hit ask/pass get silently dropped).
    # On any parse error, fall back to pending so the entry surfaces for review.
    decision=$(printf '%s\n' "$cmd" | runok check --output-format json 2> /dev/null | jq -sr '[.[].decision] | if any(. == "ask" or . == "pass") then "pending" else "other" end' 2> /dev/null || echo pending)
    if [[ "$decision" == "pending" ]]; then
      printf '%s\n' "$line"
    fi
  done
