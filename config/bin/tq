#!/bin/bash
#
# Named `tq` deliberately, shadowing the `tq` binary pnpm's global install
# puts under $PNPM_HOME: config/bin (~/bin) sits earlier on PATH. The real
# binary is resolved directly under $PNPM_HOME instead of via PATH, to avoid
# recursing into this wrapper.
#
# The CLI knows nothing about Cloudflare Access: tq sits behind it for
# deployment reasons, not as part of its API contract, so it only exposes a
# generic `-H` header flag. Mapping the 1Password service token onto the
# Access header names is this wrapper's job.
# op item: "tq MCP (Cloudflare Access Service Token)"

set -euo pipefail

# config/zsh/env/pnpm.zsh sets this for interactive shells, but this wrapper
# may also run from non-Zsh contexts (cron, GUI launchers) that never source it.
if [[ -z "${PNPM_HOME:-}" ]]; then
  if [[ $OSTYPE == darwin* ]]; then
    PNPM_HOME="$HOME/Library/pnpm"
  else
    PNPM_HOME="$HOME/.local/share/pnpm"
  fi
fi

if [[ -x "$PNPM_HOME/bin/tq" ]]; then
  real_tq="$PNPM_HOME/bin/tq"
elif [[ -x "$PNPM_HOME/tq" ]]; then
  real_tq="$PNPM_HOME/tq"
else
  echo "tq: CLI not found under \$PNPM_HOME ($PNPM_HOME)." >&2
  echo "Run 'pnpm run install-cli' in the tq repo, or 'dot refresh'." >&2
  exit 1
fi

headers_json=$(
  CF_ACCESS_CLIENT_ID='op://Personal/pamhi2ise6e5xuqeeilflxf27a/username' \
    CF_ACCESS_CLIENT_SECRET='op://Personal/pamhi2ise6e5xuqeeilflxf27a/credential' \
    op-run-cached mcp-headers-from-env \
    'CF-Access-Client-Id=CF_ACCESS_CLIENT_ID' \
    'CF-Access-Client-Secret=CF_ACCESS_CLIENT_SECRET'
)

header_args=()
while IFS=$'\t' read -r name value; do
  header_args+=(-H "$name: $value")
done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' <<< "$headers_json")

# Pinned rather than defaulted: the header args above carry the service token,
# so honouring a caller-supplied TQ_API_URL would send it to an arbitrary host.
# `TQ_API_URL=... tq ...` is indistinguishable from a plain `tq ...` to runok,
# which strips leading variable assignments before matching, so this is the
# only place the redirect can be refused. Point the CLI under $PNPM_HOME
# directly to talk to a non-production API; it needs no token.
export TQ_API_URL='https://tq.fohte.net'

exec "$real_tq" "${header_args[@]}" "$@"
