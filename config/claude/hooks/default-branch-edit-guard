#!/bin/bash
# Keep checkout isolation independent because repo.direct_commit must not
# authorize edits in another checkout.
#
# Invoked from pre-tool-use-proxy.bash; receives the original PreToolUse
# JSON payload on stdin.
input=$(cat)

tool_name=$(echo "$input" | jq -r '.tool_name // empty')
boundary_status=0
bash "$(dirname -- "$0")/edit-checkout-boundary.bash" <<< "$input"
boundary_status=$?

deny_target() {
  jq -nc --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
}

case "$boundary_status" in
  0)
    dir=$(echo "$input" | jq -r '.cwd // empty')
    ;;
  10)
    # No target belongs to this checkout, so its default branch does not apply.
    exit 0
    ;;
  20)
    deny_target "An edit target belongs to another Git checkout or could not be classified. The entire edit was blocked."
    exit 0
    ;;
  30)
    if [ "$tool_name" = "apply_patch" ]; then
      dir=$(echo "$input" | jq -r '.cwd // empty')
    else
      file_path=$(echo "$input" | jq -r '.tool_input.file_path // .tool_input.edits[0].file_path // empty')
      [ -z "$file_path" ] && exit 0
      dir=$(dirname -- "$file_path")
    fi
    ;;
  *)
    deny_target "Could not determine the checkout for every edit target. The entire edit was blocked."
    exit 0
    ;;
esac
[ -z "$dir" ] && exit 0

repo_root=$(git -C "$dir" rev-parse --show-toplevel 2> /dev/null) || exit 0

branch=$(git -C "$repo_root" branch --show-current)
# Detached HEAD: no branch to protect.
[ -z "$branch" ] && exit 0

default=$(git -C "$repo_root" symbolic-ref --short refs/remotes/origin/HEAD 2> /dev/null | sed 's|^origin/||')
# No remote / origin/HEAD not set: cannot determine default branch, fall through.
[ -z "$default" ] && exit 0
[ "$branch" != "$default" ] && exit 0

command -v a > /dev/null 2>&1 || exit 0

allowed=$(cd "$repo_root" && a config get repo.direct_commit)
[ "$allowed" = "true" ] && exit 0

jq -n --arg b "$branch" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: ("Direct edit on the default branch \"" + $b + "\" is blocked. Switch to a feature branch before editing.")
  }
}'
