#!/usr/bin/env bash
# Link role overlay skills into each engine's flat skill root.
set -euo pipefail

dotfiles_dir="$(dot path)"
public_skill_dir="$dotfiles_dir/config/claude/skills"
overlay_dir="$(dot role overlay config/claude/skills || true)"
state_dir="$HOME/.local/state/dotfiles/role-skill-links"
umask 077
mkdir -p "$state_dir"

# Both engines can start together and reconcile the same roots and state files.
# The owner PID lets a later hook reclaim a lock left by a crashed process.
lock_dir="$state_dir/sync.lock"
recovery_lock_dir="$state_dir/sync-recovery.lock"
recovery_pid=""

# shortcut: PID reuse can make a stale lock look active; remove it manually if sync keeps skipping after that process exits.
pid_is_running() {
  [[ "$1" =~ ^[0-9]+$ ]] && kill -0 "$1" 2> /dev/null
}

if [ -d "$lock_dir" ] || ! mkdir "$lock_dir"; then
  lock_pid=""
  for attempt in 1 2 3 4 5; do
    if [ -r "$lock_dir/pid" ]; then
      IFS= read -r lock_pid < "$lock_dir/pid" || lock_pid=""
      break
    fi
    if [ "$attempt" -lt 5 ]; then
      sleep 0.1
    fi
  done

  if pid_is_running "$lock_pid"; then
    echo "warning: another role skill sync is running; skipping this invocation" >&2
    exit 0
  fi

  if [ -d "$recovery_lock_dir" ] || ! mkdir "$recovery_lock_dir"; then
    for attempt in 1 2 3 4 5; do
      if [ -r "$recovery_lock_dir/pid" ]; then
        IFS= read -r recovery_pid < "$recovery_lock_dir/pid" || recovery_pid=""
        break
      fi
      if [ "$attempt" -lt 5 ]; then
        sleep 0.1
      fi
    done

    if pid_is_running "$recovery_pid"; then
      echo "warning: another role skill sync is recovering its lock; skipping this invocation" >&2
      exit 0
    fi

    current_recovery_pid=""
    if [ -r "$recovery_lock_dir/pid" ]; then
      IFS= read -r current_recovery_pid < "$recovery_lock_dir/pid" || current_recovery_pid=""
    fi
    if [ "$current_recovery_pid" != "$recovery_pid" ] || pid_is_running "$current_recovery_pid"; then
      echo "warning: role skill sync recovery lock changed while checking it; skipping this invocation" >&2
      exit 0
    fi
    echo "warning: removing stale role skill sync recovery lock at $recovery_lock_dir" >&2
    if [ -f "$recovery_lock_dir/pid" ]; then
      rm "$recovery_lock_dir/pid"
    fi
    if ! rmdir "$recovery_lock_dir"; then
      echo "error: unable to remove stale role skill sync recovery lock at $recovery_lock_dir" >&2
      exit 1
    fi
    if ! mkdir "$recovery_lock_dir"; then
      echo "warning: another role skill sync started recovery; skipping this invocation" >&2
      exit 0
    fi
  fi
  printf '%s\n' "$$" > "$recovery_lock_dir/pid"
  cleanup_recovery_lock() {
    local owner_pid=""
    if [ -r "$recovery_lock_dir/pid" ]; then
      IFS= read -r owner_pid < "$recovery_lock_dir/pid" || owner_pid=""
    fi
    if [ "$owner_pid" = "$$" ]; then
      rm "$recovery_lock_dir/pid"
      rmdir "$recovery_lock_dir"
    fi
  }
  trap cleanup_recovery_lock EXIT

  current_lock_pid=""
  if [ -r "$lock_dir/pid" ]; then
    IFS= read -r current_lock_pid < "$lock_dir/pid" || current_lock_pid=""
  fi
  if [ "$current_lock_pid" != "$lock_pid" ] || {
    pid_is_running "$current_lock_pid"
  }; then
    echo "warning: role skill sync lock changed while checking it; skipping this invocation" >&2
    exit 0
  fi
  echo "warning: removing stale role skill sync lock at $lock_dir" >&2
  if [ -f "$lock_dir/pid" ]; then
    rm "$lock_dir/pid"
  fi
  if ! rmdir "$lock_dir"; then
    echo "error: unable to remove stale role skill sync lock at $lock_dir" >&2
    exit 1
  fi
  cleanup_recovery_lock
  trap - EXIT
  if ! mkdir "$lock_dir"; then
    echo "warning: another role skill sync started; skipping this invocation" >&2
    exit 0
  fi
fi
printf '%s\n' "$$" > "$lock_dir/pid"
cleanup_lock() {
  rm "$lock_dir/pid"
  rmdir "$lock_dir"
}
trap cleanup_lock EXIT
trap 'exit 1' HUP INT TERM

link_public_skills() {
  local root="$1" include_synced="$2" skill name destination

  for skill in "$public_skill_dir"/*/; do
    [ -d "$skill" ] || continue
    name="$(basename "${skill%/}")"
    if [ "$include_synced" != true ] && [ "$name" = synced ]; then
      continue
    fi
    if [ "$include_synced" != true ] && [ -L "${skill%/}" ]; then
      continue
    fi
    destination="$root/$name"
    if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
      ln -s "${skill%/}" "$destination" || return 1
    fi
  done
}

remove_legacy_overlay_links() {
  local link name target

  for link in "$public_skill_dir"/*; do
    [ -L "$link" ] || continue
    name="$(basename "$link")"
    target="$(readlink "$link")"
    case "$target" in
      */config-overlays/claude/skills/"$name" | */config-overlays/claude/skills/"$name"/) rm "$link" || return 1 ;;
    esac
  done
}

prepare_skill_root() {
  local root="$1" include_synced="$2" root_target

  if [ -L "$root" ]; then
    root_target="$(readlink "$root")"
    if [ "$root" = "$HOME/.claude/skills" ] && [ "$root_target" = "$public_skill_dir" ]; then
      remove_legacy_overlay_links || return 1
      rm "$root" || return 1
    else
      echo "warning: keeping custom skill root symlink at $root" >&2
      return 1
    fi
  fi

  mkdir -p "$root" || return 1
  link_public_skills "$root" "$include_synced" || return 1
}

lookup_target() {
  local file="$1" wanted_name="$2" name target
  [ -f "$file" ] || return 1
  while IFS=$'\t' read -r name target; do
    if [ "$name" = "$wanted_name" ]; then
      printf '%s\n' "$target"
      return 0
    fi
  done < "$file"
  return 1
}

sync_skill_root() {
  local root="$1" state_file="$2" desired_file old_state next_state
  local skill name target path current_target desired_target recorded_target

  desired_file="$(mktemp "$state_dir/.desired.XXXXXX")"
  old_state="$(mktemp "$state_dir/.old.XXXXXX")"
  next_state="$(mktemp "$state_dir/.next.XXXXXX")"
  trap 'rm -f "$desired_file" "$old_state" "$next_state"' RETURN

  if [ -d "$overlay_dir" ]; then
    for skill in "$overlay_dir"/*/; do
      [ -f "$skill/SKILL.md" ] || continue
      name="$(basename "${skill%/}")"
      [ -f "$public_skill_dir/$name/SKILL.md" ] && continue
      printf '%s\t%s\n' "$name" "${skill%/}" >> "$desired_file"
    done
  fi

  if [ -f "$state_file" ]; then
    cp "$state_file" "$old_state"
  else
    # Adopt links from the old hook once, which used this exact target layout.
    for path in "$root"/*; do
      [ -L "$path" ] || continue
      name="$(basename "$path")"
      current_target="$(readlink "$path")"
      case "$current_target" in
        */config-overlays/claude/skills/"$name" | */config-overlays/claude/skills/"$name"/)
          printf '%s\t%s\n' "$name" "$current_target" >> "$old_state"
          ;;
      esac
    done
  fi

  while IFS=$'\t' read -r name target; do
    path="$root/$name"
    current_target=""
    if [ -L "$path" ]; then
      current_target="$(readlink "$path")"
    fi
    desired_target="$(lookup_target "$desired_file" "$name" || true)"

    if [ "$current_target" = "$target" ]; then
      if [ "$desired_target" = "$target" ]; then
        printf '%s\t%s\n' "$name" "$target" >> "$next_state"
      else
        rm "$path"
      fi
    fi
  done < "$old_state"

  while IFS=$'\t' read -r name target; do
    path="$root/$name"
    if [ -L "$path" ]; then
      current_target="$(readlink "$path")"
      if [ "$current_target" = "$target" ]; then
        recorded_target="$(lookup_target "$next_state" "$name" || true)"
        if [ "$recorded_target" != "$target" ]; then
          echo "warning: keeping unrecorded skill symlink at $path" >&2
        fi
      fi
    elif [ -e "$path" ]; then
      echo "warning: keeping existing skill at $path" >&2
    else
      ln -s "$target" "$path"
      printf '%s\t%s\n' "$name" "$target" >> "$next_state"
    fi
  done < "$desired_file"

  mv "$next_state" "$state_file"
}

claude_root="$HOME/.claude/skills"
codex_root="$HOME/.agents/skills"
if prepare_skill_root "$claude_root" true; then
  sync_skill_root "$claude_root" "$state_dir/claude.tsv"
  link_public_skills "$claude_root" true
fi
if prepare_skill_root "$codex_root" false; then
  sync_skill_root "$codex_root" "$state_dir/codex.tsv"
  link_public_skills "$codex_root" false
fi
