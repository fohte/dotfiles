#!/bin/bash

input=$(cat)
target_name=$(jq -r '.tool_input.name // empty' <<< "$input")

ask() {
  jq -nc --arg reason "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $reason}}'
  exit 0
}

deny() {
  jq -nc --arg reason "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
  exit 0
}

case "$target_name" in
  analyze_issue_with_seer)
    deny "Seer analysis is not approved."
    ;;
  find* | get* | search* | update*)
    jq -nc '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow"}}'
    ;;
  *)
    ask "Only Sentry read and update tools are pre-approved through the generic executor."
    ;;
esac
