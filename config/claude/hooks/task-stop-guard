#!/bin/bash
# Guard for the TaskStop tool ("Stop Task"): deny it while a human-in-the-loop
# review is open. TaskStop is "Permission Required: No", so permissions.deny
# does not apply to it and a PreToolUse hook is the only layer that can block
# it. Stopping mid-review strands the reviewer: the detached editor survives,
# but the process waiting for its result is gone.
#
# tool_input carries an opaque task_id only, so the stopped command cannot be
# identified; a live review-complete process stands in for "an editor is open
# and a human is being waited on". The check is machine-wide, so a review open
# in another session blocks TaskStop here too.
#
# `pgrep -f` matches anywhere in argv, hence the anchor to the command name:
# any agent quoting this file carries the bare words in its own arguments.
pgrep -f '^[^ ]*a (ai|gh) .*(review-complete|draft --complete)' > /dev/null || exit 0

jq -nc '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: "A human-in-the-loop review is open and waiting on the user. Stopping now kills the side waiting for the review result while the editor stays up, so the review is completed by the user and then silently discarded. Wait for it to finish."}}'
