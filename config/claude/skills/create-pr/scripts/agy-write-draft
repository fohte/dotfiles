#!/bin/bash
# Draft the PR body via agy in one shot (writing + self-review are the same
# call — see Step 1 of references/draft-agy.md for why).
# Usage: agy-write-draft
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
schema_file="$script_dir/agy-schema.json"
# shellcheck source=config/claude/skills/create-pr/scripts/call-agy.sh disable=SC1091
source "$script_dir/call-agy.sh"

base="origin/$(git main)"

diff=$(git diff --no-ext-diff "$base...HEAD")
[ -n "$diff" ] || {
  echo "Error: diff against $base is empty." >&2
  exit 1
}
commits=$(git log "$base..HEAD")

rules=$(writing_rules)

prompt=$(
  cat << PROMPT
GitHub の Pull Request の title と body を日本語で書く。以下のルールに厳密に従うこと。narration や説明は不要で、指定した JSON 形式でだけ出力する。

$rules

<diff>
$diff
</diff>

<commits>
$commits
</commits>
PROMPT
)

result=$(call_agy "$prompt" "$schema_file")
agy_result_or_die "$result"

title=$(jq -r '.structured_output.pr_title' <<< "$result")
body=$(jq -r '.structured_output.pr_body' <<< "$result")
printf '%s\n' "$body" | a ai pr-draft new --title "$title"

draft_path=$("$script_dir/draft-path")
save_agy_output "$draft_path" "$title" "$body"
