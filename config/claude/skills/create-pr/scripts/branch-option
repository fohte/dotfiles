# shellcheck shell=bash
set_branch_option() {
  local variable_name="$1" remaining_args="$2" candidate="${3:-}"

  if ((remaining_args < 2)) || [[ -z "$candidate" ]]; then
    echo "Error: --branch requires a branch name" >&2
    exit 2
  fi
  if [[ -n "${!variable_name}" ]]; then
    echo "Error: --branch may be specified only once" >&2
    exit 2
  fi
  if ! git check-ref-format --branch "$candidate" > /dev/null; then
    echo "Error: invalid branch name: $candidate" >&2
    exit 2
  fi

  printf -v "$variable_name" '%s' "$candidate"
}
