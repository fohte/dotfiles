#!/bin/bash
# Print the deterministic path of a PR draft file, matching the layout
# `a ai pr-draft new` creates it at.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=config/claude/skills/create-pr/scripts/branch-option disable=SC1091
source "$script_dir/branch-option"

usage() {
  cat << 'EOF'
Usage: draft-path [--branch <branch>]

Print the draft path for the current branch or an explicitly selected branch.
EOF
}

branch_arg=
while (($#)); do
  case "$1" in
    --branch)
      set_branch_option branch_arg "$#" "${2:-}"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -n "$branch_arg" ]]; then
  branch=$branch_arg
else
  branch=$(git branch --show-current)
fi
owner=$(gh repo view --json owner --jq .owner.login)
repo=$(gh repo view --json name --jq .name)
tmpdir="${TMPDIR:-/tmp}"
tmpdir="${tmpdir%/}"

echo "${tmpdir}/pr-body-draft/${owner}/${repo}/${branch}.md"
