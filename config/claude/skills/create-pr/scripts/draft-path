#!/bin/bash
# Print the deterministic path of the current branch's PR draft file, matching
# the layout `a ai pr-draft new` creates it at. Lets the agy-* scripts locate
# the file without asking Claude for it.
set -euo pipefail

owner=$(gh repo view --json owner --jq .owner.login)
repo=$(gh repo view --json name --jq .name)
branch=$(git branch --show-current)

echo "/tmp/pr-body-draft/${owner}/${repo}/${branch}.md"
