#!/bin/bash
# Print the repo's PR template content, or nothing if it has none.
# Used by render-rules, so the candidate path list only lives in one place.
set -euo pipefail

root=$(git rev-parse --show-toplevel 2> /dev/null) || exit 0

for path in \
  ".github/PULL_REQUEST_TEMPLATE.md" \
  ".github/pull_request_template.md" \
  "PULL_REQUEST_TEMPLATE.md" \
  "pull_request_template.md" \
  "docs/PULL_REQUEST_TEMPLATE.md" \
  "docs/pull_request_template.md"; do
  if [ -f "$root/$path" ]; then
    cat "$root/$path"
    exit 0
  fi
done
