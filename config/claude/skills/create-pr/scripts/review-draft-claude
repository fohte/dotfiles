#!/bin/bash
set -euo pipefail

if [[ $# -ne 6 ]]; then
  echo "Usage: review-draft-claude <model> <reasoning_effort> <prompt_file> <result_file> <work_dir> <home>" >&2
  exit 2
fi

model="$1"
reasoning_effort="$2"
prompt_file="$3"
result_file="$4"
work_dir="$5"
user_home="$6"

[[ -s "$prompt_file" ]] || {
  echo "Error: Claude draft review prompt is empty." >&2
  exit 3
}
[[ "$user_home" == /* && -d "$user_home" && -r "$user_home" && -x "$user_home" ]] || {
  echo "Error: Claude draft review requires an inspectable home directory." >&2
  exit 3
}

host_os=$(uname -s)
case "$host_os" in
  Darwin)
    required_commands=(claude defaults dirname env find id jq mkdir mktemp profiles rg tr uname wc)
    ;;
  Linux)
    echo "Error: Claude isolation preflight has no verified Linux managed-policy and network gate." >&2
    exit 3
    ;;
  *)
    echo "Error: isolated Claude draft review is unsupported on $host_os." >&2
    exit 3
    ;;
esac

for required_command in "${required_commands[@]}"; do
  command -v "$required_command" > /dev/null || {
    echo "Error: required command not found: $required_command" >&2
    exit 3
  }
done

claude_path=$(command -v claude)
claude_bin_dir=$(dirname "$claude_path")
launch_path="$claude_bin_dir:/usr/bin:/bin:/usr/sbin:/sbin"
launch_user=$(id -un)
tmp_dir="$work_dir/claude-tmp"
empty_cwd="$work_dir/claude-cwd"
auth_status_file="$work_dir/claude-auth-status.json"
doctor_file="$work_dir/claude-doctor.log"
events_file="$work_dir/claude-events.jsonl"
stderr_file="$work_dir/claude-stderr.log"
mcp_config_file="$work_dir/empty-mcp.json"
mkdir -p "$tmp_dir" "$empty_cwd"

clean_env_args=(
  env -i
  "HOME=$user_home"
  "PATH=$launch_path"
  "USER=$launch_user"
  "LOGNAME=$launch_user"
  "TMPDIR=$tmp_dir"
  "TERM=dumb"
  "LANG=C"
  "LC_ALL=C"
)

cli_version=$("${clean_env_args[@]}" "$claude_path" --version) || {
  echo "Error: unable to inspect the Claude CLI version." >&2
  exit 3
}
[[ "$cli_version" == "2.1.310 (Claude Code)" ]] || {
  echo "Error: isolated Claude draft review is verified only with Claude Code 2.1.310 (found: $cli_version)." >&2
  exit 3
}

assert_absent_path() {
  local source_path="$1"
  if [[ -e "$source_path" || -L "$source_path" ]]; then
    echo "Error: Claude managed source is present: $source_path" >&2
    return 1
  fi
}

assert_inspectable_directory() {
  local directory="$1"
  [[ -d "$directory" && -r "$directory" && -x "$directory" && ! -L "$directory" ]] || {
    echo "Error: Claude managed source path is not inspectable: $directory" >&2
    return 1
  }
}

check_system_managed_sources() {
  local system_dir parent_dir
  system_dir="/Library/Application Support/ClaudeCode"
  assert_inspectable_directory "/Library" || return 1
  assert_inspectable_directory "/Library/Application Support" || return 1

  parent_dir=$(dirname "$system_dir")
  assert_inspectable_directory "$parent_dir" || return 1
  if [[ -e "$system_dir" || -L "$system_dir" ]]; then
    assert_inspectable_directory "$system_dir" || return 1
  fi

  assert_absent_path "$system_dir/managed-settings.json" || return 1
  assert_absent_path "$system_dir/managed-settings.d" || return 1
  assert_absent_path "$system_dir/managed-mcp.json" || return 1
  if [[ -d "$system_dir" ]]; then
    local first_system_entry
    if ! first_system_entry=$(find "$system_dir" -mindepth 1 -print -quit); then
      echo "Error: unable to enumerate the Claude managed settings directory." >&2
      return 1
    fi
    if [[ -n "$first_system_entry" ]]; then
      echo "Error: Claude managed settings directory contains an unverified source." >&2
      return 1
    fi
  fi

  if [[ "$host_os" == "Darwin" ]]; then
    local managed_preferences_dir profile_status_file profiles_file defaults_file
    managed_preferences_dir="/Library/Managed Preferences"
    if [[ -e "$managed_preferences_dir" || -L "$managed_preferences_dir" ]]; then
      assert_inspectable_directory "$managed_preferences_dir" || return 1
    fi
    assert_absent_path "$managed_preferences_dir/com.anthropic.claudecode.plist" || return 1
    assert_absent_path "/Library/Preferences/com.anthropic.claudecode.plist" || return 1
    assert_absent_path "$user_home/Library/Managed Preferences/com.anthropic.claudecode.plist" || return 1
    assert_absent_path "$user_home/Library/Preferences/com.anthropic.claudecode.plist" || return 1

    profile_status_file="$work_dir/profiles-status.txt"
    profiles_file="$work_dir/profiles.txt"
    defaults_file="$work_dir/defaults-domains.txt"
    if ! profiles status -type enrollment > "$profile_status_file" 2>&1; then
      echo "Error: unable to inspect macOS MDM enrollment." >&2
      return 1
    fi
    if ! rg -qi '^Enrolled via DEP:[[:space:]]*No([[:space:]].*)?$' "$profile_status_file" ||
      ! rg -qi '^MDM enrollment:[[:space:]]*No([[:space:]].*)?$' "$profile_status_file"; then
      echo "Error: Claude draft review cannot rule out macOS MDM settings." >&2
      return 1
    fi
    if ! profiles show -type configuration > "$profiles_file" 2>&1; then
      echo "Error: unable to inspect macOS configuration profiles." >&2
      return 1
    fi
    if rg -qi 'com\.anthropic\.claudecode' "$profiles_file"; then
      echo "Error: macOS profiles contain Claude Code managed settings." >&2
      return 1
    fi
    if ! defaults domains > "$defaults_file" 2>&1; then
      echo "Error: unable to inspect macOS preference domains." >&2
      return 1
    fi
    if rg -qi 'com\.anthropic\.claudecode' "$defaults_file"; then
      echo "Error: macOS preferences contain Claude Code managed settings." >&2
      return 1
    fi
    if ! defaults domains -currentHost > "$defaults_file" 2>&1; then
      echo "Error: unable to inspect current-host macOS preference domains." >&2
      return 1
    fi
    if rg -qi 'com\.anthropic\.claudecode' "$defaults_file"; then
      echo "Error: current-host preferences contain Claude Code managed settings." >&2
      return 1
    fi
  fi
}

check_system_managed_sources || exit 3

if ! "${clean_env_args[@]}" "$claude_path" auth status > "$auth_status_file" 2> "$stderr_file"; then
  echo "Error: Claude auth status could not be verified in a clean environment." >&2
  exit 3
fi
jq -e '.loggedIn == true and .authMethod == "claude.ai" and (.configDirectory | type == "string" and startswith("/"))' \
  "$auth_status_file" > /dev/null || {
  echo "Error: Claude draft review requires a first-party claude.ai subscription login." >&2
  exit 3
}
auth_config_dir=$(jq -er '.configDirectory' "$auth_status_file")
[[ -d "$auth_config_dir" && -r "$auth_config_dir" && -x "$auth_config_dir" ]] || {
  echo "Error: Claude auth configuration directory is not inspectable." >&2
  exit 3
}
auth_config_dir=$(cd "$auth_config_dir" && pwd -P) || {
  echo "Error: Claude auth configuration directory cannot be resolved." >&2
  exit 3
}
assert_absent_path "$auth_config_dir/remote-settings.json" || exit 3
user_settings_file="$auth_config_dir/settings.json"
if [[ -e "$user_settings_file" || -L "$user_settings_file" ]]; then
  [[ -f "$user_settings_file" && -r "$user_settings_file" ]] || {
    echo "Error: Claude user settings cannot be inspected for provider overrides." >&2
    exit 3
  }
  jq -e '
    type == "object"
    and (if has("env") then (.env | type == "object") else true end)
    and ([.env // {} | keys[] | select(test("^(ANTHROPIC_|CLAUDE_CODE_USE_|CLAUDE_CODE_GATEWAY_)"))] | length == 0)
  ' "$user_settings_file" > /dev/null || {
    echo "Error: Claude user settings contain a provider or gateway override." >&2
    exit 3
  }
fi

if ! "${clean_env_args[@]}" "$claude_path" doctor > "$doctor_file" 2>&1; then
  echo "Error: Claude doctor could not verify the managed-settings state." >&2
  exit 3
fi
if ! rg -iq 'Managed settings \(remote\):[[:space:]]*not fetched.*requires an Enterprise or Team subscription' "$doctor_file"; then
  echo "Error: Claude remote managed settings are not confirmed absent." >&2
  exit 3
fi

printf '{"mcpServers":{}}\n' > "$mcp_config_file"
settings_json=$(jq -cn '{
  disableAllHooks: true,
  disableBundledSkills: true,
  enabledPlugins: {
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false
  }
}')

claude_args=(
  --print
  --output-format stream-json
  --verbose
  --restricted
  --safe-mode
  --no-session-persistence
  --tools ''
  --mcp-config "$mcp_config_file"
  --strict-mcp-config
  --disallowedTools 'mcp__*'
  --disable-slash-commands
  --settings "$settings_json"
)
[[ -z "$model" ]] || claude_args+=(--model "$model")
[[ -z "$reasoning_effort" ]] || claude_args+=(--effort "$reasoning_effort")

claude_env_args=(
  "${clean_env_args[@]}"
  "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS=1"
  "CLAUDE_CODE_DISABLE_FILE_MENTIONS=1"
  "CLAUDE_CODE_DISABLE_CLAUDE_MDS=1"
  "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1"
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
  "CLAUDE_CODE_MAX_RETRIES=0"
)

cd "$empty_cwd"
if ! "${claude_env_args[@]}" "$claude_path" "${claude_args[@]}" \
  < "$prompt_file" > "$events_file" 2> "$stderr_file"; then
  echo "Error: Claude draft reviewer failed." >&2
  exit 3
fi

output_bytes=$(wc -c < "$events_file" | tr -d '[:space:]')
[[ "$output_bytes" -le 1048576 ]] || {
  echo "Error: Claude draft reviewer output exceeded the size limit." >&2
  exit 3
}

expected_cwd=$(pwd -P)
if ! jq -s -e --arg expected_version "2.1.310" --arg expected_cwd "$expected_cwd" '
  [to_entries[] | select(.value.type == "system" and .value.subtype == "init") | .key] as $inits
  | [to_entries[] | select(.value.type == "result") | .key] as $results
  | length > 0
    and all(.[]; type == "object" and (.type | type == "string"))
    and all(.[];
      if .type == "system" then
        .subtype == "init"
      elif .type == "assistant" then
        (.message | type == "object")
        and .message.role == "assistant"
        and (.message.content | type == "array")
        and ([.message.content[] | select(.type == "tool_use")] | length == 0)
        and (.parent_tool_use_id == null)
      elif .type == "result" then
        true
      else
        false
      end
    )
    and ($inits | length == 1)
    and $inits[0] == 0
    and ($results | length == 1)
    and $results[0] == (length - 1)
    and (.[ $inits[0] ] | .claude_code_version == $expected_version)
    and (.[ $inits[0] ] | .cwd == $expected_cwd and .original_cwd == $expected_cwd)
    and (.[ $inits[0] ] | (.model | type == "string" and test("\\S")))
    and (.[ $inits[0] ] | (.tools | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.mcp_servers | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.skills | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.plugins | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.agents | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.slash_commands | type == "array" and length == 0))
    and (.[ $inits[0] ] | (if has("terminal_slash_commands") then (.terminal_slash_commands | type == "array" and length == 0) else true end))
    and (.[ $results[0] ] | .subtype == "success" and .is_error == false)
    and (.[ $results[0] ].stop_reason | IN("end_turn", "stop_sequence"))
    and (.[ $results[0] ].result | type == "string" and test("\\S"))
' "$events_file" > /dev/null; then
  echo "Error: Claude draft reviewer did not return a verified tool-free context and successful result." >&2
  exit 3
fi

jq -sr 'map(select(.type == "result"))[0].result' "$events_file" > "$result_file"
