#!/bin/bash
set -euo pipefail

if [[ $# -ne 6 ]]; then
  echo "Usage: review-draft-claude <model> <reasoning_effort> <prompt_file> <result_file> <work_dir> <home>" >&2
  exit 2
fi

model="$1"
reasoning_effort="$2"
prompt_file="$3"
result_file="$4"
work_dir="$5"
user_home="$6"

[[ -s "$prompt_file" ]] || {
  echo "Error: Claude draft review prompt is empty." >&2
  exit 3
}
[[ "$user_home" == /* && -d "$user_home" && -r "$user_home" && -x "$user_home" ]] || {
  echo "Error: Claude draft review requires an inspectable home directory." >&2
  exit 3
}

host_os=$(uname -s)
case "$host_os" in
  Darwin)
    required_commands=(claude dirname env id jq mkdir rg sed tr uname wc)
    ;;
  Linux)
    echo "Error: Claude isolation preflight has no verified Linux init-context validation path." >&2
    exit 3
    ;;
  *)
    echo "Error: isolated Claude draft review is unsupported on $host_os." >&2
    exit 3
    ;;
esac

for required_command in "${required_commands[@]}"; do
  command -v "$required_command" > /dev/null || {
    echo "Error: required command not found: $required_command" >&2
    exit 3
  }
done

claude_path=$(command -v claude)
claude_bin_dir=$(dirname "$claude_path")
launch_path="$claude_bin_dir:/usr/bin:/bin:/usr/sbin:/sbin"
launch_user=$(id -un)
tmp_dir="$work_dir/claude-tmp"
empty_cwd="$work_dir/claude-cwd"
auth_status_file="$work_dir/claude-auth-status.json"
events_file="$work_dir/claude-events.jsonl"
stderr_file="$work_dir/claude-stderr.log"
mcp_config_file="$work_dir/empty-mcp.json"
mkdir -p "$tmp_dir" "$empty_cwd"

clean_env_args=(
  env -i
  "HOME=$user_home"
  "PATH=$launch_path"
  "USER=$launch_user"
  "LOGNAME=$launch_user"
  "TMPDIR=$tmp_dir"
  "TERM=dumb"
  "LANG=C"
  "LC_ALL=C"
)

print_sanitized_diagnostics() {
  local log_file="$1"
  [[ -s "$log_file" ]] || return 0

  rg -i 'error|warning|fail|denied|unable|could not|not fetched|timed out|timeout' "$log_file" |
    sed -n '1,12p' |
    sed -E \
      -e 's#(https?://)[^/@[:space:]]+@#\1[REDACTED]@#g' \
      -e 's#(https?://[^?[:space:]]+)\?[^[:space:]]+#\1?[REDACTED]#g' \
      -e 's/(Bearer )[A-Za-z0-9._~+/-]+/\1[REDACTED]/g' \
      -e 's/(sk-ant-)[A-Za-z0-9_-]+/\1[REDACTED]/g' \
      -e 's/([Xx]-[Aa][Pp][Ii]-[Kk]ey:[[:space:]]*)[^[:space:]]+/\1[REDACTED]/g' \
      -e 's/((ANTHROPIC|CLAUDE_CODE)_[A-Za-z0-9_]+[=:])[[:graph:]]+/\1[REDACTED]/g' \
      -e 's/(([Hh][Tt][Tt][Pp][Ss]?|[Aa][Ll][Ll]|[Nn][Oo])_[Pp][Rr][Oo][Xx][Yy]=)[[:graph:]]+/\1[REDACTED]/g' >&2 || true
}

if ! "${clean_env_args[@]}" "$claude_path" auth status > "$auth_status_file" 2> "$stderr_file"; then
  echo "Error: Claude auth status could not be verified in a clean environment." >&2
  print_sanitized_diagnostics "$stderr_file"
  exit 3
fi
jq -e '.loggedIn == true and .authMethod == "claude.ai" and (.configDirectory | type == "string" and startswith("/"))' \
  "$auth_status_file" > /dev/null || {
  echo "Error: Claude draft review requires a first-party claude.ai subscription login." >&2
  exit 3
}
auth_config_dir=$(jq -er '.configDirectory' "$auth_status_file")
[[ -d "$auth_config_dir" && -r "$auth_config_dir" && -x "$auth_config_dir" ]] || {
  echo "Error: Claude auth configuration directory is not inspectable." >&2
  exit 3
}
auth_config_dir=$(cd "$auth_config_dir" && pwd -P) || {
  echo "Error: Claude auth configuration directory cannot be resolved." >&2
  exit 3
}

printf '{"mcpServers":{}}\n' > "$mcp_config_file"
settings_json=$(jq -cn '{
  disableAllHooks: true,
  disableBundledSkills: true,
  enabledPlugins: {
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false
  }
}')

claude_args=(
  --print
  --output-format stream-json
  --verbose
  --restricted
  --safe-mode
  --no-session-persistence
  --tools ''
  --mcp-config "$mcp_config_file"
  --strict-mcp-config
  --disallowedTools 'mcp__*'
  --disable-slash-commands
  --settings "$settings_json"
)
[[ -z "$model" ]] || claude_args+=(--model "$model")
[[ -z "$reasoning_effort" ]] || claude_args+=(--effort "$reasoning_effort")

claude_env_args=(
  "${clean_env_args[@]}"
  "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS=1"
  "CLAUDE_CODE_DISABLE_FILE_MENTIONS=1"
  "CLAUDE_CODE_DISABLE_CLAUDE_MDS=1"
  "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1"
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
  "CLAUDE_CODE_MAX_RETRIES=0"
)

cd "$empty_cwd"
if ! "${claude_env_args[@]}" "$claude_path" "${claude_args[@]}" \
  < "$prompt_file" > "$events_file" 2> "$stderr_file"; then
  echo "Error: Claude draft reviewer failed." >&2
  print_sanitized_diagnostics "$stderr_file"
  exit 3
fi

output_bytes=$(wc -c < "$events_file" | tr -d '[:space:]')
[[ "$output_bytes" -le 1048576 ]] || {
  echo "Error: Claude draft reviewer output exceeded the size limit." >&2
  exit 3
}

expected_cwd=$(pwd -P)
if ! jq -s -e --arg expected_cwd "$expected_cwd" '
  [to_entries[] | select(.value.type == "system" and .value.subtype == "init") | .key] as $inits
  | [to_entries[] | select(.value.type == "result") | .key] as $results
  | length > 0
    and all(.[]; type == "object" and (.type | type == "string"))
    and all(.[];
      if .type == "assistant" then
        (.message | type == "object")
        and .message.role == "assistant"
        and (.message.content | type == "array")
        and ([.message.content[] | select(.type == "tool_use")] | length == 0)
        and (.parent_tool_use_id == null)
      else
        true
      end
    )
    and ($inits | length == 1)
    and $inits[0] == 0
    and ($results | length == 1)
    and $results[0] == (length - 1)
    and (.[ $inits[0] ] | .cwd == $expected_cwd and .original_cwd == $expected_cwd)
    and (.[ $inits[0] ] | (.model | type == "string" and test("\\S")))
    and (.[ $inits[0] ] | (.tools | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.mcp_servers | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.skills | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.plugins | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.agents | type == "array" and length == 0))
    and (.[ $inits[0] ] | (.slash_commands | type == "array" and length == 0))
    and (.[ $inits[0] ] | (if has("terminal_slash_commands") then (.terminal_slash_commands | type == "array" and length == 0) else true end))
    and (.[ $results[0] ] | .subtype == "success" and .is_error == false)
    and (.[ $results[0] ].stop_reason | IN("end_turn", "stop_sequence"))
    and (.[ $results[0] ].result | type == "string" and test("\\S"))
' "$events_file" > /dev/null; then
  echo "Error: Claude draft reviewer did not return a verified tool-free context and successful result." >&2
  exit 3
fi

jq -sr 'map(select(.type == "result"))[0].result' "$events_file" > "$result_file"
