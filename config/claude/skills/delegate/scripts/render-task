#!/bin/bash
# Render a delegate task.yaml into the --prompt markdown that `a agent new`
# expects. See SKILL.md's "プロンプト構造" for the task.yaml schema.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
task_file="${1:?Usage: render-task <task.yaml>}"

gomplate -d task="$task_file" -f "$script_dir/prompt-template.md"
