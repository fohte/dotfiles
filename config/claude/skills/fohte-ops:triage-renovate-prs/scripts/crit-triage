#!/usr/bin/env python3
"""Render a triage report, collect its crit decision, and act on approvals.

Usage: crit-triage <data.json> [crit args...]
       crit-triage --vibe-approve <data.json>
       crit-triage --selftest

The caller writes the JSON data. HTML, state, and completion files are written
next to it. The normal command opens the report in crit and acts on its approved
merge verdicts. `--vibe-approve` validates vibe mode, posts approve reviews for
merge verdicts, and never merges.

Data format:

- Top level: `title`, `repo`, `public`, `groups`, optional `proposals`.
- `public` is true for public non-Japanese repos and requires `text_en` on every
  change and impact.
- Each group has `verdict` (`merge`, `auto`, `delegate`, or `hold`), `title`, and
  `prs`.
- Each PR has `number`, `title`, optional `url`, `scope`, `versions`, and
  `head_sha`; optional `gates` (`ci`, `release`, `order`) with `level` and
  `text`; and `changes`. `--vibe-approve` requires `head_sha`.
- Each change has `text`, optional `text_en`, optional `breaking`, and `impact`.
  Impact has `level`, `text`, optional `text_en`, and `action` when `level` is
  `warn`.
- Each proposal has `title`, `target` (`repo`, `shared`, `why`), `diff`, at least
  one `risks` entry (`level`, `text`, optional `evidence`), and `on_approve`.

Validation rules:

- Gate text is at most 60 characters; impact text is at most 120 characters.
- A warning impact requires an action. Every `merge` PR must derive to an
  unblocked verdict.
- Data-derived approve review text cannot contain upstream issue/PR references or
  URLs. The generated agent footer is appended separately.
- A proposal requires `target.why` and at least one risk.
- Markdown-lite is supported in `text` / `text_en`: inline code and links. Other
  values are escaped.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from crit_triage.actions import act_on_approvals, post_approve_reviews
from crit_triage.crit_ui import run_crit, serve
from crit_triage.report import render
from crit_triage.selftest import selftest
from crit_triage.vibe import require_vibe_mode


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__.splitlines()[2])

    if sys.argv[1] == "--selftest":
        if len(sys.argv) != 2:
            raise SystemExit("Usage: crit-triage --selftest")
        return selftest()

    vibe_approve = sys.argv[1] == "--vibe-approve"
    if vibe_approve and len(sys.argv) != 3:
        raise SystemExit("Usage: crit-triage --vibe-approve <data.json>")

    data_path = Path(sys.argv[2] if vibe_approve else sys.argv[1])
    if vibe_approve:
        require_vibe_mode()

    data = json.loads(data_path.read_text())
    if vibe_approve:
        render(data, "")
        if not post_approve_reviews(data, data_path.with_suffix(".done.json")):
            raise SystemExit(1)
        return 0

    html_path = data_path.with_suffix(".html")
    state_path = data_path.with_suffix(".state.json")

    port, token = serve(state_path)
    html_path.write_text(render(data, f"{port}/{token}"))

    rc, approved = run_crit(sys.argv[2:], html_path)
    if rc != 0:
        raise SystemExit(f"crit exited with {rc}; no triage result collected")
    if approved is None:
        raise SystemExit("crit ended before the review was finished; no result collected, nothing posted")

    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    result = {
        f"pr-{pr['number']}": state.get(f"pr-{pr['number']}", "deny")
        for group in data["groups"]
        for pr in group["prs"]
    }
    result.update(
        {
            f"prop-{index + 1}": state.get(f"prop-{index + 1}", "deny")
            for index in range(len(data.get("proposals") or []))
        }
    )
    print("--- state ---")
    print(json.dumps(result, ensure_ascii=False))

    print("--- done ---")
    if approved:
        act_on_approvals(data, result, data_path.with_suffix(".done.json"))
    else:
        print("nothing: the review was finished with changes requested")


if __name__ == "__main__":
    main()
