<div class="wrap">
<h1>__TITLE__ — <a href="https://github.com/__REPO__">__REPO__</a></h1>
__GROUPS__
__PROPOSALS__
</div>

<div class="bar">
  <span>approve <b id="count">0</b> / __TOTAL__</span>
  <span class="hint">deny が既定。PR の承認 = この対応方針で進め投稿コメントをそのまま GitHub に出してよい。提案の承認 = 変更に着手してよい。指摘・質問は crit のコメントで</span>
  <span id="saved">…</span>
</div>

<script>
const API = 'http://127.0.0.1:__ENDPOINT__'
const saved = document.getElementById('saved')
const count = document.getElementById('count')
const radios = [...document.querySelectorAll('.tg input')]
const names = [...new Set(radios.map((r) => r.name))]

const collect = () =>
  Object.fromEntries(names.map((n) => [n, document.querySelector(`input[name="${n}"]:checked`).value]))

const render = (s) => (count.textContent = Object.values(s).filter((v) => v === 'approve').length)

const save = () => {
  const s = collect()
  render(s)
  fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(s) })
    .then(() => (saved.textContent = 'saved ' + new Date().toLocaleTimeString()))
    .catch((e) => (saved.textContent = 'POST failed: ' + e))
}

fetch(API)
  .then((r) => r.json())
  .then((s) => {
    Object.entries(s).forEach(([n, v]) => {
      const el = document.querySelector(`input[name="${n}"][value="${v}"]`)
      if (el) el.checked = true
    })
    render(collect())
    saved.textContent = 'loaded'
  })
  .catch((e) => (saved.textContent = 'GET failed: ' + e))

radios.forEach((r) => r.addEventListener('change', save))
</script>
</body>
</html>
"""


def serve(state_path):
    """Start the state store on a free port and return its (port, token)."""
    # The page is served from crit's origin, so the store has to allow cross-origin
    # requests -- which also lets any other page the user has open reach it by
    # guessing the port. The token in the path is what keeps those pages out.
    token = secrets.token_urlsafe(16)

    class Handler(BaseHTTPRequestHandler):
        def _authorized(self):
            if self.path == f"/{token}":
                return True
            self.send_response(404)
            self.end_headers()
            return False

        def _cors(self):
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Headers", "content-type")

        def do_OPTIONS(self):
            if not self._authorized():
                return
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_GET(self):
            if not self._authorized():
                return
            body = state_path.read_bytes() if state_path.exists() else b"{}"
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self._cors()
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            if not self._authorized():
                return
            n = int(self.headers.get("Content-Length", 0))
            state_path.write_bytes(self.rfile.read(n))
            self.send_response(204)
            self._cors()
            self.end_headers()

        def log_message(self, *args):
            pass

    server = HTTPServer(("127.0.0.1", 0), Handler)
    # Daemon thread: the store dies with crit, so there is nothing to clean up.
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server.server_port, token


def run_crit(argv, html_path):
    """Run crit to completion, mirroring its stderr, and return (rc, approved).

    crit prints the review URL and a final `approved: true|false` on stderr.
    Neither line appears when the daemon dies before the review is finished --
    which exits 0 all the same -- so `approved` is None for that case and must
    not be read as a decision.
    """
    proc = subprocess.Popen(
        ["crit", *argv, "preview", str(html_path)], stderr=subprocess.PIPE, text=True, bufsize=1
    )
    approved = None
    for line in proc.stderr:
        sys.stderr.write(line)
        sys.stderr.flush()
        if line.strip() in {"approved: true", "approved: false"}:
            approved = line.strip().endswith("true")
    return proc.wait(), approved


def gh_pr(repo, num, argv, stdin=None):
    """Run one `gh pr <verb>` against a PR, reporting the outcome."""
    run = subprocess.run(
        ["gh", "pr", argv[0], str(num), "-R", repo, *argv[1:]],
        input=stdin,
        text=True,
        capture_output=True,
    )
    ok = run.returncode == 0
    print(f"{'ok' if ok else 'FAILED'} #{num} {argv[0]}" + ("" if ok else f": {run.stderr.strip()}"))
    return ok


def act_on_approvals(data, result, done_path):
    """Carry out what the human signed off on in the report, PR by PR.

    Proposals are never acted on here -- an approved proposal is only surfaced
    in the printed result for Claude to carry out afterwards.
    """
    done = set(json.loads(done_path.read_text())) if done_path.exists() else set()
    for group in data["groups"]:
        for pr in group["prs"]:
            num = pr["number"]
            if group["verdict"] != "merge" or result[pr_key(num)] != "approve":
                continue
            steps = []
            if pr.get("review_body"):
                steps.append((["review", "--approve", "--body-file", "-"], pr["review_body"]))
            # `--auto` hands the CI gate to GitHub, which merges once the required
            # checks pass -- including after a Renovate rebase, since only a push
            # from someone without write access disarms it.
            steps.append((["merge", "--squash", "--auto"], None))
            for argv, stdin in steps:
                # The deny loop re-runs this script against the same data file,
                # and one step can fail after an earlier one landed, so each is
                # recorded on its own rather than per PR.
                key = f"{num}:{argv[0]}"
                if key in done:
                    print(f"skip #{num} {argv[0]}: already done")
                    continue
                if not gh_pr(data["repo"], num, argv, stdin):
                    # Never arm a merge on a PR whose approving review failed to
                    # post; branch protection would block it anyway.
                    break
                done.add(key)
                done_path.write_text(json.dumps(sorted(done)))


def selftest():
    assert md("a<b & `x` [t](http://e/?a=1&b=2)") == (
        'a&lt;b &amp; <code>x</code> <a href="http://e/?a=1&amp;b=2">t</a>'
    )

    assert render_gates({}, 1) == ""
    g = render_gates({"ci": {"level": "ok", "text": "全 check green"}}, 1)
    assert g == "<i>CI</i>全 check green"
    g = render_gates({"order": {"level": "warn", "text": "[#118](url) が先"}}, 1)
    assert g == '<i>順序</i><span class="w"><a href="url">#118</a> が先</span>'
    try:
        render_gates({"ci": {"level": "warn", "text": "x" * 61}}, 1)
        assert False, "should reject overlong gate text"
    except SystemExit:
        pass
    try:
        render_gates({"ci": {"level": "maybe", "text": "x"}}, 1)
        assert False, "should reject unknown gate level"
    except SystemExit:
        pass

    ok_change = {"text": "t", "impact": {"level": "ok", "text": "i"}}
    warn_change = {
        "text": "t2",
        "text_en": "t2en",
        "breaking": True,
        "impact": {"level": "warn", "text": "i2", "text_en": "i2en", "action": "do x"},
    }
    row = render_changes([ok_change, warn_change], 1, public=False)
    assert '<span class="bk">BREAKING</span>' in row
    assert '<td class="imp w">要対応</td>' in row
    assert '<span class="todo">→ do x</span>' in row
    assert "upstream の変更 2 件" in row

    try:
        render_changes([{"text": "t", "impact": {"level": "warn", "text": "i"}}], 1, public=False)
        assert False, "warn impact without action should be rejected"
    except SystemExit:
        pass
    try:
        render_changes([{"text": "t", "impact": {"level": "ok", "text": "i" * 121}}], 1, public=False)
        assert False, "overlong impact text should be rejected"
    except SystemExit:
        pass
    try:
        render_changes([{"text": "t", "impact": {"level": "ok", "text": "i"}}], 1, public=True)
        assert False, "public repo without text_en should be rejected"
    except SystemExit:
        pass

    assert derive_verdict({}, []) == ("そのままマージしてよい", False)
    assert derive_verdict({"ci": {"level": "ok", "text": "x"}}, [ok_change]) == ("そのままマージしてよい", False)
    assert derive_verdict({}, [warn_change]) == ("今はマージできない — コード修正 1 件", True)
    text, blocked = derive_verdict({"order": {"level": "warn", "text": "#118 のマージ待ち"}}, [warn_change])
    assert blocked and text == "今はマージできない — コード修正 1 件 / #118 のマージ待ち", text
    # A CI failure caused by the already-counted warn change isn't a second reason.
    text, _ = derive_verdict({"ci": {"level": "warn", "text": "x"}}, [warn_change])
    assert text == "今はマージできない — コード修正 1 件", text
    # An uncaused CI failure is its own reason.
    text, _ = derive_verdict({"ci": {"level": "warn", "text": "x"}}, [])
    assert text == "今はマージできない — CI 調査中", text

    assert gen_review_body([], public=False) == "📝\n\n破壊的変更なし。"
    assert gen_review_body([], public=True) == "📝\n\nNo breaking changes."
    body = gen_review_body([ok_change, warn_change], public=False)
    assert "| t | なし | i |" in body
    assert "| **[BREAKING]** t2 | 要対応 | i2 |" in body
    body_en = gen_review_body([warn_change], public=True)
    assert "| **[BREAKING]** t2en | Action needed | i2en |" in body_en
    # A pipe in the content must not break the table.
    piped = gen_review_body([{"text": "a|b", "impact": {"level": "ok", "text": "c|d"}}], public=False)
    assert "a\\|b" in piped and "c\\|d" in piped

    try:
        check_no_upstream_refs("see acme/widget#42 for details", 1)
        assert False, "owner/repo#N reference should be rejected"
    except SystemExit:
        pass
    try:
        check_no_upstream_refs("see https://github.com/acme/widget/releases", 1)
        assert False, "upstream URL should be rejected"
    except SystemExit:
        pass
    check_no_upstream_refs("no references here", 1)  # must not raise

    assert f'name="{pr_key(9)}"' in render_pr(
        {"number": 9, "title": "t", "gates": {}, "changes": []}, "o/r", False, False, "merge"
    )
    merge_pr = {"number": 9, "title": "t", "gates": {}, "changes": [ok_change]}
    out = render_pr(merge_pr, "o/r", False, False, "merge")
    assert merge_pr["review_body"] == "📝\n\n| なにがおきるか | 影響 | 内容 |\n| --- | --- | --- |\n| t | なし | i |"
    assert "<pre>" in out and html.escape(merge_pr["review_body"]) in out

    delegate_pr = {"number": 10, "title": "t", "gates": {}, "changes": []}
    render_pr(delegate_pr, "o/r", False, False, "delegate")
    assert "review_body" not in delegate_pr

    try:
        render_pr({"number": 11, "title": "t", "gates": {}, "changes": [warn_change]}, "o/r", False, False, "merge")
        assert False, "a blocked PR in a merge group should be rejected"
    except SystemExit:
        pass

    # has_scope toggles the gutter on/off
    scoped = render_pr({"number": 1, "scope": "api", "title": "t", "gates": {}, "changes": []}, "o/r", False, True, "hold")
    assert '<span class="scope">api</span>' in scoped
    flat = render_pr({"number": 1, "title": "t", "gates": {}, "changes": []}, "o/r", False, False, "hold")
    assert "gutter" not in flat

    try:
        render_proposal({"title": "t", "target": {"repo": "o/r"}, "risks": [{"level": "ok", "text": "x"}]}, 1)
        assert False, "missing target.why should be rejected"
    except SystemExit:
        pass
    try:
        render_proposal({"title": "t", "target": {"repo": "o/r", "why": "w"}, "risks": []}, 1)
        assert False, "missing risks should be rejected"
    except SystemExit:
        pass
    prop = render_proposal(
        {
            "title": "t",
            "target": {"repo": "acme/config", "shared": True, "why": "w"},
            "diff": "-old\n+new",
            "risks": [{"level": "warn", "text": "r", "evidence": "$ cmd"}],
            "on_approve": "do it",
        },
        1,
    )
    assert f'name="{prop_key(1)}"' in prop
    assert '<span class="m">-old</span>' in prop and '<span class="p">+new</span>' in prop
    assert 'title="$ cmd"' in prop

    full = render(
        {
            "title": "T",
            "repo": "o/r",
            "public": False,
            "groups": [
                {
                    "verdict": "merge",
                    "title": "直接マージ",
                    "prs": [{"number": 118, "title": "t", "gates": {}, "changes": [ok_change]}],
                },
                {
                    "verdict": "delegate",
                    "title": "委任",
                    "prs": [{"number": 119, "title": "t2", "gates": {}, "changes": [warn_change]}],
                },
            ],
            "proposals": [
                {
                    "title": "p",
                    "target": {"repo": "o/r", "why": "w"},
                    "risks": [{"level": "ok", "text": "r"}],
                    "on_approve": "a",
                }
            ],
        },
        "12345/tok",
    )
    assert "#118" in full and "#119" in full and f'name="{prop_key(1)}"' in full
    assert "__" not in full  # no leftover template tokens

    # review_body must not be settable from the input
    try:
        render(
            {
                "repo": "o/r",
                "public": False,
                "groups": [{"verdict": "hold", "title": "g", "prs": [{"number": 1, "title": "t", "review_body": "x"}]}],
            },
            "1/t",
        )
        assert False, "review_body in the input should be rejected"
    except SystemExit:
        pass

    # render() must mutate pr["review_body"] before act_on_approvals() posts it --
    # that coupling is what makes "reviewed = what happens" true, so it needs its
    # own regression check instead of relying on a hand-authored review_body fixture.
    render_data = {
        "repo": "o/r",
        "public": False,
        "groups": [
            {
                "verdict": "merge",
                "title": "直接マージ",
                "prs": [{"number": 42, "title": "t", "gates": {}, "changes": [ok_change]}],
            }
        ],
    }
    render(render_data, "1/t")
    rendered_pr = render_data["groups"][0]["prs"][0]
    assert rendered_pr["review_body"] == gen_review_body([ok_change], public=False)

    posted = []

    def fake_post(cmd, **kw):
        posted.append((cmd, kw.get("input")))
        return subprocess.CompletedProcess(cmd, 0)

    real_run = subprocess.run
    subprocess.run = fake_post
    try:
        act_on_approvals(render_data, {pr_key(42): "approve"}, Path(tempfile.mkdtemp()) / "t.done.json")
    finally:
        subprocess.run = real_run
    review_calls = [(cmd, stdin) for cmd, stdin in posted if cmd[2] == "review"]
    assert len(review_calls) == 1, posted
    review_cmd, review_stdin = review_calls[0]
    assert review_cmd[2] == "review" and review_cmd[6:] == ["--approve", "--body-file", "-"], review_cmd
    assert review_stdin == rendered_pr["review_body"]

    calls = []
    data = {
        "repo": "o/r",
        "groups": [
            {
                "verdict": "merge",
                "prs": [
                    {"number": 1, "review_body": "b1"},  # reviewed, then merged
                    {"number": 2, "review_body": "b2"},  # denied
                    {"number": 3},  # merged without a review
                    {"number": 4, "review_body": "b4"},  # already done
                ],
            },
            {"verdict": "hold", "prs": [{"number": 5}]},  # approved, but not to merge
        ],
    }
    result = {pr_key(n): "deny" if n == 2 else "approve" for n in (1, 2, 3, 4, 5)}
    done = Path(tempfile.mkdtemp()) / "t.done.json"
    done.write_text('["4:merge", "4:review"]')
    real_run = subprocess.run

    def fake(cmd, **kw):
        calls.append(cmd)
        # #1 posts its review, then fails to arm the merge.
        return subprocess.CompletedProcess(cmd, 1 if cmd[2:4] == ["merge", "1"] else 0, stderr="x")

    subprocess.run = fake
    try:
        act_on_approvals(data, result, done)
        assert [(c[2], c[3]) for c in calls] == [
            ("review", "1"),
            ("merge", "1"),
            ("merge", "3"),
        ], calls
        assert json.loads(done.read_text()) == ["1:review", "3:merge", "4:merge", "4:review"]
        # Retrying must not repost #1's review just because its merge failed.
        calls.clear()
        act_on_approvals(data, result, done)
        assert [(c[2], c[3]) for c in calls] == [("merge", "1")], calls
    finally:
        subprocess.run = real_run
    print("ok")


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__.split("\n\n")[1])

    if sys.argv[1] == "--selftest":
        return selftest()

    data_path = Path(sys.argv[1])
    data = json.loads(data_path.read_text())
    html_path = data_path.with_suffix(".html")
    state_path = data_path.with_suffix(".state.json")

    port, token = serve(state_path)
    html_path.write_text(render(data, f"{port}/{token}"))

    rc, approved = run_crit(sys.argv[2:], html_path)
    # A crashed or abandoned crit leaves an untouched state file, which would
    # otherwise read as "the user denied everything" instead of "the user never
    # saw the report".
    if rc != 0:
        raise SystemExit(f"crit exited with {rc}; no triage result collected")
    if approved is None:
        raise SystemExit("crit ended before the review was finished; no result collected, nothing posted")

    # Fill in PRs and proposals the user never touched, so "missing" is never
    # mistaken for "approved".
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    result = {
        pr_key(pr["number"]): state.get(pr_key(pr["number"]), "deny")
        for group in data["groups"]
        for pr in group["prs"]
    }
    result.update(
        {prop_key(i + 1): state.get(prop_key(i + 1), "deny") for i in range(len(data.get("proposals") or []))}
    )
    print("--- state ---")
    print(json.dumps(result, ensure_ascii=False))

    print("--- done ---")
    # The per-PR toggles only carry consent once the review as a whole was
    # approved; finishing with changes requested revokes all of it.
    if approved:
        act_on_approvals(data, result, data_path.with_suffix(".done.json"))
    else:
        print("nothing: the review was finished with changes requested")


if __name__ == "__main__":
    main()
