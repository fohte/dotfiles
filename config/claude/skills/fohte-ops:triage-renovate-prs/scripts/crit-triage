#!/usr/bin/env python3
"""Render a triage report as HTML, open it in crit, and act on the approve/deny result.

Usage: crit-triage <data.json> [crit args...]

The caller (usually Claude) writes only the data JSON; the page chrome lives here.
Output goes next to the input: <data>.html, <data>.state.json and <data>.done.json.

Approving a `merge` PR here -- and then the crit review itself -- is what carries
out its plan: this same process posts the generated review comment as an approving
review and arms auto-merge on it. Nothing is written to disk between the report the
human read and the calls that act on it, so what was reviewed is what happens.

A PR card answers two questions: is it safe to merge right now (the "gates" line:
CI / release / merge order), and does this update break the repo (the "changes"
table: what happened upstream, whether it hits this repo, and what to do about it
if it does). The one-line verdict at the top of the card is never written by hand --
it is derived from gates + changes, so it can never say something the data
underneath contradicts. The review comment posted to GitHub is generated from the
same changes table, so the report and the comment show the same facts.

Data format:

    {
      "title": "Renovate PR triage",
      "repo": "acme/web",
      "public": false,               // true => public repo, comment cells go in English
      "groups": [
        {
          "verdict": "merge",        // merge | auto | delegate | hold
          "title": "直接マージ",
          "note": "承認後このセッションで squash merge する",
          "prs": [
            {
              "number": 119,
              "scope": "api",        // omit if the repo only has one component
              "title": "chore(deps): update foo-lib to v5",
              "url": "...",         // optional, defaults to the repo's PR URL
              "versions": "foo-lib 4.2.0 → 5.0.0",

              // Procedural line (is it OK to merge right now?). Omit a key if it
              // doesn't apply to this PR (e.g. no "order" if nothing depends on it).
              "gates": {
                "ci":      {"level": "ok",   "text": "全 check green"},
                "release": {"level": "ok",   "text": "api が patch bump (意図通り)"},
                "order":   {"level": "warn", "text": "#118 のマージ待ち"}
              },

              // What changed upstream, and whether it hits this repo. Only
              // upstream changes go here -- no grep commands, no release-note
              // URLs. The reason IS the evidence: "`foo()` is unused here" is
              // the reason, a URL to the release notes is not.
              "changes": [
                {
                  "text": "createClient() の第 2 引数が options オブジェクトに変更",
                  "text_en": "createClient() now takes an options object as its 2nd arg",
                  "breaking": true,
                  "impact": {
                    "level": "warn",       // ok (影響なし) | warn (要対応)
                    "text": "src/api/client.ts:12 が旧シグネチャ",
                    "text_en": "src/api/client.ts:12 still uses the old signature",
                    "action": "createClient(url, 5000) を createClient(url, { timeoutMs: 5000 }) に書き換える"
                  }
                }
              ]
            }
          ]
        }
      ],

      // Renovate config changes (automerge expansion, commit-prefix rules, ...).
      // A different decision than merging a PR, so it gets its own approve
      // toggle (`prop-<n>`) and crit-triage never acts on it -- an approved
      // proposal is only returned in the result for Claude to carry out.
      "proposals": [
        {
          "title": "actions/** の major も automerge 対象にする",
          "target": {
            "repo": "acme/renovate-config",
            "shared": true,          // false => this repo's own renovate.json5
            "why": "判断の根拠がこのリポジトリの使い方ではなくエコシステム全般の性質だから"
          },
          "diff": "// base.json5\\n-   matchUpdateTypes: ['minor', 'patch'],\\n+   matchUpdateTypes: ['minor', 'patch', 'major'],",
          "risks": [
            {"level": "warn", "text": "runner の最低バージョンが上がると self-hosted runner のリポジトリが no-look で壊れる"},
            {"level": "ok", "text": "対象リポジトリは全て GitHub-hosted", "evidence": "$ rg runs-on -r ..."}
          ],
          "on_approve": "/delegate-claude で acme/renovate-config に委任し、PR を立てるところまで"
        }
      ]
    }

Rules enforced at render time (a violation raises SystemExit rather than being
silently dropped from the report):

- gates.*.text <= 60 chars, impact.text <= 120 chars -- what doesn't fit belongs
  in a proposal, not squeezed into the card
- impact.level == "warn" requires impact.action
- when "public" is true, every change and its impact needs a *_en counterpart
- a PR in a "merge" group must derive to an unblocked verdict (no warn gates or
  impacts) -- a PR that isn't safe to merge yet doesn't belong in that group
- the generated review comment may not contain an `owner/repo#123` reference or
  an upstream URL (those show up as cross-references on a third-party repo)
- a proposal needs target.why and at least one risk

Every `text` / `text_en` field takes markdown-lite: `code` and [label](url).
Everything else is escaped.
"""
import html
import json
import re
import secrets
import subprocess
import sys
import tempfile
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

LINK = re.compile(r"\[([^\]]+)\]\(([^)]+)\)")
CODE = re.compile(r"`([^`]+)`")
VERDICTS = {"merge", "auto", "delegate", "hold"}
GATE_ORDER = ("ci", "release", "order")
GATE_LABEL = {"ci": "CI", "release": "リリース", "order": "順序"}
IMPACT_LABEL = {"ok": ("なし", "None"), "warn": ("要対応", "Action needed")}
MAX_GATE_TEXT = 60
MAX_IMPACT_TEXT = 120
UPSTREAM_REF = re.compile(r"[\w.-]+/[\w.-]+#\d+|https?://")


def md(text):
    """Escape HTML, then re-enable inline code and links."""
    out = html.escape(str(text))
    out = LINK.sub(r'<a href="\2">\1</a>', out)
    return CODE.sub(r"<code>\1</code>", out)


def pr_key(number):
    """Radio group name, and the key the caller reads the approve/deny result by."""
    return f"pr-{number}"


def prop_key(index):
    """Radio group name for the `index`-th (1-based) proposal."""
    return f"prop-{index}"


def render_gates(gates, pr_num):
    unknown = set(gates) - set(GATE_ORDER)
    if unknown:
        raise SystemExit(f"#{pr_num}: unknown gates key(s): {sorted(unknown)}")
    parts = []
    for key in GATE_ORDER:
        gate = gates.get(key)
        if not gate:
            continue
        level = gate["level"]
        if level not in {"ok", "warn"}:
            raise SystemExit(f"#{pr_num}: unknown gates.{key}.level: {level}")
        text = gate["text"]
        if len(text) > MAX_GATE_TEXT:
            raise SystemExit(f"#{pr_num}: gates.{key}.text exceeds {MAX_GATE_TEXT} chars: {text}")
        body = md(text)
        if level == "warn":
            body = f'<span class="w">{body}</span>'
        parts.append(f"<i>{GATE_LABEL[key]}</i>{body}")
    return '<span class="sep">|</span>'.join(parts)


def render_change(change, pr_num, public):
    """Validate one change + its impact, and render its <tr>."""
    text = change["text"]
    if public and not change.get("text_en"):
        raise SystemExit(f"#{pr_num}: change is missing text_en (repo is public): {text}")

    impact = change.get("impact")
    if not impact:
        raise SystemExit(f"#{pr_num}: change is missing impact: {text}")
    level = impact["level"]
    if level not in {"ok", "warn"}:
        raise SystemExit(f"#{pr_num}: unknown impact.level: {level}")
    if len(impact["text"]) > MAX_IMPACT_TEXT:
        raise SystemExit(f"#{pr_num}: impact.text exceeds {MAX_IMPACT_TEXT} chars: {impact['text']}")
    if level == "warn" and not impact.get("action"):
        raise SystemExit(f"#{pr_num}: impact.level is warn but action is missing: {text}")
    if public and not impact.get("text_en"):
        raise SystemExit(f"#{pr_num}: impact is missing text_en (repo is public): {impact['text']}")

    mark = '<span class="bk">BREAKING</span>' if change.get("breaking") else ""
    what_td = f"<td>{mark}{md(text)}</td>"
    cls = " w" if level == "warn" else ""
    imp_td = f'<td class="imp{cls}">{IMPACT_LABEL[level][0]}</td>'
    detail = md(impact["text"])
    if level == "warn":
        detail += f'<span class="todo">→ {md(impact["action"])}</span>'
    detail_td = f'<td class="r{cls}">{detail}</td>'
    return f"<tr>{what_td}{imp_td}{detail_td}</tr>"


def render_changes(changes, pr_num, public):
    """Render the changes table. Empty input renders nothing -- nothing to report."""
    if not changes:
        return ""
    rows = "".join(render_change(c, pr_num, public) for c in changes)
    return (
        f'<table class="ev">\n'
        f"<caption>upstream の変更 {len(changes)} 件</caption>\n"
        f"<tr><th>なにがおきるか</th><th>影響</th><th>内容</th></tr>\n"
        f"{rows}\n"
        f"</table>"
    )


def derive_verdict(gates, changes):
    """The one-line verdict, derived from gates + changes so no one has to write it.

    `changes` must already be validated (every entry has "impact"."level") --
    call this only after render_changes() on the same list.
    """
    warn_changes = sum(1 for c in changes if c["impact"]["level"] == "warn")
    reasons = []
    if warn_changes:
        reasons.append(f"コード修正 {warn_changes} 件")
    order = gates.get("order")
    if order and order["level"] == "warn":
        reasons.append(order["text"])
    ci = gates.get("ci")
    # A failing CI check caused by a change already counted above isn't a second
    # reason -- it's the same reason showing up twice.
    if ci and ci["level"] == "warn" and not warn_changes:
        reasons.append("CI 調査中")
    release = gates.get("release")
    if release and release["level"] == "warn":
        reasons.append(release["text"])
    if not reasons:
        return "そのままマージしてよい", False
    return "今はマージできない — " + " / ".join(reasons), True


def _esc_cell(text):
    return text.replace("|", "\\|").replace("\n", " ")


def gen_review_body(changes, public):
    """The approve-review comment, generated from the (already-validated) changes table."""
    if not changes:
        return "📝\n\n" + ("No breaking changes." if public else "破壊的変更なし。")
    if public:
        header, sep = "| What changed | Impact here | Details |", "| --- | --- | --- |"
        rows = [
            "| {} | {} | {} |".format(
                _esc_cell(("**[BREAKING]** " if c.get("breaking") else "") + c["text_en"]),
                IMPACT_LABEL[c["impact"]["level"]][1],
                _esc_cell(c["impact"]["text_en"]),
            )
            for c in changes
        ]
    else:
        header, sep = "| なにがおきるか | 影響 | 内容 |", "| --- | --- | --- |"
        rows = [
            "| {} | {} | {} |".format(
                _esc_cell(("**[BREAKING]** " if c.get("breaking") else "") + c["text"]),
                IMPACT_LABEL[c["impact"]["level"]][0],
                _esc_cell(c["impact"]["text"]),
            )
            for c in changes
        ]
    return "📝\n\n" + "\n".join([header, sep, *rows])


def check_no_upstream_refs(text, pr_num):
    """`owner/repo#123` and bare URLs turn into cross-references on someone else's repo."""
    m = UPSTREAM_REF.search(text)
    if m:
        raise SystemExit(f"#{pr_num}: generated review body references an upstream issue/PR or URL: {m.group(0)!r}")


def render_pr(pr, repo, public, has_scope, group_verdict):
    num = pr["number"]
    name = pr_key(num)
    url = html.escape(pr.get("url") or f"https://github.com/{repo}/pull/{num}")
    gates = pr.get("gates", {})
    changes = pr.get("changes", [])

    gates_html = render_gates(gates, num)
    changes_html = render_changes(changes, num, public)  # validates changes as a side effect

    verdict_text, blocked = derive_verdict(gates, changes)
    if group_verdict == "merge" and blocked:
        raise SystemExit(f"#{num}: in a merge group but its derived verdict blocks merging: {verdict_text}")

    review_body = None
    if group_verdict == "merge":
        review_body = gen_review_body(changes, public)
        check_no_upstream_refs(review_body, num)
        pr["review_body"] = review_body
    # Outside `merge` the toggle means "go ahead and delegate/hold/automerge this
    # PR", so it must never carry an approving review.
    if pr.get("review_body") and group_verdict != "merge":
        raise SystemExit(f"review_body on a {group_verdict} PR: #{num}")

    if has_scope:
        scope = html.escape(pr.get("scope", ""))
        left = f'<div class="gutter"><span class="num">#{num}</span><span class="scope">{scope}</span></div>'
        num_prefix = ""
    else:
        left = ""
        num_prefix = f'<span class="num">#{num}</span> '

    vers = pr.get("versions")
    vers_html = f'<div class="vers">{md(vers)}</div>' if vers else ""
    id_html = f'<div class="id">{num_prefix}<h5><a href="{url}">{html.escape(pr["title"])}</a></h5>{vers_html}</div>'

    gates_block = f'<div class="gates">{gates_html}</div>' if gates_html else ""
    gen_block = ""
    if review_body:
        gen_block = (
            '<div class="gen"><div class="cap">投稿されるコメント (上の表から自動生成)</div>'
            f"<pre>{html.escape(review_body)}</pre></div>"
        )

    verdict_cls = " w" if blocked else ""
    flat = "" if has_scope else " flat"

    return f"""<section class="pr{flat}">
  <div class="head">
    {left}
    {id_html}
    <div class="tg">
      <input type="radio" name="{name}" id="{name}-d" value="deny" checked
        /><label for="{name}-d" data-v="deny">deny</label
        ><input type="radio" name="{name}" id="{name}-a" value="approve"
        /><label for="{name}-a" data-v="approve">approve</label>
    </div>
  </div>
  <div class="verdict{verdict_cls}">{md(verdict_text)}</div>
  {gates_block}
  {changes_html}
  {gen_block}
</section>"""


def render_diff(diff_text):
    lines = []
    for line in diff_text.split("\n"):
        esc = html.escape(line)
        if line.startswith("-"):
            lines.append(f'<span class="m">{esc}</span>')
        elif line.startswith("+"):
            lines.append(f'<span class="p">{esc}</span>')
        else:
            lines.append(esc)
    return "\n".join(lines)


def render_risk(risk, idx):
    level = risk["level"]
    if level not in {"ok", "warn"}:
        raise SystemExit(f"unknown risks[{idx}].level: {level}")
    cls = " w" if level == "warn" else ""
    mark = "▲" if level == "warn" else "●"
    evidence = ""
    if risk.get("evidence"):
        evidence = f' <span class="why" title="{html.escape(risk["evidence"])}">根拠</span>'
    return f'<li class="{cls}">{mark} {md(risk["text"])}{evidence}</li>'


def render_proposal(proposal, idx):
    key = prop_key(idx)
    target = proposal["target"]
    if not target.get("why"):
        raise SystemExit(f"proposal {idx}: target.why is required")
    risks = proposal.get("risks") or []
    if not risks:
        raise SystemExit(f"proposal {idx}: risks is required")

    shared = target.get("shared", False)
    where = "共有 config" if shared else "このリポジトリ"
    tgt = f'変更先: <b>{html.escape(target["repo"])}</b> ({where})'
    risks_html = "".join(render_risk(r, i) for i, r in enumerate(risks))

    return f"""<div class="pcard">
  <div class="head">
    <div class="id">
      <h5>{md(proposal["title"])}</h5>
      <div class="tgt">{tgt}</div>
    </div>
    <div class="tg">
      <input type="radio" name="{key}" id="{key}-d" value="deny" checked
        /><label for="{key}-d" data-v="deny">deny</label
        ><input type="radio" name="{key}" id="{key}-a" value="approve"
        /><label for="{key}-a" data-v="approve">approve</label>
    </div>
  </div>
  <div class="sect">
    <div class="cap">なぜ{"共有 config か" if shared else "このリポジトリか"}</div>
    <p>{md(target["why"])}</p>
  </div>
  <div class="sect">
    <div class="cap">差分</div>
    <pre class="d">{render_diff(proposal.get("diff", ""))}</pre>
  </div>
  <div class="sect">
    <div class="cap">これが事故になるとき</div>
    <ul class="risk">{risks_html}</ul>
  </div>
  <div class="sect">
    <div class="cap">承認したら</div>
    <p>{md(proposal["on_approve"])}</p>
  </div>
</div>"""


def render(data, endpoint):
    repo = data["repo"]
    if "public" not in data:
        raise SystemExit("data.public is required (true for public non-Japanese repos)")
    public = data["public"]
    has_scope = any(pr.get("scope") for group in data["groups"] for pr in group["prs"])

    groups_html = []
    for group in data["groups"]:
        verdict = group["verdict"]
        if verdict not in VERDICTS:
            raise SystemExit(f"unknown verdict: {verdict}")
        prs = group["prs"]
        for pr in prs:
            if "review_body" in pr:
                raise SystemExit(f"#{pr['number']}: review_body must not be set in the input; it is generated")
        note = f'<span class="note">{md(group["note"])}</span>' if group.get("note") else ""
        pr_html = "".join(render_pr(pr, repo, public, has_scope, verdict) for pr in prs)
        groups_html.append(
            f'<div class="group">\n'
            f'  <h2>{html.escape(group["title"])} <span class="n">({len(prs)})</span>{note}</h2>\n'
            f"  {pr_html}\n"
            f"</div>"
        )

    proposals = data.get("proposals") or []
    proposals_html = ""
    if proposals:
        cards = "".join(render_proposal(p, i + 1) for i, p in enumerate(proposals))
        proposals_html = f"<h2>Renovate 設定変更の提案</h2>\n{cards}"

    total = sum(len(g["prs"]) for g in data["groups"]) + len(proposals)
    title = html.escape(data.get("title", "Triage"))

    out = TEMPLATE
    for token, value in {
        "__TITLE__": title,
        "__REPO__": html.escape(repo),
        "__GROUPS__": "".join(groups_html),
        "__PROPOSALS__": proposals_html,
        "__TOTAL__": str(total),
        "__ENDPOINT__": endpoint,
    }.items():
        out = out.replace(token, value)
    return out


# Plain string, not str.format(): the JS below uses `${...}` template literals
# and object-literal braces, which would otherwise have to be doubled everywhere.
# Substitution is done with the __TOKEN__.replace() loop in render() instead.
TEMPLATE = """<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<title>__TITLE__</title>
<style>
:root {
  --bg: #14161a; --card: #1c1f25; --card2: #16181d; --line: #2c313a; --line2: #232830;
  --fg: #e3e6ea; --dim: #8b939f; --dimmer: #5f6773;
  --act: #e2b04a; /* the only semantic color: needs action */
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 2rem 2rem 6rem; background: var(--bg); color: var(--fg);
  font: 15px/1.6 -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}
.wrap { max-width: 960px; margin: 0 auto; }
h1 { font-size: 1.35rem; margin: 0 0 1.5rem; }
h2 { font-size: 0.95rem; margin: 2.2rem 0 0.8rem; padding-left: 0.6rem; border-left: 3px solid var(--dimmer); }
h2 .n { color: var(--dim); font-weight: 400; }
h2 .note { display: block; font-size: 0.8rem; font-weight: 400; color: var(--dim); margin-top: 0.15rem; }
code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.86em;
  background: #0f1114; padding: 0.1em 0.4em; border-radius: 3px;
}
a { color: inherit; text-decoration: underline; text-decoration-color: var(--dimmer); }

.group { margin-bottom: 2.2rem; }

.pr { background: var(--card); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 0.9rem; overflow: hidden; }
.pr .head { padding: 0.9rem 1rem 0.75rem; display: flex; gap: 0.9rem; align-items: flex-start; }
.pr .gutter { flex: none; width: 4.6rem; font-family: ui-monospace, monospace; padding-top: 0.1rem; }
.pr .gutter .num { display: block; color: var(--dimmer); font-size: 0.86rem; }
.pr .gutter .scope { display: block; color: var(--fg); font-size: 0.8rem; letter-spacing: 0.06em; margin-top: 0.15rem; }
.pr .id { flex: 1; min-width: 0; }
.pr .id > .num { color: var(--dimmer); font-family: ui-monospace, monospace; font-size: 0.86rem; }
.pr h5 { font-size: 1rem; font-weight: 600; margin: 0; }
.pr.flat .id h5 { display: inline; }
.pr .vers { font-family: ui-monospace, monospace; font-size: 0.78rem; color: var(--dimmer); margin-top: 0.25rem; }

.tg { flex: none; display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; font-size: 0.76rem; }
.tg input { position: absolute; opacity: 0; pointer-events: none; }
.tg label { padding: 0.28rem 0.8rem; cursor: pointer; color: var(--dimmer); user-select: none; }
.tg label + input + label { border-left: 1px solid var(--line); }
.tg input:checked + label { background: #303640; color: var(--fg); }
.tg input:focus-visible + label { outline: 2px solid var(--act); outline-offset: -2px; }

.pr .verdict { padding: 0 1rem 0.5rem 6.5rem; font-size: 1.08rem; font-weight: 600; }
.pr .verdict.w { color: var(--act); }
.pr.flat .verdict { padding-left: 1rem; }
.pr .gates { padding: 0 1rem 1rem 6.5rem; font-size: 0.84rem; color: var(--dim); }
.pr.flat .gates { padding-left: 1rem; }
.pr .gates i { font-style: normal; color: var(--dimmer); font-size: 0.76rem; margin-right: 0.3rem; }
.pr .gates .sep { color: var(--line); margin: 0 0.55rem; }
.pr .gates .w { color: var(--act); }

table.ev { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
table.ev caption { caption-side: top; text-align: left; font-size: 0.74rem; letter-spacing: 0.05em; color: var(--dimmer); padding: 0.5rem 1rem 0.4rem; border-top: 1px solid var(--line); background: var(--card2); }
table.ev th { text-align: left; font-weight: 600; font-size: 0.74rem; color: var(--dimmer); letter-spacing: 0.04em; padding: 0 1rem 0.45rem; border-bottom: 1px solid var(--line); background: var(--card2); }
table.ev td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--line2); vertical-align: top; }
table.ev tr:last-child td { border-bottom: none; }
table.ev td.imp { width: 4.6rem; color: var(--dimmer); white-space: nowrap; }
table.ev td.imp.w { color: var(--act); font-weight: 600; }
table.ev td.r { color: var(--dim); }
table.ev td.r.w { color: var(--act); }
.bk { font-family: ui-monospace, monospace; font-size: 0.68rem; letter-spacing: 0.08em; color: var(--dimmer); border: 1px solid var(--line); border-radius: 3px; padding: 0 0.3rem; margin-right: 0.4rem; vertical-align: 1px; }
.todo { display: block; margin-top: 0.3rem; color: var(--act); }

.gen { border-top: 1px solid var(--line); padding: 0.7rem 1rem 0.9rem; }
