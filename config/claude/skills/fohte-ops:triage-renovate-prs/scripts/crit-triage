<script>
const API = 'http://127.0.0.1:{endpoint}'
const saved = document.getElementById('saved')
const count = document.getElementById('count')
const radios = [...document.querySelectorAll('.tg input')]
const names = [...new Set(radios.map((r) => r.name))]

const collect = () =>
  Object.fromEntries(names.map((n) => [n, document.querySelector(`input[name="${{n}}"]:checked`).value]))

const render = (s) => (count.textContent = Object.values(s).filter((v) => v === 'approve').length)

const save = () => {{
  const s = collect()
  render(s)
  fetch(API, {{ method: 'POST', headers: {{ 'Content-Type': 'application/json' }}, body: JSON.stringify(s) }})
    .then(() => (saved.textContent = 'saved ' + new Date().toLocaleTimeString()))
    .catch((e) => (saved.textContent = 'POST failed: ' + e))
}}

fetch(API)
  .then((r) => r.json())
  .then((s) => {{
    Object.entries(s).forEach(([n, v]) => {{
      const el = document.querySelector(`input[name="${{n}}"][value="${{v}}"]`)
      if (el) el.checked = true
    }})
    render(collect())
    saved.textContent = 'loaded'
  }})
  .catch((e) => (saved.textContent = 'GET failed: ' + e))

radios.forEach((r) => r.addEventListener('change', save))
</script>
</body>
</html>
"""


def serve(state_path):
    """Start the state store on a free port and return its (port, token)."""
    # The page is served from crit's origin, so the store has to allow cross-origin
    # requests -- which also lets any other page the user has open reach it by
    # guessing the port. The token in the path is what keeps those pages out.
    token = secrets.token_urlsafe(16)

    class Handler(BaseHTTPRequestHandler):
        def _authorized(self):
            if self.path == f"/{token}":
                return True
            self.send_response(404)
            self.end_headers()
            return False

        def _cors(self):
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Headers", "content-type")

        def do_OPTIONS(self):
            if not self._authorized():
                return
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_GET(self):
            if not self._authorized():
                return
            body = state_path.read_bytes() if state_path.exists() else b"{}"
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self._cors()
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            if not self._authorized():
                return
            n = int(self.headers.get("Content-Length", 0))
            state_path.write_bytes(self.rfile.read(n))
            self.send_response(204)
            self._cors()
            self.end_headers()

        def log_message(self, *args):
            pass

    server = HTTPServer(("127.0.0.1", 0), Handler)
    # Daemon thread: the store dies with crit, so there is nothing to clean up.
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server.server_port, token


def run_crit(argv, html_path):
    """Run crit to completion, mirroring its stderr, and return (rc, approved).

    crit prints the review URL and a final `approved: true|false` on stderr.
    Neither line appears when the daemon dies before the review is finished --
    which exits 0 all the same -- so `approved` is None for that case and must
    not be read as a decision.
    """
    proc = subprocess.Popen(
        ["crit", *argv, "preview", str(html_path)], stderr=subprocess.PIPE, text=True, bufsize=1
    )
    approved = None
    for line in proc.stderr:
        sys.stderr.write(line)
        sys.stderr.flush()
        if line.strip() in {"approved: true", "approved: false"}:
            approved = line.strip().endswith("true")
    return proc.wait(), approved


def gh_pr(repo, num, argv, stdin=None):
    """Run one `gh pr <verb>` against a PR, reporting the outcome."""
    run = subprocess.run(
        ["gh", "pr", argv[0], str(num), "-R", repo, *argv[1:]],
        input=stdin,
        text=True,
        capture_output=True,
    )
    ok = run.returncode == 0
    print(f"{'ok' if ok else 'FAILED'} #{num} {argv[0]}" + ("" if ok else f": {run.stderr.strip()}"))
    return ok


def act_on_approvals(data, result, done_path):
    """Carry out what the human signed off on in the report, PR by PR."""
    done = set(json.loads(done_path.read_text())) if done_path.exists() else set()
    for group in data["groups"]:
        for pr in group["prs"]:
            num = pr["number"]
            if group["verdict"] != "merge" or result[pr_key(num)] != "approve":
                continue
            steps = []
            if pr.get("review_body"):
                steps.append((["review", "--approve", "--body-file", "-"], pr["review_body"]))
            # `--auto` hands the CI gate to GitHub, which merges once the required
            # checks pass -- including after a Renovate rebase, since only a push
            # from someone without write access disarms it.
            steps.append((["merge", "--squash", "--auto"], None))
            for argv, stdin in steps:
                # The deny loop re-runs this script against the same data file,
                # and one step can fail after an earlier one landed, so each is
                # recorded on its own rather than per PR.
                key = f"{num}:{argv[0]}"
                if key in done:
                    print(f"skip #{num} {argv[0]}: already done")
                    continue
                if not gh_pr(data["repo"], num, argv, stdin):
                    # Never arm a merge on a PR whose approving review failed to
                    # post; branch protection would block it anyway.
                    break
                done.add(key)
                done_path.write_text(json.dumps(sorted(done)))


def selftest():
    assert md("a<b & `x` [t](http://e/?a=1&b=2)") == (
        'a&lt;b &amp; <code>x</code> <a class="ref" href="http://e/?a=1&amp;b=2">t</a>'
    )
    row = render_row(
        {
            "label": "l",
            "items": [{"text": "t", "breaking": True, "impact": {"level": "warn", "text": "i"}}],
            "evidence": "<log>",
        }
    )
    assert '<span class="brk">[BREAKING]</span> t<span class="impact warn">▲ i</span>' in row
    assert "<pre>&lt;log&gt;</pre>" in row
    # The radio name and the result key must stay the same string, or every PR
    # silently reads back as "deny".
    assert f'name="{pr_key(9)}"' in render_pr({"number": 9, "title": "t", "rows": []}, "o/r")
    # The body is shown as-is, so `<b>` must not become markup and `*` must not
    # become emphasis -- what is displayed has to be what gets posted.
    assert "<pre class=\"post\">a &lt;b&gt; *c*</pre>" in render_pr(
        {"number": 9, "title": "t", "rows": [], "review_body": "a <b> *c*"}, "o/r"
    )

    calls = []
    data = {
        "repo": "o/r",
        "groups": [
            {
                "verdict": "merge",
                "prs": [
                    {"number": 1, "review_body": "b1"},  # reviewed, then merged
                    {"number": 2, "review_body": "b2"},  # denied
                    {"number": 3},  # merged without a review
                    {"number": 4, "review_body": "b4"},  # already done
                ],
            },
            {"verdict": "hold", "prs": [{"number": 5}]},  # approved, but not to merge
        ],
    }
    result = {pr_key(n): "deny" if n == 2 else "approve" for n in (1, 2, 3, 4, 5)}
    done = Path(tempfile.mkdtemp()) / "t.done.json"
    done.write_text('["4:merge", "4:review"]')
    real_run = subprocess.run

    def fake(cmd, **kw):
        calls.append(cmd)
        # #1 posts its review, then fails to arm the merge.
        return subprocess.CompletedProcess(cmd, 1 if cmd[2:4] == ["merge", "1"] else 0, stderr="x")

    subprocess.run = fake
    try:
        act_on_approvals(data, result, done)
        assert [(c[2], c[3]) for c in calls] == [
            ("review", "1"),
            ("merge", "1"),
            ("merge", "3"),
        ], calls
        assert json.loads(done.read_text()) == ["1:review", "3:merge", "4:merge", "4:review"]
        # Retrying must not repost #1's review just because its merge failed.
        calls.clear()
        act_on_approvals(data, result, done)
        assert [(c[2], c[3]) for c in calls] == [("merge", "1")], calls
    finally:
        subprocess.run = real_run
    print("ok")


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__.split("\n\n")[1])

    if sys.argv[1] == "--selftest":
        return selftest()

    data_path = Path(sys.argv[1])
    data = json.loads(data_path.read_text())
    html_path = data_path.with_suffix(".html")
    state_path = data_path.with_suffix(".state.json")

    port, token = serve(state_path)
    html_path.write_text(render(data, f"{port}/{token}"))

    rc, approved = run_crit(sys.argv[2:], html_path)
    # A crashed or abandoned crit leaves an untouched state file, which would
    # otherwise read as "the user denied everything" instead of "the user never
    # saw the report".
    if rc != 0:
        raise SystemExit(f"crit exited with {rc}; no triage result collected")
    if approved is None:
        raise SystemExit("crit ended before the review was finished; no result collected, nothing posted")

    # Fill in PRs the user never touched, so "missing" is never mistaken for "approved".
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    result = {
        pr_key(pr["number"]): state.get(pr_key(pr["number"]), "deny")
        for group in data["groups"]
        for pr in group["prs"]
    }
    print("--- state ---")
    print(json.dumps(result, ensure_ascii=False))

    print("--- done ---")
    # The per-PR toggles only carry consent once the review as a whole was
    # approved; finishing with changes requested revokes all of it.
    if approved:
        act_on_approvals(data, result, data_path.with_suffix(".done.json"))
    else:
        print("nothing: the review was finished with changes requested")


if __name__ == "__main__":
    main()
