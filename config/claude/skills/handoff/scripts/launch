#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat << 'EOF'
Usage: launch --handoff <handoff.md> --label <label> [options]

Options:
  --repo <path>       Start from this repository root
  --kind <kind>       Display work type
  --engine <engine>   Override the selected profile's engine for this session
  --model <model>     Override the selected profile's model for this session
  --reasoning-effort <effort>
                      Override the selected profile's reasoning effort for this session
  --dry-run           Validate settings without starting a session
  -h, --help          Show this help
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

if [[ $# -eq 1 && ($1 == --help || $1 == -h) ]]; then
  usage
  exit 0
fi

handoff_file=
label=
target_repo=
kind=
engine=
model=
reasoning_effort=
dry_run=false
seen_handoff=false
seen_label=false
seen_repo=false
seen_kind=false
seen_engine=false
seen_model=false
seen_reasoning_effort=false

while (($#)); do
  case "$1" in
    --handoff)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_handoff == false ]] || fail "--handoff requires one file path and may appear once."
      handoff_file=$2
      seen_handoff=true
      shift 2
      ;;
    --label)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_label == false ]] || fail "--label requires one value and may appear once."
      label=$2
      seen_label=true
      shift 2
      ;;
    --repo)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_repo == false ]] || fail "--repo requires one path and may appear once."
      target_repo=$2
      seen_repo=true
      shift 2
      ;;
    --kind)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_kind == false ]] || fail "--kind requires one value and may appear once."
      kind=$2
      seen_kind=true
      shift 2
      ;;
    --engine)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_engine == false ]] || fail "--engine requires one value and may appear once."
      engine=$2
      seen_engine=true
      shift 2
      ;;
    --model)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_model == false ]] || fail "--model requires one value and may appear once."
      model=$2
      seen_model=true
      shift 2
      ;;
    --reasoning-effort)
      [[ $# -ge 2 && -n $2 && $2 != --* && $seen_reasoning_effort == false ]] || fail "--reasoning-effort requires one value and may appear once."
      reasoning_effort=$2
      seen_reasoning_effort=true
      shift 2
      ;;
    --dry-run)
      [[ $dry_run == false ]] || fail "--dry-run may appear once."
      dry_run=true
      shift
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

[[ $seen_handoff == true ]] || fail "--handoff is required."
[[ $seen_label == true && -n ${label//[[:space:]]/} ]] || fail "--label is required and must not be empty."
[[ -f $handoff_file ]] || fail "handoff.md must be a non-empty file."

prompt=$(cat "$handoff_file")
[[ -n ${prompt//[[:space:]]/} ]] || fail "handoff.md must be a non-empty file."

cmd=(agent new --type handoff --child-launch allow)
[[ $seen_kind == true ]] && cmd+=(--kind "$kind")
[[ $seen_engine == true ]] && cmd+=(--engine "$engine")
[[ $seen_model == true ]] && cmd+=(--model "$model")
[[ $seen_reasoning_effort == true ]] && cmd+=(--reasoning-effort "$reasoning_effort")
if [[ $seen_repo == true ]]; then
  [[ -d $target_repo ]] || fail "--repo must name an existing repository directory."
  if ! target_repo=$(cd "$target_repo" && git root -r); then
    fail "Could not resolve --repo as a repository."
  fi
  cmd+=(-R "$target_repo")
fi
cmd+=(--label "$label" --prompt "$prompt")
[[ $dry_run == true ]] && cmd+=(--dry-run)

unset DELEGATE_TASK_PURPOSE DELEGATE_TQ_TASK_ID DELEGATE_TQ_CHECKLIST_ITEM_ID

exec a "${cmd[@]}"
