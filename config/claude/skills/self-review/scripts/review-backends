# shellcheck shell=bash
# shellcheck disable=SC2154 # Functions use state initialized by run-external-reviewers.
initialize_codex_home() {
  mkdir -p "$shared_codex_home"

  # Isolate user instructions and skills while preserving the credentials Codex needs.
  if [[ -f "$auth_file" && ! -e "$shared_codex_home/auth.json" && ! -L "$shared_codex_home/auth.json" ]]; then
    if ! ln -s "$auth_file" "$shared_codex_home/auth.json" 2> /dev/null &&
      [[ ! -e "$shared_codex_home/auth.json" && ! -L "$shared_codex_home/auth.json" ]]; then
      echo "Error: unable to link Codex credentials into $shared_codex_home/auth.json." >&2
      return 1
    fi
  fi
}

run_codex() {
  local reviewer="$1" reviewer_dir="$2" reasoning_effort="${3:-}"
  local resume_session_id="${4:-}" persist_session="${5:-false}"
  # Pin mise's trust-state location before HOME changes for the Codex process.
  local mise_state_dir="${MISE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mise}"
  local config_args=(--config 'cli_auth_credentials_store="file"')
  local command_status=0
  local codex_args=(exec)

  [[ "$mise_state_dir" == /* ]] || mise_state_dir="$PWD/$mise_state_dir"

  if [[ "$persist_session" == true ]]; then
    config_args+=(--config 'sandbox_mode="read-only"')
  fi
  initialize_codex_home
  [[ -n "$reasoning_effort" ]] && config_args+=(--config "model_reasoning_effort=\"$reasoning_effort\"")

  if [[ -n "$resume_session_id" ]]; then
    codex_args+=(resume "$resume_session_id" --json)
  else
    [[ "$persist_session" == true ]] && codex_args+=(--json) || codex_args+=(--ephemeral)
    codex_args+=(--sandbox read-only --color never)
  fi

  HOME="$shared_codex_home" CODEX_HOME="$shared_codex_home" MISE_STATE_DIR="$mise_state_dir" codex "${codex_args[@]}" \
    --ignore-user-config \
    "${model_args[@]+"${model_args[@]}"}" \
    "${config_args[@]}" \
    --output-schema "$schema_file" \
    --output-last-message "$reviewer_dir/result.json" \
    - < "$reviewer_dir/prompt.txt" > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log" || command_status=$?
  printf '%s\n' "$command_status" > "$reviewer_dir/backend-exit-code"
  [[ "$command_status" -eq 0 ]] || return "$command_status"

  if [[ "$persist_session" == true ]]; then
    local session_id
    jq -e --arg reviewer "$reviewer" '.reviewer == $reviewer' "$reviewer_dir/result.json" > /dev/null || return 1
    if [[ -n "$resume_session_id" ]]; then
      session_id="$resume_session_id"
    else
      session_id=$(jq -er 'select(.type == "thread.started") | .thread_id' "$reviewer_dir/stdout.log" | sed -n '1p') || return 1
    fi
    [[ -n "$session_id" ]] || return 1
    printf '%s\n' "$session_id" > "$reviewer_dir/session-id"
  fi
}

# In print mode, `--print` (and its `--prompt` alias) takes the prompt as the
# flag's own value, so it must be attached with `=` rather than left to consume
# the next argv token (a bare `--print` followed by another flag misparses that
# flag as the prompt). agy also wraps the schema-checked result in
# `.structured_output` rather than writing it as the whole message, unlike
# `codex --output-schema`.
run_agy() {
  local command_status=0
  local reviewer_dir="$1" reasoning_effort="${2:-}" effort_args=()
  local prompt prompt_bytes single_message_limit=191000 chunk_count conversation_id
  [[ -n "$reasoning_effort" ]] && effort_args=(--effort "$reasoning_effort")

  # Command substitution strips trailing newlines, matching the prompt hash recorded by diagnostics.
  prompt=$(cat "$reviewer_dir/prompt.txt") || return 1
  prompt_bytes=$(printf '%s' "$prompt" | wc -c | tr -d '[:space:]') || return 1

  # The measured 420-byte wrapper leaves 580 bytes below agy's 192,000-byte cutoff.
  if [[ "$prompt_bytes" -le "$single_message_limit" ]]; then
    agy \
      --sandbox \
      --add-dir "$repo_root" \
      "${model_args[@]+"${model_args[@]}"}" \
      "${effort_args[@]+"${effort_args[@]}"}" \
      --output-format json \
      --json-schema "$schema_file" \
      --print="$prompt" \
      > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log" || command_status=$?
    agy_collect_result "$reviewer_dir" "$command_status"
    return $?
  fi

  agy_prepare_stream_input "$reviewer_dir" "$prompt" || return 1
  chunk_count=$(jq -er '.count' "$reviewer_dir/agy-prompt-chunks.json") || return 1
  [[ "$chunk_count" -ge 2 ]] || return 1
  agy_send_stream_input "$reviewer_dir" "$reasoning_effort" || return $?
  conversation_id=$(agy_stream_conversation_id "$reviewer_dir" "$((chunk_count - 1))") || return 1
  agy_run_final_prompt "$reviewer_dir" "$conversation_id" "$chunk_count"
}

agy_collect_result() {
  local reviewer_dir="$1" command_status="$2"
  printf '%s\n' "$command_status" > "$reviewer_dir/backend-exit-code"

  # agy can report ERROR after a denied tool; a schema-checked payload still proves the review completed.
  if ! jq -e '.structured_output != null' "$reviewer_dir/stdout.log" > /dev/null 2>&1; then
    [[ "$command_status" -eq 0 ]] || return "$command_status"
    return 1
  fi
  jq '.structured_output' "$reviewer_dir/stdout.log" > "$reviewer_dir/result.json" 2> /dev/null
}

agy_prepare_stream_input() {
  local reviewer_dir="$1" prompt="$2" chunk_chars=35000
  local chunks_file="$reviewer_dir/agy-prompt-chunks.json"
  local stream_input="$reviewer_dir/agy-stream-input.jsonl"

  # jq slices Unicode code points; 35,000 characters use at most 140,000 UTF-8 bytes.
  printf '%s' "$prompt" > "$reviewer_dir/agy-prompt.txt" || return 1
  if ! jq -Rs -c --argjson chunk_chars "$chunk_chars" '
    . as $prompt
    | [range(0; ($prompt | length); $chunk_chars) as $start
       | $prompt[$start:($start + $chunk_chars)]] as $chunks
    | ($chunks | length) as $count
    | {
        count: $count,
        messages: [range(0; $count - 1) as $index
          | {
              event: "user",
              message: {
                content: ($chunks[$index]
                  + "\n\n[Transfer note: This is part "
                  + (($index + 1) | tostring)
                  + " of " + ($count | tostring)
                  + " of one review input. Do not call tools or start reviewing yet. Reply with ACK only.]")
              }
            }],
        last: $chunks[-1]
      }
  ' "$reviewer_dir/agy-prompt.txt" > "$chunks_file"; then
    return 1
  fi
  jq -c '.messages[]' "$chunks_file" > "$stream_input"
}

agy_send_stream_input() {
  local reviewer_dir="$1" reasoning_effort="${2:-}" effort_args=() stream_status=0
  [[ -n "$reasoning_effort" ]] && effort_args=(--effort "$reasoning_effort")

  # A schema here would set .structured_output on the first turn; later stream-json turns do not update it.
  agy \
    --sandbox \
    --add-dir "$repo_root" \
    "${model_args[@]+"${model_args[@]}"}" \
    "${effort_args[@]+"${effort_args[@]}"}" \
    --input-format stream-json \
    --output-format stream-json \
    < "$reviewer_dir/agy-stream-input.jsonl" \
    > "$reviewer_dir/agy-stream-stdout.log" 2> "$reviewer_dir/agy-stream-stderr.log" || stream_status=$?
  if [[ "$stream_status" -ne 0 ]]; then
    cat "$reviewer_dir/agy-stream-stderr.log" > "$reviewer_dir/stderr.log"
    printf '%s\n' "$stream_status" > "$reviewer_dir/backend-exit-code"
    return "$stream_status"
  fi
  return 0
}

agy_stream_conversation_id() {
  local reviewer_dir="$1" expected="$2" conversation_id
  local stream_stdout="$reviewer_dir/agy-stream-stdout.log"
  if ! jq -se --argjson expected "$expected" '
    (map(select(.event == "init" and (.conversation_id | type == "string" and length > 0))) | length == 1)
    and (map(select(.event == "result")) | length == $expected)
    and all(.[]; .event != "error")
    and all(.[] | select(.event == "result");
      .result.status == "SUCCESS" and
      (.result.response | type == "string" and test("^[[:space:]]*ACK[.!]?[[:space:]]*$"; "i"))
    )
  ' "$stream_stdout" > /dev/null; then
    cat "$reviewer_dir/agy-stream-stderr.log" > "$reviewer_dir/stderr.log"
    printf 'Error: agy stream-json did not acknowledge every prompt chunk successfully.\n' >&2
    printf '1\n' > "$reviewer_dir/backend-exit-code"
    return 1
  fi
  conversation_id=$(jq -ser '[.[] | select(.event == "init")][0].conversation_id' "$stream_stdout") || return 1
  if [[ -z "$conversation_id" ]]; then
    printf 'Error: agy stream-json did not return a conversation ID.\n' >&2
    printf '1\n' > "$reviewer_dir/backend-exit-code"
    return 1
  fi
  printf '%s\n' "$conversation_id"
}

agy_run_final_prompt() {
  local reviewer_dir="$1" conversation_id="$2" chunk_count="$3" command_status=0 final_prompt
  final_prompt=$(jq -rj --arg count "$chunk_count" '
    .last + "\n\n[Transfer note: All " + $count
    + " parts of the review input have been sent. Review the complete input now, following the request and instructions in the input.]"
  ' "$reviewer_dir/agy-prompt-chunks.json") || return 1

  agy \
    --conversation "$conversation_id" \
    --sandbox \
    --add-dir "$repo_root" \
    "${model_args[@]+"${model_args[@]}"}" \
    "${effort_args[@]+"${effort_args[@]}"}" \
    --output-format json \
    --json-schema "$schema_file" \
    --print="$final_prompt" \
    > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/agy-final-stderr.log" || command_status=$?
  cat "$reviewer_dir/agy-stream-stderr.log" "$reviewer_dir/agy-final-stderr.log" > "$reviewer_dir/stderr.log"
  agy_collect_result "$reviewer_dir" "$command_status"
}

# Git's global config and ignore file can resolve into the denied checkout.
git_global_read_paths() {
  local ignore
  ignore=$(git config --global --includes --path --get core.excludesfile || true)

  {
    git config --global --includes --list --show-origin --name-only |
      cut -f1 |
      sed 's/^file://' |
      sort -u
    printf '%s\n' "${ignore:-${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore}"
  } | sort -u | while IFS= read -r path; do
    [[ -e "$path" ]] || continue
    printf '%s\n%s\n' "$path" "$(realpath "$path")"
  done | jq -Rsc 'split("\n") | map(select(length > 0)) | unique'
}

# Restricting the tool set and enabling the sandbox are not two ways of saying
# the same thing: the sandbox governs Bash subprocesses only, so Write and Edit
# have to be dropped from the tool set, while `--tools` says nothing about what
# a shell command may touch. Either one alone leaves the repository writable.
#
# Reads are bounded once per mechanism for the same reason. The sandbox denies
# the checkout root so a review cannot wander into an unrelated repository, and
# re-opens the one under review inside it: sandbox read rules resolve by
# specificity, not deny-over-allow. Read, Grep, and Glob bypass the sandbox
# entirely and are bounded instead by the working directory plus
# `additionalDirectories`, so the secrets need a permission rule of their own. A
# permission rule needs the `//` prefix to mean an absolute path, so prefixing
# one produces three slashes; a plain `Read(/abs/path)` matches nothing and
# denies nothing.
#
# Writes are allowed under the reviewer's own scratch directory. Settling a
# doubt by running a minimal repro is part of the review, and it is per-reviewer
# so that parallel reviewers cannot overwrite each other's prompt or result.
#
# `--safe-mode` excludes ambient CLAUDE.md, custom skills/plugins, hooks and MCP
# servers. `--restricted` still loads the explicit settings file while ignoring
# user and repository settings; `--strict-mcp-config` keeps MCP disabled.
# build_prompt inlines every instruction file that applies to the diff, so the
# review contract stays identical to codex and agy.
#
# `--json-schema` takes the schema inline and rejects a path, unlike
# `codex --output-schema` and `agy --json-schema`. It also cannot resolve the
# `$schema` meta-schema reference the other two accept, and fails the whole run
# on it, so that key is dropped on the way in rather than removed from the file.
run_claude() {
  local reviewer_dir="$1" resume_session_id="${2:-}" persist_session="${3:-false}" reasoning_effort="${4:-}"
  local git_read_paths_json session_args=() effort_args=() session_id status=0
  mkdir -p "$reviewer_dir/scratch"
  [[ -n "$resume_session_id" ]] && session_args=(--resume "$resume_session_id")
  [[ -n "$reasoning_effort" ]] && effort_args=(--effort "$reasoning_effort")

  git_read_paths_json=$(git_global_read_paths)

  # Background Bash calls can outlive the command timeout, so disable them too.
  jq -n \
    --arg repo "$repo_root" \
    --arg scratch "$reviewer_dir/scratch" \
    --arg home "$HOME" \
    --arg checkout_root "$HOME/ghq" \
    --argjson git_read_paths "$git_read_paths_json" \
    '[$home + "/.ssh", $home + "/.aws", $home + "/.gnupg"] as $secrets
     | {
         env: {
           BASH_DEFAULT_TIMEOUT_MS: "30000",
           BASH_MAX_TIMEOUT_MS: "30000",
           CLAUDE_CODE_DISABLE_BACKGROUND_TASKS: "1"
         },
         permissions: {
           deny: ($secrets | map("Read(//\(.)/**)")),
           additionalDirectories: [$scratch]
         },
         sandbox: {
           enabled: true,
           network: { allowedDomains: [], strictAllowlist: true },
           filesystem: {
             denyWrite: [$repo],
             allowWrite: [$scratch],
             denyRead: ($secrets + [$checkout_root]),
             allowRead: ([$repo] + $git_read_paths)
           }
         }
       }' > "$reviewer_dir/settings.json"

  claude \
    --print \
    "${session_args[@]+"${session_args[@]}"}" \
    --restricted \
    --safe-mode \
    --strict-mcp-config \
    "${model_args[@]+"${model_args[@]}"}" \
    "${effort_args[@]+"${effort_args[@]}"}" \
    --tools Bash,Read,Grep,Glob \
    --settings "$reviewer_dir/settings.json" \
    --output-format json \
    --json-schema "$(jq -c 'del(."$schema")' "$schema_file")" \
    < "$reviewer_dir/prompt.txt" > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log" || status=$?
  printf '%s\n' "$status" > "$reviewer_dir/backend-exit-code"
  if [[ "$status" -ne 0 ]]; then
    # Claude reports errors such as "Prompt is too long" only in its stdout JSON.
    jq -rR 'fromjson? | select(.is_error? == true) | .result' "$reviewer_dir/stdout.log" >> "$reviewer_dir/stderr.log"
    return "$status"
  fi
  if ! jq -e '.subtype == "success" and .is_error != true' "$reviewer_dir/stdout.log" > /dev/null; then
    jq -rR 'fromjson? | select(.is_error? == true) | .result' "$reviewer_dir/stdout.log" >> "$reviewer_dir/stderr.log"
    return 1
  fi
  jq '.structured_output' "$reviewer_dir/stdout.log" > "$reviewer_dir/result.json"
  if [[ "$persist_session" == true ]]; then
    session_id=$(jq -er '.session_id | strings | select(length > 0)' "$reviewer_dir/stdout.log") || return 1
    [[ -z "$resume_session_id" || "$session_id" == "$resume_session_id" ]] || return 1
    printf '%s\n' "$session_id" > "$reviewer_dir/session-id"
  fi
}
