#!/bin/bash
# shellcheck disable=SC2154 # Callers initialize the shared config paths.

load_review_config() {
  local requested_file="$1" work_dir="$2" base_dir role overlay_file status

  for command in dot jq yq; do
    command -v "$command" > /dev/null || {
      echo "Error: required command not found: $command" >&2
      return 127
    }
  done

  [[ -f "$requested_file" ]] || {
    echo "Error: reviewer config not found: $requested_file" >&2
    return 1
  }

  base_dir=$(cd "$(dirname "$requested_file")" && pwd -P)
  review_config_base_file="$base_dir/$(basename "$requested_file")"
  review_config_overlay_file=
  role=$(dot role get) || {
    echo "Error: unable to resolve the dotfiles role." >&2
    return 1
  }

  case "$role" in
    private | work)
      if overlay_file=$(dot role overlay "$review_config_base_file" 2> "$work_dir/overlay-error"); then
        review_config_overlay_file="$overlay_file"
      else
        status=$?
        if [[ "$status" -ne 1 ]]; then
          cat "$work_dir/overlay-error" >&2
          echo "Error: unable to resolve the reviewer config overlay." >&2
          return 1
        fi
        if [[ -s "$work_dir/overlay-error" ]]; then
          cat "$work_dir/overlay-error" >&2
        fi
      fi
      ;;
    *)
      echo "Error: unsupported dotfiles role: $role" >&2
      return 1
      ;;
  esac

  if [[ -n "$review_config_overlay_file" && ! -f "$review_config_overlay_file" ]]; then
    echo "Error: reviewer config overlay is not a file: $review_config_overlay_file" >&2
    return 1
  fi

  review_config_file="$work_dir/reviewers.yaml"
  if [[ -n "$review_config_overlay_file" ]]; then
    yq eval-all 'select(fileIndex == 0) * select(fileIndex == 1)' \
      "$review_config_base_file" "$review_config_overlay_file" > "$review_config_file"
  else
    cp "$review_config_base_file" "$review_config_file"
  fi

  review_config_json_file="$work_dir/reviewers.json"
  yq -o=json '.' "$review_config_file" > "$review_config_json_file"
  review_config_overlay_json_file=
  if [[ -n "$review_config_overlay_file" ]]; then
    review_config_overlay_json_file="$work_dir/reviewers-overlay.json"
    yq -o=json '.' "$review_config_overlay_file" > "$review_config_overlay_json_file"
  fi
  review_armyknife_snapshot_file="$work_dir/armyknife-agent.json"
}

review_config_source_for() {
  local path_json="$1" source_file path_label
  path_label=$(jq -r 'map("[" + tojson + "]") | join("")' <<< "$path_json")
  source_file="$review_config_base_file"
  if [[ -n "$review_config_overlay_json_file" ]] &&
    jq -e --argjson path "$path_json" 'getpath($path) != null' "$review_config_overlay_json_file" > /dev/null; then
    source_file="$review_config_overlay_file"
  fi
  printf '%s#%s' "$source_file" "$path_label"
}

review_config_pick_agent() {
  local use="$1" reviewer="$2"
  jq -c --arg use "$use" --arg reviewer "$reviewer" '
    [
      (if $reviewer == "" then empty else {value: .reviewers[$reviewer].agent, path: ["reviewers", $reviewer, "agent"]} end),
      {value: .uses[$use].agent, path: ["uses", $use, "agent"]},
      {value: .default_agent, path: ["default_agent"]}
    ]
    | map(select(.value != null))
    | (.[0] // {value: null, path: null})
  ' "$review_config_json_file"
}

review_config_pick_setting() {
  local use="$1" reviewer="$2" agent="$3" setting="$4"
  jq -c \
    --arg use "$use" \
    --arg reviewer "$reviewer" \
    --arg agent "$agent" \
    --arg setting "$setting" '
      [
        (if $reviewer == "" then empty else {value: .reviewers[$reviewer].agents[$agent][$setting], path: ["reviewers", $reviewer, "agents", $agent, $setting]} end),
        {value: .uses[$use].agents[$agent][$setting], path: ["uses", $use, "agents", $agent, $setting]},
        {value: .agents[$agent][$setting], path: ["agents", $agent, $setting]}
      ]
      | map(select(.value != null))
      | (.[0] // {value: null, path: null})
    ' "$review_config_json_file"
}

review_config_validate_string() {
  local candidate="$1" label="$2"
  jq -e '(.value | type == "string" and test("\\S"))' <<< "$candidate" > /dev/null || {
    echo "Error: $label must be a non-empty string in reviewer config." >&2
    return 1
  }
}

review_config_reference_source() {
  local source="$1" profile="$2" type="$3" setting="${4:-}"
  if [[ -n "$setting" ]]; then
    printf '%s (armyknife profile %s, type %s, field %s)' "$source" "$profile" "$type" "$setting"
  else
    printf '%s (armyknife profile %s, type %s)' "$source" "$profile" "$type"
  fi
}

review_config_validate_value_string() {
  local value="$1" label="$2" source="$3"
  jq -e 'type == "string" and test("\\S")' <<< "$value" > /dev/null || {
    echo "Error: $label must be a non-empty string at $source." >&2
    return 1
  }
}

review_config_load_armyknife_snapshot() {
  local source="$1" snapshot_yaml="$work_dir/armyknife-agent.yaml"
  local snapshot_json="$review_armyknife_snapshot_file.tmp"

  # select-reviewers uses command substitution for this resolver, so a variable would not cache the snapshot across calls.
  [[ -f "$review_armyknife_snapshot_file" ]] && return 0

  command -v a > /dev/null || {
    echo "Error: required command not found: a (referenced at $source)." >&2
    return 127
  }
  if ! a config get agent > "$snapshot_yaml" 2> "$work_dir/armyknife-error"; then
    cat "$work_dir/armyknife-error" >&2
    echo "Error: unable to read the armyknife agent config referenced at $source." >&2
    return 1
  fi
  if ! yq -o=json '.' "$snapshot_yaml" > "$snapshot_json"; then
    echo "Error: unable to parse the armyknife agent config referenced at $source." >&2
    return 1
  fi
  if ! jq -e 'type == "object" and (.active_profile | type == "string" and test("\\S")) and (.profiles | type == "object")' \
    "$snapshot_json" > /dev/null; then
    echo "Error: armyknife agent config must contain active_profile and profiles at $source." >&2
    return 1
  fi

  mv "$snapshot_json" "$review_armyknife_snapshot_file"
}

review_config_reject_reference_direct_settings() {
  local use="$1" reviewer="$2" agent="$3" reference_source="$4"
  local setting candidate setting_path setting_source

  for setting in model reasoning_effort; do
    candidate=$(review_config_pick_setting "$use" "$reviewer" "$agent" "$setting")
    if [[ $(jq -r '.value != null' <<< "$candidate") == true ]]; then
      setting_path=$(jq -c '.path' <<< "$candidate")
      setting_source=$(review_config_source_for "$setting_path")
      # The base haiku is a fallback for legacy draft configs, not a profile override.
      if [[ "$use" == review_draft && "$agent" == claude && "$setting" == model &&
        "$setting_path" == '["uses","review_draft","agents","claude","model"]' &&
        "$setting_source" == "$review_config_base_file#"* ]]; then
        continue
      fi
      echo "Error: armyknife profile reference at $reference_source conflicts with direct $setting setting at $setting_source." >&2
      return 1
    fi
  done
}

review_config_resolve_armyknife_reference() {
  local agent_candidate="$1" agent_path agent_source reference_path reference_type
  local profile_name profile_candidate reference_source

  agent_path=$(jq -c '.path' <<< "$agent_candidate")
  agent_source=$(review_config_source_for "$agent_path")
  if ! jq -e '.value | type == "object" and has("reference")' <<< "$agent_candidate" > /dev/null; then
    echo "Error: invalid agent config shape at $agent_source; expected an engine string or reference.armyknife." >&2
    return 1
  fi
  if ! jq -e '.value | keys == ["reference"]' <<< "$agent_candidate" > /dev/null; then
    echo "Error: agent config mixes a reference with direct settings at $agent_source." >&2
    return 1
  fi
  if ! jq -e '.value.reference | type == "object"' <<< "$agent_candidate" > /dev/null; then
    echo "Error: invalid agent reference shape at $agent_source; expected reference.armyknife." >&2
    return 1
  fi
  if ! jq -e '.value.reference | keys == ["armyknife"]' <<< "$agent_candidate" > /dev/null; then
    if [[ $(jq -r '.value.reference | length' <<< "$agent_candidate") -eq 0 ]]; then
      echo "Error: empty agent reference at $agent_source." >&2
      return 1
    fi
    if ! jq -e '.value.reference | has("armyknife")' <<< "$agent_candidate" > /dev/null; then
      echo "Error: unsupported agent reference provider at $agent_source; expected armyknife." >&2
      return 1
    fi
    echo "Error: invalid agent reference shape at $agent_source; only armyknife is supported." >&2
    return 1
  fi

  if ! jq -e '.value.reference.armyknife | type == "string"' <<< "$agent_candidate" > /dev/null; then
    echo "Error: invalid armyknife agent reference shape at $agent_source; expected a string path." >&2
    return 1
  fi
  reference_path=$(jq -r '.value.reference.armyknife' <<< "$agent_candidate")
  if [[ ! "$reference_path" =~ [^[:space:]] ]]; then
    echo "Error: empty armyknife agent reference at $agent_source." >&2
    return 1
  fi
  if [[ "$reference_path" != agent.profile.* ]]; then
    echo "Error: invalid armyknife agent reference at $agent_source; expected agent.profile.<type>." >&2
    return 1
  fi
  reference_type="${reference_path#agent.profile.}"
  if [[ -z "$reference_type" || "$reference_type" == *.* || "$reference_type" =~ [[:space:]] ]]; then
    echo "Error: invalid armyknife agent reference at $agent_source; expected agent.profile.<type>." >&2
    return 1
  fi

  review_config_load_armyknife_snapshot "$agent_source" || return $?
  profile_name=$(jq -r '.active_profile' "$review_armyknife_snapshot_file")
  profile_candidate=$(jq -c --arg profile "$profile_name" --arg type "$reference_type" \
    '.profiles[$profile][$type] // null' "$review_armyknife_snapshot_file")
  if [[ "$profile_candidate" == null ]]; then
    echo "Error: armyknife profile type not found: agent.profile.$reference_type (profile $profile_name) at $agent_source." >&2
    return 1
  fi
  if [[ $(jq -r 'type' <<< "$profile_candidate") != object ]]; then
    echo "Error: invalid armyknife profile type shape: agent.profile.$reference_type (profile $profile_name) at $agent_source." >&2
    return 1
  fi
  if ! jq -e '.engine | type == "string" and test("\\S")' <<< "$profile_candidate" > /dev/null; then
    echo "Error: armyknife profile type must contain a non-empty engine: agent.profile.$reference_type (profile $profile_name) at $agent_source." >&2
    return 1
  fi

  reference_source=$(review_config_reference_source "$agent_source" "$profile_name" "$reference_type")
  jq -cn \
    --arg type "$reference_type" \
    --arg profile_name "$profile_name" \
    --arg source "$reference_source" \
    --arg origin_source "$agent_source" \
    --argjson config "$profile_candidate" \
    '{type: $type, profile_name: $profile_name, source: $source, origin_source: $origin_source, config: $config}'
}

resolve_review_engine() {
  local use="$1" reviewer="${2:-}" agent_override="${3:-}"
  local agent_candidate configured_agent agent_path agent_source effective_agent
  local model_candidate effort_candidate model_value effort_value model_source effort_source
  local config_overlay agent_value_type reference_type profile_name profile_candidate
  local reference_config reference_source reference_origin_source reference_model reference_effort

  [[ -n "$use" ]] || {
    echo "Error: review config use is required." >&2
    return 2
  }

  if [[ -n "$reviewer" ]] && ! jq -e --arg reviewer "$reviewer" '.reviewers[$reviewer] | type == "object"' "$review_config_json_file" > /dev/null; then
    echo "Error: reviewer not found in config: $reviewer" >&2
    return 1
  fi

  agent_candidate=$(review_config_pick_agent "$use" "$reviewer")
  if [[ $(jq -r '.path == null' <<< "$agent_candidate") == true ]]; then
    review_config_validate_string "$agent_candidate" "engine" || return 1
  fi
  agent_path=$(jq -c '.path' <<< "$agent_candidate")
  agent_source=$(review_config_source_for "$agent_path")

  agent_value_type=$(jq -r '.value | type' <<< "$agent_candidate")
  reference_type=
  profile_name=
  profile_candidate=
  reference_source=
  case "$agent_value_type" in
    string)
      review_config_validate_string "$agent_candidate" "engine" || return 1
      configured_agent=$(jq -r '.value' <<< "$agent_candidate")
      ;;
    object)
      reference_config=$(review_config_resolve_armyknife_reference "$agent_candidate") || return $?
      reference_type=$(jq -r '.type' <<< "$reference_config")
      profile_name=$(jq -r '.profile_name' <<< "$reference_config")
      reference_source=$(jq -r '.source' <<< "$reference_config")
      reference_origin_source=$(jq -r '.origin_source' <<< "$reference_config")
      profile_candidate=$(jq -c '.config' <<< "$reference_config")
      configured_agent=$(jq -r '.engine' <<< "$profile_candidate")
      agent_source="$reference_source"
      ;;
    *)
      echo "Error: invalid agent config shape at $agent_source; expected an engine string or reference.armyknife." >&2
      return 1
      ;;
  esac

  case "$configured_agent" in
    claude | codex | agy) ;;
    *)
      echo "Error: unsupported reviewer engine: $configured_agent at $agent_source." >&2
      return 1
      ;;
  esac

  effective_agent="${agent_override:-$configured_agent}"
  case "$effective_agent" in
    claude | codex | agy) ;;
    *)
      echo "Error: unsupported reviewer engine: $effective_agent" >&2
      return 1
      ;;
  esac

  if [[ -n "$reference_type" && "$effective_agent" == "$configured_agent" ]]; then
    review_config_reject_reference_direct_settings "$use" "$reviewer" "$configured_agent" "$agent_source" || return 1
    if jq -e 'has("model")' <<< "$profile_candidate" > /dev/null; then
      reference_model=$(jq -c '.model' <<< "$profile_candidate")
      review_config_validate_value_string "$reference_model" "armyknife profile model" "$agent_source" || return 1
    else
      reference_model=null
    fi
    if jq -e 'has("reasoning_effort")' <<< "$profile_candidate" > /dev/null; then
      reference_effort=$(jq -c '.reasoning_effort' <<< "$profile_candidate")
      review_config_validate_value_string "$reference_effort" "armyknife profile reasoning_effort" "$agent_source" || return 1
    else
      reference_effort=null
    fi
    model_value="$reference_model"
    effort_value="$reference_effort"
    model_source=$(review_config_reference_source "$reference_origin_source" "$profile_name" "$reference_type" model)
    effort_source=$(review_config_reference_source "$reference_origin_source" "$profile_name" "$reference_type" reasoning_effort)
    if [[ "$model_value" == null ]]; then
      model_source="$model_source (${effective_agent} CLI default)"
    fi
    if [[ "$effort_value" == null ]]; then
      effort_source="$effort_source (${effective_agent} CLI default)"
    fi
  else
    model_candidate=$(review_config_pick_setting "$use" "$reviewer" "$effective_agent" model)
    effort_candidate=$(review_config_pick_setting "$use" "$reviewer" "$effective_agent" reasoning_effort)
    if [[ $(jq -r '.value == null' <<< "$model_candidate") == false ]]; then
      review_config_validate_string "$model_candidate" "model" || return 1
      model_source=$(review_config_source_for "$(jq -c '.path' <<< "$model_candidate")")
    else
      model_source="$effective_agent CLI default"
    fi
    if [[ $(jq -r '.value == null' <<< "$effort_candidate") == false ]]; then
      review_config_validate_string "$effort_candidate" "reasoning_effort" || return 1
      effort_source=$(review_config_source_for "$(jq -c '.path' <<< "$effort_candidate")")
    else
      effort_source="$effective_agent CLI default"
    fi
    model_value=$(jq -c '.value // null' <<< "$model_candidate")
    effort_value=$(jq -c '.value // null' <<< "$effort_candidate")
    if [[ -n "$reference_type" ]]; then
      model_source="$reference_source; $model_source"
      effort_source="$reference_source; $effort_source"
    fi
  fi

  if [[ "$use" == review_draft && -n "$reference_type" ]]; then
    case "$effective_agent" in
      claude) ;;
      codex)
        if [[ "$model_value" == null ]]; then
          echo "Error: Codex draft review requires a model at $agent_source." >&2
          return 1
        fi
        ;;
      *)
        echo "Error: draft review does not support the armyknife profile engine $effective_agent at $agent_source." >&2
        return 1
        ;;
    esac
  fi

  config_overlay=null
  [[ -z "$review_config_overlay_file" ]] || config_overlay=$(jq -Rn --arg path "$review_config_overlay_file" '$path')

  jq -cn \
    --arg configured_agent "$configured_agent" \
    --arg agent "$effective_agent" \
    --argjson model "$model_value" \
    --argjson reasoning_effort "$effort_value" \
    --arg config_base "$review_config_base_file" \
    --argjson config_overlay "$config_overlay" \
    --arg agent_source "$agent_source" \
    --arg model_source "$model_source" \
    --arg effort_source "$effort_source" \
    '{
      configured_agent: $configured_agent,
      agent: $agent,
      model: $model,
      reasoning_effort: $reasoning_effort,
      config: {base: $config_base, overlay: $config_overlay},
      sources: {agent: $agent_source, model: $model_source, reasoning_effort: $effort_source}
    }'
}
