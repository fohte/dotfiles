#!/bin/bash
# Assemble immutable review inputs before invoking an external agent so model
# behavior cannot change reviewer selection, reference loading, or the
# reviewed diff. Only the exec/parse step in run_<agent> differs by agent.
set -euo pipefail

usage() {
  echo "Usage: run-external-reviewers <manifest-file> [reviewer...]" >&2
  exit 2
}

[ "$#" -ge 1 ] || usage
manifest_file="$1"
shift
review_scope=all
[[ "$#" -eq 0 ]] || review_scope=selected

[[ -f "$manifest_file" ]] || {
  echo "Error: manifest file not found: $manifest_file" >&2
  exit 2
}

# jq is checked on its own because reading the manifest below already needs it.
command -v jq > /dev/null || {
  echo "Error: required command not found: jq" >&2
  exit 127
}

manifest_status=$(jq -r '.status // "ready"' "$manifest_file")
if [[ "$manifest_status" == skipped ]]; then
  echo '[]'
  echo "Review skipped: no unreviewed changes remain." >&2
  exit 0
fi
[[ "$manifest_status" == ready ]] || {
  echo "Error: unsupported manifest status: $manifest_status" >&2
  exit 2
}

jq -e '
  (.reviewers | type == "array" and length > 0) and
  ([.reviewers[].name] | unique | length) == (.reviewers | length) and
  all(.reviewers[];
    (.name | type == "string" and length > 0) and
    (.configured_agent == "claude" or .configured_agent == "codex" or .configured_agent == "agy") and
    (.agent == "claude" or .agent == "codex" or .agent == "agy") and
    (.model == null or (.model | type == "string" and length > 0)) and
    (.reasoning_effort == null or (.reasoning_effort | type == "string" and length > 0)) and
    (.config.config.base | type == "string" and length > 0) and
    (.config.config.overlay == null or (.config.config.overlay | type == "string" and length > 0)) and
    (.config.configured_agent == .configured_agent) and
    (.config.agent == .agent) and
    (.config.model == .model) and
    (.config.reasoning_effort == .reasoning_effort) and
    (.config.sources.agent | type == "string" and length > 0) and
    (.config.sources.model | type == "string" and length > 0) and
    (.config.sources.reasoning_effort | type == "string" and length > 0)
  )
' "$manifest_file" > /dev/null || {
  echo "Error: manifest has missing or invalid reviewer configuration." >&2
  exit 2
}

# Reject an unknown agent, or one whose executable is missing, before any
# reviewer is spawned; the dispatch below would otherwise surface it as N
# background reviewers that simply failed.
agents=()
while IFS= read -r agent; do
  agents+=("$agent")
done < <(jq -r '[.reviewers[].agent] | unique[]' "$manifest_file")

for agent in "${agents[@]+"${agents[@]}"}"; do
  case "$agent" in
    codex | agy | claude) ;;
    *)
      echo "Error: unsupported agent: $agent" >&2
      exit 2
      ;;
  esac
done

for command in git "${agents[@]+"${agents[@]}"}"; do
  command -v "$command" > /dev/null || {
    echo "Error: required command not found: $command" >&2
    exit 127
  }
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
skill_dir=$(cd "$script_dir/.." && pwd -P)
claude_dir=$(cd "$skill_dir/../.." && pwd -P)
repo_root=$(git rev-parse --show-toplevel)
# shellcheck disable=SC2034 # Used by review-backends.
schema_file="$skill_dir/review-output-schema.json"
evaluation_ids_file="$skill_dir/reviewer-evaluation-ids.json"
usage_file="${XDG_CACHE_HOME:-$HOME/.cache}/self-review/codex-usage.json"
auth_file="$HOME/.codex/auth.json"
shared_codex_home="${XDG_CACHE_HOME:-$HOME/.cache}/self-review/codex-home"

# shellcheck disable=SC1091 # The helper path is resolved relative to this script at runtime.
source "$script_dir/review-diagnostics"
# shellcheck source=config/claude/skills/self-review/scripts/review-prompt
source "$script_dir/review-prompt"

work_dir=$(mktemp -d -t self-review-external.XXXXXX)
# Exit 1 is reserved for "findings exist"; a `set -e` abort (cp, mkdir, sed, ...)
# also exits 1, so any other 1 is remapped to the failure status.
findings_reported=false
on_exit() {
  local status=$?
  rm -rf "$work_dir"
  diagnostics_finish
  [[ "$status" -eq 1 && "$findings_reported" != true ]] && status=3
  exit "$status"
}
trap on_exit EXIT
diagnostics_prepare || exit 3

jq -e '
  type == "object" and
  (keys == ["behavior", "convention", "structure", "test-philosophy"]) and
  all(to_entries[];
    (.key | type == "string" and length > 0) and
    (.value | type == "array" and length > 0 and
      (unique | length) == length and
      all(.[]; type == "string" and test("\\S"))
    )
  )
' "$evaluation_ids_file" > /dev/null || {
  echo "Error: reviewer evaluation ID contract is invalid." >&2
  exit 3
}

resolved_range=$(jq -r '.range' "$manifest_file")
diff_args=("$resolved_range")

manifest_repo_root=$(jq -r '.repo_root // empty' "$manifest_file")
[[ "$manifest_repo_root" == "$repo_root" ]] || {
  echo "Error: manifest belongs to another repository: ${manifest_repo_root:-<missing>} (current: $repo_root)" >&2
  echo "Re-run select-reviewers for this repository and pass its manifest path." >&2
  exit 2
}

# The caller passes in the manifest it already resolved via select-reviewers,
# instead of this script invoking select-reviewers again: a second,
# independent resolution could see a different staged snapshot or a Codex
# usage-limit fallback that flips between the two calls, silently dropping a
# reviewer the caller already committed to (no error, no fallback_reason —
# it just never runs on any backend).
diff_file="$work_dir/diff.patch"
files_file="$work_dir/files.txt"
if [[ "$resolved_range" == --cached ]]; then
  source_index=${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}
  cp "$source_index" "$work_dir/index"
  export GIT_INDEX_FILE="$work_dir/index"
  git diff --no-ext-diff --irreversible-delete "${diff_args[@]}" > "$diff_file"
  git diff --name-only --no-ext-diff "${diff_args[@]}" > "$files_file"
else
  jq -er '.diff' "$manifest_file" > "$diff_file"
  jq -er '.files[]' "$manifest_file" > "$files_file"
fi

[ -s "$diff_file" ] || {
  echo "Error: review diff is empty." >&2
  exit 2
}

patch_sha256=$(diagnostics_sha256_file "$diff_file") || {
  echo "Error: unable to hash the review patch for diagnostics." >&2
  exit 3
}

selected=()
while IFS= read -r reviewer; do
  selected+=("$reviewer")
done < <(jq -r '.reviewers[].name' "$manifest_file")

if [ "${#selected[@]}" -eq 0 ]; then
  echo '[]'
  exit 0
fi

if [ "$#" -gt 0 ]; then
  for reviewer in "$@"; do
    case " ${selected[*]} " in
      *" $reviewer "*) ;;
      *)
        echo "Error: reviewer not in manifest: $reviewer" >&2
        exit 2
        ;;
    esac
  done
  # A name repeated on the command line would otherwise run that reviewer twice
  # over one reviewer_dir, and emit its result twice.
  selected=()
  while IFS= read -r reviewer; do
    selected+=("$reviewer")
  done < <(printf '%s\n' "$@" | LC_ALL=C sort -u)
fi

prepare_review_instructions "$repo_root" "$files_file" "$work_dir"

mkdir -p "$work_dir/targets"
for reviewer in "${selected[@]}"; do
  jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .targets[]' "$manifest_file" > "$work_dir/targets/$reviewer.txt"
done

# Snapshot the account limits so the next skill load can pick a backend without
# a network call. Every window is kept: each one blocks Codex on its own, and
# they expire at different times.
record_codex_usage() {
  local response snapshot
  command -v curl > /dev/null || return 0
  [[ -f "$auth_file" ]] || return 0
  response=$(curl --silent --show-error --max-time 20 \
    --header "Authorization: Bearer $(jq -r '.tokens.access_token' "$auth_file")" \
    --header "ChatGPT-Account-Id: $(jq -r '.tokens.account_id' "$auth_file")" \
    https://chatgpt.com/backend-api/wham/usage) || return 0
  snapshot=$(jq -ce '
    [.rate_limit.primary_window, .rate_limit.secondary_window]
    | map(select(. != null) | {used_percent, reset_at})
  ' <<< "$response") || return 0
  # Replace atomically so a concurrent review never reads a truncated snapshot
  # and mistakes it for "no limit recorded".
  mkdir -p "$(dirname "$usage_file")"
  printf '%s\n' "$snapshot" > "$usage_file.$$"
  mv "$usage_file.$$" "$usage_file"
}

# shellcheck disable=SC1091 # The helper path is resolved relative to this script at runtime.
source "$script_dir/review-backends"

# shellcheck disable=SC1091 # The helper path is resolved relative to this script at runtime.
source "$script_dir/review-sessions"
configure_review_sessions "$manifest_file"

for reviewer in "${selected[@]}"; do
  reviewer_agent=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .agent' "$manifest_file")
  if [[ "$reviewer_agent" == codex ]]; then
    "$script_dir/prune-expired-codex-rollouts" "$shared_codex_home"
    break
  fi
done

codex_used=false
pids=()
prompt_hashes=()
for reviewer in "${selected[@]}"; do
  reviewer_dir="$work_dir/$reviewer"
  mkdir -p "$reviewer_dir"
  reviewer_agent=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .agent' "$manifest_file")
  build_prompt "$reviewer" "$reviewer_dir/prompt.txt" "$reviewer_agent"
  if [[ "$reviewer_agent" == agy ]]; then
    prompt_sha256=$(diagnostics_sha256_agy_prompt "$reviewer_dir/prompt.txt")
  else
    prompt_sha256=$(diagnostics_sha256_file "$reviewer_dir/prompt.txt")
  fi
  prompt_hashes+=("$prompt_sha256")
  [[ "$reviewer_agent" == codex ]] && codex_used=true

  # select-reviewers resolved the effective settings into the manifest so retries
  # and resumed sessions use the same engine, model, effort, and config source.
  model=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .model // empty' "$manifest_file")
  model_json=$(jq -c --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .model' "$manifest_file")
  reasoning_effort=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .reasoning_effort // empty' "$manifest_file")
  reasoning_effort_json=$(jq -c --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .reasoning_effort' "$manifest_file")
  reviewer_config=$(jq -c --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | {config, configured_agent, agent, model, reasoning_effort, fallback_reason}' "$manifest_file")
  resume_session_id=$(review_session_id "$reviewer" "$reviewer_agent" "$model_json" "$reasoning_effort_json")

  printf 'Reviewer %s: engine=%s (configured=%s; source=%s), model=%s (source=%s), effort=%s (source=%s)\n' \
    "$reviewer" \
    "$reviewer_agent" \
    "$(jq -r '.configured_agent' <<< "$reviewer_config")" \
    "$(jq -r '.config.sources.agent' <<< "$reviewer_config")" \
    "${model:-CLI default}" \
    "$(jq -r '.config.sources.model' <<< "$reviewer_config")" \
    "${reasoning_effort:-CLI default}" \
    "$(jq -r '.config.sources.reasoning_effort' <<< "$reviewer_config")" >&2
  fallback_reason=$(jq -r '.fallback_reason // empty' <<< "$reviewer_config")
  [[ -z "$fallback_reason" ]] || printf 'Reviewer %s fallback: %s\n' "$reviewer" "$fallback_reason" >&2
  execution_mode=fresh
  [[ -z "$resume_session_id" ]] || execution_mode=resume
  [[ -z "$fallback_reason" ]] || execution_mode=fallback
  diagnostic_model="$model"
  [[ -n "$diagnostic_model" ]] || diagnostic_model='CLI default'
  diagnostic_reasoning_effort="$reasoning_effort"
  [[ -n "$diagnostic_reasoning_effort" ]] || diagnostic_reasoning_effort='CLI default'

  # None of the agents require a model: an unset one just means "use the CLI's
  # own default" (checked once here so run_codex/run_agy/run_claude don't
  # duplicate it). The `[@]+` guard matters because this script's shebang runs
  # under macOS's bundled /bin/bash (3.2, pre-dates GPLv3), whose `nounset`
  # treats expanding an empty array as an unbound-variable error.
  model_args=()
  # shellcheck disable=SC2034 # Used by review-backends.
  [[ -n "$model" ]] && model_args=(--model "$model")

  (
    cd "$repo_root"
    # shellcheck disable=SC2034 # Consumed by review-diagnostics.
    diagnostic_reviewer="$reviewer"
    diagnostic_scope="$review_scope"
    diagnostic_execution_mode="$execution_mode"
    diagnostic_engine="$reviewer_agent"
    diagnostic_patch_sha256="$patch_sha256"
    diagnostic_prompt_sha256="$prompt_sha256"
    printf '%s\n' "$execution_mode" > "$reviewer_dir/execution-mode"
    run_review_backend "$reviewer" "$reviewer_agent" "$reviewer_dir" "$reasoning_effort" "$resume_session_id"
  ) &
  pids+=("$!")
done

failed=false
backend_exit_codes=()
for index in "${!pids[@]}"; do
  if wait "${pids[$index]}"; then
    backend_exit_codes+=(0)
  else
    wait_status=$?
    backend_exit_codes+=("$wait_status")
    failed=true
  fi
done

if [[ -n "${SELF_REVIEW_RECOVERY_ATTEMPT_DIR:-}" ]]; then
  printf '%s\n' "$patch_sha256" > "$SELF_REVIEW_RECOVERY_ATTEMPT_DIR/patch-sha256"
  for index in "${!selected[@]}"; do
    reviewer="${selected[$index]}"
    printf '%s\n' "${prompt_hashes[$index]}" > "$SELF_REVIEW_RECOVERY_ATTEMPT_DIR/$reviewer.prompt-sha256"
    if [[ -f "$work_dir/$reviewer/session-id" ]]; then
      cp "$work_dir/$reviewer/session-id" "$SELF_REVIEW_RECOVERY_ATTEMPT_DIR/$reviewer.backend-session-id"
    fi
  done
fi

# Recorded on failure too: a run that dies on the usage limit is exactly the one
# whose snapshot must be refreshed, otherwise a stale reset_at sends every later
# review back to Codex while the limit still holds.
if [[ "$codex_used" == true ]]; then
  record_codex_usage || true
fi

# One reviewer failing must not discard the ones that succeeded: a retry re-runs
# only the reviewers named on the command line, so anything dropped here is lost
# for good if that retry fails too. The caller reads which reviewers are missing
# off the array and treats only those as unevaluated.
result_files=()
for index in "${!selected[@]}"; do
  reviewer="${selected[$index]}"
  reviewer_dir="$work_dir/$reviewer"
  result_file="$reviewer_dir/result.json"
  backend_exit_code="${backend_exit_codes[$index]}"
  expected_evaluation_ids=$(jq -c --arg reviewer "$reviewer" '.[$reviewer] // []' "$evaluation_ids_file")
  reviewer_agent=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .agent' "$manifest_file")
  reviewer_model=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .model // empty' "$manifest_file")
  reviewer_effort=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .reasoning_effort // empty' "$manifest_file")
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_reviewer="$reviewer"
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_scope="$review_scope"
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_engine="$reviewer_agent"
  diagnostic_model="$reviewer_model"
  [[ -n "$diagnostic_model" ]] || diagnostic_model='CLI default'
  diagnostic_reasoning_effort="$reviewer_effort"
  [[ -n "$diagnostic_reasoning_effort" ]] || diagnostic_reasoning_effort='CLI default'
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_patch_sha256="$patch_sha256"
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_prompt_sha256="${prompt_hashes[$index]}"
  # shellcheck disable=SC2034 # Consumed by review-diagnostics.
  diagnostic_execution_mode=$(cat "$reviewer_dir/execution-mode")

  if [[ -f "$result_file" ]]; then
    if ! validation_violations=$(diagnostics_validation_errors "$result_file" "$reviewer" "$expected_evaluation_ids"); then
      validation_violations='[{"reason_code":"validator_failed","field_path":"$"}]'
    fi
  else
    validation_violations='[{"reason_code":"result_missing","field_path":"$"}]'
  fi
  validation_failed=$(jq -r 'length > 0' <<< "$validation_violations")
  if [[ "$backend_exit_code" -eq 0 && "$validation_failed" == true && -f "$reviewer_dir/backend-exit-code" ]]; then
    backend_command_exit_code=$(cat "$reviewer_dir/backend-exit-code")
    if [[ "$backend_command_exit_code" =~ ^[0-9]+$ ]] && [[ "$backend_command_exit_code" -ne 0 ]]; then
      backend_exit_code="$backend_command_exit_code"
    fi
  fi
  if [[ "$backend_exit_code" -ne 0 ]]; then
    violations=$(jq -cn --argjson validation "$validation_violations" \
      '$validation + [{reason_code: "backend_failed", field_path: "$"}] | unique_by([.reason_code, .field_path])')
  else
    violations="$validation_violations"
  fi
  if [[ "$backend_exit_code" -ne 0 || "$validation_failed" == true ]]; then
    failed=true
    diagnostics_save_failure "$backend_exit_code" "$violations" || failed=true
    [[ "$backend_exit_code" -eq 0 ]] || echo "Error: reviewer backend failed: $reviewer (exit $backend_exit_code)." >&2
    [[ "$validation_failed" != true ]] || echo "Error: reviewer result rejected: $reviewer." >&2
  fi
  [[ "$backend_exit_code" -eq 0 && "$validation_failed" != true ]] || continue
  jq --argjson execution "$(jq -c --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | {configured_agent, agent, model, reasoning_effort, config, fallback_reason}' "$manifest_file")" \
    '. + {execution: $execution}' "$result_file" > "$work_dir/$reviewer/result.with-execution.json"
  mv "$work_dir/$reviewer/result.with-execution.json" "$result_file"
  result_files+=("$result_file")
done

if [ "${#result_files[@]}" -eq 0 ]; then
  echo '[]'
else
  jq -s '.' "${result_files[@]}"
fi

# A failure outranks findings: the caller has to retry before the findings it
# has are complete.
[[ "$failed" == false ]] || exit 3
if [ "${#result_files[@]}" -gt 0 ] && jq -se 'any(.[]; .findings != [])' "${result_files[@]}" > /dev/null; then
  findings_reported=true
fi

if ! save_review_sessions "$manifest_file" "$work_dir" "${selected[@]}"; then
  echo "Error: failed to save reviewer session state." >&2
  exit 3
fi

[[ "$findings_reported" != true ]] || exit 1
