#!/bin/bash
# Assemble immutable review inputs before invoking an external agent so model
# behavior cannot change reviewer selection, reference loading, or the
# reviewed diff. Only the exec/parse step in run_<agent> differs by agent.
set -euo pipefail

usage() {
  echo "Usage: run-external-reviewers <manifest-file> --agent <name>" >&2
  exit 2
}

[ "$#" -eq 3 ] || usage
manifest_file="$1"
[[ "$2" == --agent ]] || usage
agent_name="$3"

[[ -f "$manifest_file" ]] || {
  echo "Error: manifest file not found: $manifest_file" >&2
  exit 2
}

# Reject an unknown agent before any reviewer is spawned; the dispatch below
# would otherwise surface it as N background reviewers that simply failed.
case "$agent_name" in
  codex | agy | claude) ;;
  *)
    echo "Error: unsupported agent: $agent_name" >&2
    exit 2
    ;;
esac

for command in git jq "$agent_name"; do
  command -v "$command" > /dev/null || {
    echo "Error: required command not found: $command" >&2
    exit 127
  }
done

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
skill_dir=$(cd "$script_dir/.." && pwd -P)
claude_dir=$(cd "$skill_dir/../.." && pwd -P)
repo_root=$(git rev-parse --show-toplevel)
schema_file="$skill_dir/review-output-schema.json"
usage_file="${XDG_CACHE_HOME:-$HOME/.cache}/self-review/codex-usage.json"
auth_file="$HOME/.codex/auth.json"

work_dir=$(mktemp -d -t self-review-external.XXXXXX)
trap 'rm -rf "$work_dir"' EXIT

resolved_range=$(jq -r '.range' "$manifest_file")
diff_args=("$resolved_range")

# The caller passes in the manifest it already resolved via select-reviewers,
# instead of this script invoking select-reviewers again: a second,
# independent resolution could see a different staged snapshot or a Codex
# usage-limit fallback that flips between the two calls, silently dropping a
# reviewer the caller already committed to (no error, no fallback_reason —
# it just never runs on any backend).
if [[ "$resolved_range" == --cached ]]; then
  source_index=${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}
  cp "$source_index" "$work_dir/index"
  export GIT_INDEX_FILE="$work_dir/index"
fi

# select-reviewers already resolved agent + model from reviewers.yaml and its
# role overlay, so this script never reads reviewers.yaml directly.
model=$(jq -r --arg agent "$agent_name" '.agents[$agent].model // empty' "$manifest_file")
[[ "$agent_name" == codex ]] && model="${SELF_REVIEW_CODEX_MODEL:-$model}"

# Neither agent requires a model: an unset one just means "use the CLI's own
# default" (checked once here so run_codex/run_agy don't duplicate it). The
# `[@]+` guard matters because this script's shebang runs under macOS's
# bundled /bin/bash (3.2, pre-dates GPLv3), whose `nounset` treats expanding
# an empty array as an unbound-variable error.
model_args=()
[[ -n "$model" ]] && model_args=(--model "$model")

diff_file="$work_dir/diff.patch"
files_file="$work_dir/files.txt"
git diff --no-ext-diff "${diff_args[@]}" > "$diff_file"
git diff --name-only --no-ext-diff "${diff_args[@]}" > "$files_file"

[ -s "$diff_file" ] || {
  echo "Error: review diff is empty." >&2
  exit 2
}

selected=()
while IFS= read -r reviewer; do
  selected+=("$reviewer")
done < <(jq -r --arg agent "$agent_name" '.reviewers[] | select(.agent == $agent) | .name' "$manifest_file")

if [ "${#selected[@]}" -eq 0 ]; then
  echo '[]'
  exit 0
fi

# Only ancestor instructions apply to a changed file. Collecting them here
# prevents agent discovery behavior from changing the review contract.
while IFS= read -r file; do
  directory=$(dirname "$repo_root/$file")
  while [[ "$directory" == "$repo_root" || "$directory" == "$repo_root/"* ]]; do
    for instruction_name in AGENTS.md CLAUDE.md; do
      [[ -f "$directory/$instruction_name" ]] && printf '%s\n' "$directory/$instruction_name"
    done
    [[ "$directory" == "$repo_root" ]] && break
    directory=$(dirname "$directory")
  done
done < "$files_file" | LC_ALL=C sort -u > "$work_dir/instructions.txt"
instructions_file="$work_dir/instructions.txt"

mkdir -p "$work_dir/targets"
for reviewer in "${selected[@]}"; do
  jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .targets[]' "$manifest_file" > "$work_dir/targets/$reviewer.txt"
done

append_resource() {
  local output="$1" path="$2"
  {
    printf '\n<resource path="%s">\n' "$path"
    sed -n '1,$p' "$path"
    printf '\n</resource>\n'
  } >> "$output"
}

build_prompt() {
  local reviewer="$1" prompt_file="$2" definition relative instruction_file
  definition=$(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .definition' "$manifest_file")

  {
    printf '%s\n' 'Perform a read-only code review using only the supplied review contract and immutable diff.'
    printf 'Reviewer: %s\n' "$reviewer"
    printf '%s\n' 'Do not edit files. Repository inspection is allowed only to verify direct effects and precedents.'
    printf '%s\n' 'Return JSON matching the supplied output schema. Set reviewer to the exact reviewer name above.'
  } > "$prompt_file"

  append_resource "$prompt_file" "$claude_dir/agents/$definition.md"
  while IFS= read -r relative; do
    append_resource "$prompt_file" "$claude_dir/skills/$relative"
  done < <(jq -r --arg reviewer "$reviewer" '.reviewers[] | select(.name == $reviewer) | .references[]' "$manifest_file")

  while IFS= read -r instruction_file; do
    append_resource "$prompt_file" "$instruction_file"
  done < "$instructions_file"

  {
    if [[ -s "$work_dir/targets/$reviewer.txt" ]]; then
      printf '\n<review-targets>\n'
      sed -n '1,$p' "$work_dir/targets/$reviewer.txt"
      printf '</review-targets>\n'
    fi
    printf '\n<changed-files>\n'
    sed -n '1,$p' "$files_file"
    printf '</changed-files>\n\n<diff>\n'
    sed -n '1,$p' "$diff_file"
    printf '</diff>\n'
  } >> "$prompt_file"
}

# Snapshot the account limits so the next skill load can pick a backend without
# a network call. Every window is kept: each one blocks Codex on its own, and
# they expire at different times.
record_codex_usage() {
  local response snapshot
  command -v curl > /dev/null || return 0
  [[ -f "$auth_file" ]] || return 0
  response=$(curl --silent --show-error --max-time 20 \
    --header "Authorization: Bearer $(jq -r '.tokens.access_token' "$auth_file")" \
    --header "ChatGPT-Account-Id: $(jq -r '.tokens.account_id' "$auth_file")" \
    https://chatgpt.com/backend-api/wham/usage) || return 0
  snapshot=$(jq -ce '
    [.rate_limit.primary_window, .rate_limit.secondary_window]
    | map(select(. != null) | {used_percent, reset_at})
  ' <<< "$response") || return 0
  # Replace atomically so a concurrent review never reads a truncated snapshot
  # and mistakes it for "no limit recorded".
  mkdir -p "$(dirname "$usage_file")"
  printf '%s\n' "$snapshot" > "$usage_file.$$"
  mv "$usage_file.$$" "$usage_file"
}

run_codex() {
  local reviewer_dir="$1"
  codex exec \
    --ephemeral \
    "${model_args[@]+"${model_args[@]}"}" \
    --sandbox read-only \
    --output-schema "$schema_file" \
    --output-last-message "$reviewer_dir/result.json" \
    --color never \
    - < "$reviewer_dir/prompt.txt" > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log"
}

# agy has no stdin prompt mode: `--print` (and its `--prompt` alias) takes the
# prompt as the flag's own value, so it must be attached with `=` rather than
# left to consume the next argv token (verified against agy v1.1.18; a bare
# `--print` followed by another flag misparses that flag as the prompt). It
# also wraps the schema-checked result in `.structured_output` rather than
# writing it as the whole message, unlike `codex --output-schema`.
run_agy() {
  local reviewer_dir="$1"
  agy \
    --sandbox \
    --add-dir "$repo_root" \
    "${model_args[@]+"${model_args[@]}"}" \
    --output-format json \
    --json-schema "$schema_file" \
    --print="$(cat "$reviewer_dir/prompt.txt")" \
    > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log" || return 1
  jq -e '.status == "SUCCESS"' "$reviewer_dir/stdout.log" > /dev/null || return 1
  jq '.structured_output' "$reviewer_dir/stdout.log" > "$reviewer_dir/result.json"
}

# Restricting the tool set and enabling the sandbox are not two ways of saying
# the same thing: the sandbox governs Bash subprocesses only, so Write and Edit
# have to be dropped from the tool set, while `--tools` says nothing about what
# a shell command may touch. Either one alone leaves the repository writable.
#
# The sandbox likewise stops Bash from reading a secret but not the Read tool,
# which is why the same paths are denied twice. A permission rule needs the `//`
# prefix to mean an absolute path, so prefixing one produces three slashes; a
# plain `Read(/abs/path)` matches nothing and denies nothing.
#
# Writes are allowed under the reviewer's own scratch directory. Settling a
# doubt by running a minimal repro is part of the review, and it is per-reviewer
# so that parallel reviewers cannot overwrite each other's prompt or result.
#
# `--safe-mode` drops CLAUDE.md and skills, which is intended: build_prompt
# already inlines every instruction file that applies to the diff, so the review
# contract stays identical to the one codex and agy receive.
#
# `--json-schema` takes the schema inline and rejects a path, unlike
# `codex --output-schema` and `agy --json-schema`. It also cannot resolve the
# `$schema` meta-schema reference the other two accept, and fails the whole run
# on it, so that key is dropped on the way in rather than removed from the file.
run_claude() {
  local reviewer_dir="$1"
  mkdir -p "$reviewer_dir/scratch"
  jq -n \
    --arg repo "$repo_root" \
    --arg scratch "$reviewer_dir/scratch" \
    --arg home "$HOME" \
    '[$home + "/.ssh", $home + "/.aws", $home + "/.gnupg"] as $secrets
     | {
         permissions: { deny: ($secrets | map("Read(//\(.)/**)")) },
         sandbox: {
           enabled: true,
           network: { allowedDomains: [], strictAllowlist: true },
           filesystem: {
             denyWrite: [$repo],
             allowWrite: [$scratch],
             denyRead: $secrets
           }
         }
       }' > "$reviewer_dir/settings.json"

  claude \
    --print \
    --safe-mode \
    "${model_args[@]+"${model_args[@]}"}" \
    --tools Bash,Read,Grep,Glob \
    --settings "$reviewer_dir/settings.json" \
    --output-format json \
    --json-schema "$(jq -c 'del(."$schema")' "$schema_file")" \
    < "$reviewer_dir/prompt.txt" > "$reviewer_dir/stdout.log" 2> "$reviewer_dir/stderr.log" || return 1
  jq -e '.subtype == "success"' "$reviewer_dir/stdout.log" > /dev/null || return 1
  jq '.structured_output' "$reviewer_dir/stdout.log" > "$reviewer_dir/result.json"
}

pids=()
for reviewer in "${selected[@]}"; do
  reviewer_dir="$work_dir/$reviewer"
  mkdir -p "$reviewer_dir"
  build_prompt "$reviewer" "$reviewer_dir/prompt.txt"
  (
    cd "$repo_root"
    case "$agent_name" in
      codex) run_codex "$reviewer_dir" ;;
      agy) run_agy "$reviewer_dir" ;;
      claude) run_claude "$reviewer_dir" ;;
    esac
  ) &
  pids+=("$!")
done

failed=false
for index in "${!pids[@]}"; do
  if ! wait "${pids[$index]}"; then
    reviewer=${selected[$index]}
    echo "Error: reviewer failed: $reviewer" >&2
    sed -n '1,120p' "$work_dir/$reviewer/stderr.log" >&2
    failed=true
  fi
done

# Recorded on failure too: a run that dies on the usage limit is exactly the one
# whose snapshot must be refreshed, otherwise a stale reset_at sends every later
# review back to Codex while the limit still holds.
if [[ "$agent_name" == codex ]]; then
  record_codex_usage || true
fi

[[ "$failed" == false ]] || exit 1

result_files=()
for reviewer in "${selected[@]}"; do
  result_file="$work_dir/$reviewer/result.json"
  jq -e --arg reviewer "$reviewer" '.reviewer == $reviewer' "$result_file" > /dev/null || {
    echo "Error: invalid reviewer result: $reviewer" >&2
    exit 1
  }
  result_files+=("$result_file")
done

jq -s '.' "${result_files[@]}"
