#!/bin/bash
# Keep reviewer selection outside model instructions so both backends use the
# same trigger implementation and reviewer ordering.
set -euo pipefail

usage() {
  echo "Usage: select-reviewers --cached | <commit-range>" >&2
  exit 2
}

[ "$#" -eq 1 ] || usage

range_mode=
requested_base=
target=

for required_command in git jq yq dot; do
  command -v "$required_command" > /dev/null || {
    echo "Error: required command not found: $required_command" >&2
    exit 127
  }
done

case "$1" in
  --cached)
    range_mode=cached
    diff_args=(--cached)
    resolved_range=--cached
    ;;
  -* | *[[:space:]]*) usage ;;
  *...*)
    left=${1%%...*}
    right=${1#*...}
    [[ -n "$left" && -n "$right" ]] || usage
    left=$(git rev-parse --verify "$left^{commit}")
    right=$(git rev-parse --verify "$right^{commit}")
    range_mode=commit
    target="$right"
    requested_base=$(git merge-base "$left" "$right")
    resolved_range="$left...$right"
    ;;
  *..*)
    left=${1%%..*}
    right=${1#*..}
    [[ -n "$left" && -n "$right" ]] || usage
    left=$(git rev-parse --verify "$left^{commit}")
    right=$(git rev-parse --verify "$right^{commit}")
    range_mode=commit
    target="$right"
    requested_base="$left"
    resolved_range="$left..$right"
    ;;
  *)
    range_mode=commit
    target=$(git rev-parse --verify "$1^{commit}")
    requested_base=$(git rev-parse --verify "$target^" 2> /dev/null || true)
    resolved_range="$target"
    ;;
esac

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
skill_dir=$(cd "$script_dir/.." && pwd -P)
claude_dir=$(cd "$skill_dir/../.." && pwd -P)
reviewers_file="$skill_dir/reviewers.yaml"
repo_root=$(git rev-parse --show-toplevel)

work_dir=$(mktemp -d -t self-review-select.XXXXXX)
trap 'rm -rf "$work_dir"' EXIT

review_diff_for_commit() {
  local mode="$1" commit="$2" path="${3:-}" parent_count parent path_args=() diff_options=(--no-ext-diff --irreversible-delete)
  if [[ -n "$path" ]]; then
    path_args=(-- "$path")
  fi
  parent_count=$(git rev-list --parents -n 1 "$commit" | awk '{ print NF - 1 }')

  case "$parent_count" in
    0)
      git diff-tree --root --no-commit-id "${diff_options[@]}" "$mode" "$commit" "${path_args[@]+${path_args[@]}}"
      ;;
    1)
      parent=$(git rev-parse "$commit^1")
      git diff "${diff_options[@]}" "$mode" "$parent" "$commit" "${path_args[@]+${path_args[@]}}"
      ;;
    2)
      git show --remerge-diff --format= "${diff_options[@]}" "$mode" "$commit" "${path_args[@]+${path_args[@]}}"
      ;;
    *)
      echo "Error: unsupported merge commit with $parent_count parents: $commit" >&2
      return 2
      ;;
  esac
}

flush_review_segment() {
  [[ -n "$segment_start" ]] || return 0
  git diff --no-ext-diff --irreversible-delete "$segment_start" "$segment_end" >> "$diff_file"
  git diff --no-ext-diff --name-only "$segment_start" "$segment_end" >> "$files_file"
  printf 'range %s %s\n' "$segment_start" "$segment_end" >> "$review_units_file"
  segment_start=
  segment_end=
}

review_branch=
review_base="$requested_base"
review_head=
diff_file="$work_dir/diff.patch"
files_file="$work_dir/files.txt"
review_units_file="$work_dir/units.txt"
: > "$diff_file"
: > "$files_file"
: > "$review_units_file"

if [[ "$range_mode" == commit ]]; then
  review_head="$target"
  review_branch=$(git symbolic-ref --quiet --short HEAD || true)
  reviewed_head=
  previous_review_state='{}'

  if [[ -n "$review_branch" ]]; then
    state=$("$script_dir/review-state" read "$review_branch")
    recorded_head=$(jq -r '.head // empty' <<< "$state" 2> /dev/null || true)
    if [[ -n "$recorded_head" ]] && git cat-file -e "$recorded_head^{commit}" 2> /dev/null &&
      git merge-base --is-ancestor "$recorded_head" "$review_head"; then
      reviewed_head="$recorded_head"
      previous_review_state="$state"
    fi
  fi

  review_commits=()
  if [[ -n "$review_base" ]]; then
    while IFS= read -r commit; do
      [[ -n "$commit" ]] || continue
      if [[ -n "$reviewed_head" ]] && git merge-base --is-ancestor "$commit" "$reviewed_head"; then
        continue
      fi
      review_commits+=("$commit")
    done < <(git rev-list --first-parent --reverse "$review_base..$review_head")
  else
    while IFS= read -r commit; do
      [[ -n "$commit" ]] || continue
      if [[ -n "$reviewed_head" ]] && git merge-base --is-ancestor "$commit" "$reviewed_head"; then
        continue
      fi
      review_commits+=("$commit")
    done < <(git rev-list --first-parent --reverse "$review_head")
  fi

  segment_start=
  segment_end=
  for commit in "${review_commits[@]+${review_commits[@]}}"; do
    parent_count=$(git rev-list --parents -n 1 "$commit" | awk '{ print NF - 1 }')
    case "$parent_count" in
      0)
        flush_review_segment
        review_diff_for_commit -p "$commit" >> "$diff_file"
        review_diff_for_commit --name-only "$commit" >> "$files_file"
        printf 'commit %s\n' "$commit" >> "$review_units_file"
        ;;
      1)
        parent=$(git rev-parse "$commit^1")
        if [[ -n "$segment_end" && "$parent" != "$segment_end" ]]; then
          flush_review_segment
        fi
        if [[ -z "$segment_start" ]]; then
          segment_start="$parent"
        fi
        segment_end="$commit"
        ;;
      2)
        flush_review_segment
        review_diff_for_commit -p "$commit" >> "$diff_file"
        review_diff_for_commit --name-only "$commit" >> "$files_file"
        printf 'merge %s\n' "$commit" >> "$review_units_file"
        ;;
      *)
        echo "Error: unsupported merge commit with $parent_count parents: $commit" >&2
        exit 2
        ;;
    esac
  done
  flush_review_segment
  LC_ALL=C sort -u "$files_file" -o "$files_file"
else
  source_index=${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}
  cp "$source_index" "$work_dir/index"
  export GIT_INDEX_FILE="$work_dir/index"
  diff_args=(--cached)
  git diff --stat "${diff_args[@]}" > /dev/null
  if git diff --quiet --no-ext-diff "${diff_args[@]}"; then
    echo "Error: review diff is empty." >&2
    exit 2
  fi
  git diff --name-only --no-ext-diff "${diff_args[@]}" > "$files_file"
fi

if [[ "$range_mode" == commit && ! -s "$diff_file" ]]; then
  "$script_dir/review-state" write "$review_branch" "$review_head"
  jq -n \
    --arg range "$resolved_range" \
    --arg repo_root "$repo_root" \
    --arg review_branch "$review_branch" \
    --arg review_head "$review_head" \
    '{status: "skipped", reason: "no_unreviewed_changes", range: $range, repo_root: $repo_root, review_branch: $review_branch, review_head: $review_head}'
  exit 0
fi

# `dot role overlay` resolves the overlay file by role + filename, not by
# content, so a role overlay of this file can define its own `agent:` routing.
overlay_file=$(dot role overlay "$reviewers_file" 2> /dev/null || true)
if [[ -n "$overlay_file" ]]; then
  yq eval-all 'select(fileIndex==0) * select(fileIndex==1)' "$reviewers_file" "$overlay_file" > "$work_dir/reviewers.yaml"
  reviewers_file="$work_dir/reviewers.yaml"
fi

# The snapshot run-external-reviewers leaves behind after a Codex call stays
# authoritative until the window resets, so a limit check here never needs a
# network call, and the usage endpoint stays untouched for as long as the
# limit holds.
codex_usage_file="${XDG_CACHE_HOME:-$HOME/.cache}/self-review/codex-usage.json"
codex_over_limit() {
  [[ -f "$codex_usage_file" ]] || return 1
  jq -e \
    --argjson now "$(date +%s)" \
    'any(.[]; $now < .reset_at and .used_percent >= 100)' \
    "$codex_usage_file" > /dev/null
}

matches_trigger() {
  local reviewer="$1" targets_file="$2" kind pattern paths exclude case_insensitive file grep_options
  kind=$(yq -r ".reviewers.\"$reviewer\".trigger.kind // \"\"" "$reviewers_file")
  pattern=$(yq -r ".reviewers.\"$reviewer\".trigger.pattern // \"\"" "$reviewers_file")
  paths=$(yq -r ".reviewers.\"$reviewer\".trigger.paths // \"\"" "$reviewers_file")
  exclude=$(yq -r ".reviewers.\"$reviewer\".trigger.exclude // \"\"" "$reviewers_file")
  case_insensitive=$(yq -r ".reviewers.\"$reviewer\".trigger.case_insensitive // false" "$reviewers_file")

  if [[ "$case_insensitive" == true ]]; then
    shopt -s nocasematch
    grep_options=(-iE)
  else
    shopt -u nocasematch
    grep_options=(-E)
  fi

  case "$kind" in
    paths)
      while IFS= read -r file; do
        [[ -n "$exclude" && "$file" =~ $exclude ]] && continue
        [[ "$file" =~ $pattern ]] && printf '%s\n' "$file" >> "$targets_file"
      done < "$files_file"
      ;;
    added-lines)
      while IFS= read -r file; do
        [[ -n "$exclude" && "$file" =~ $exclude ]] && continue
        [[ -n "$paths" && ! "$file" =~ $paths ]] && continue
        if {
          if [[ "$range_mode" == cached ]]; then
            git diff --no-ext-diff "${diff_args[@]}" -- "$file"
          else
            while read -r unit_kind first second; do
              case "$unit_kind" in
                range) git diff --no-ext-diff "$first" "$second" -- "$file" ;;
                commit | merge) review_diff_for_commit -p "$first" "$file" ;;
              esac
            done < "$review_units_file"
          fi
        } |
          awk '/^\+\+\+ / { next } /^\+/ { sub(/^\+/, ""); print }' |
          grep "${grep_options[@]}" "$pattern" > /dev/null; then
          printf '%s\n' "$file" >> "$targets_file"
        fi
      done < "$files_file"
      ;;
    '') ;;
    *)
      echo "Error: unsupported trigger kind for $reviewer: $kind" >&2
      return 2
      ;;
  esac
  [[ -s "$targets_file" ]]
}

manifest="$work_dir/manifest.jsonl"
while IFS= read -r reviewer; do
  targets_file="$work_dir/$reviewer.targets"
  : > "$targets_file"
  selected=false
  if [[ $(yq -r ".reviewers.\"$reviewer\".always // false" "$reviewers_file") == true ]]; then
    selected=true
  elif matches_trigger "$reviewer" "$targets_file"; then
    selected=true
  else
    status=$?
    [[ "$status" -eq 1 ]] || exit "$status"
  fi
  if [[ "$selected" == true ]]; then
    definition=$(yq -r ".reviewers.\"$reviewer\".definition" "$reviewers_file")

    resolved_agent=$(yq -r ".reviewers.\"$reviewer\".agent // .default_agent" "$reviewers_file")
    fallback_reason=null
    if [[ "$resolved_agent" == codex ]] && codex_over_limit; then
      resolved_agent=claude
      fallback_reason='"Codex is over its usage limit, so this reviewer ran on the Claude backend instead."'
    fi

    references_file="$work_dir/$reviewer.references"
    : > "$references_file"
    while IFS= read -r relative; do
      matched=false
      while IFS= read -r reference_path; do
        [[ -f "$reference_path" ]] || continue
        printf '%s\n' "${reference_path#"$claude_dir/skills/"}" >> "$references_file"
        matched=true
      done < <(compgen -G "$claude_dir/skills/$relative" || true)
      [[ "$matched" == true ]] || {
        echo "Error: reviewer resource not found: $relative" >&2
        exit 1
      }
    done < <(yq -r ".reviewers.\"$reviewer\".references[]" "$reviewers_file")
    jq -n \
      --arg name "$reviewer" \
      --arg agent "$resolved_agent" \
      --arg definition "${definition%.md}" \
      --argjson fallback_reason "$fallback_reason" \
      --rawfile references "$references_file" \
      --rawfile targets "$targets_file" \
      '{name: $name, agent: $agent, definition: $definition, fallback_reason: $fallback_reason, references: ($references | split("\n") | map(select(length > 0))), targets: ($targets | split("\n") | map(select(length > 0)))}' >> "$manifest"
  fi
done < <(yq -r '.reviewers | to_entries[] | .key' "$reviewers_file")

agents_json=$(yq -o=json '.agents // {}' "$reviewers_file")
if [[ "$range_mode" == commit ]]; then
  previous_sessions=$(jq -c '.sessions // {}' <<< "$previous_review_state")
  previous_session_expires_at=$(jq -r '.session_expires_at // empty' <<< "$previous_review_state")
  jq -s \
    --arg range "$resolved_range" \
    --arg repo_root "$repo_root" \
    --arg review_branch "$review_branch" \
    --arg review_head "$review_head" \
    --arg previous_review_head "$reviewed_head" \
    --arg previous_session_expires_at "$previous_session_expires_at" \
    --argjson previous_sessions "$previous_sessions" \
    --argjson agents "$agents_json" \
    --rawfile diff "$diff_file" \
    --rawfile files "$files_file" \
    '{status: "ready", range: $range, repo_root: $repo_root, review_branch: $review_branch, review_head: $review_head, previous_review: (if $previous_review_head == "" then null else {head: $previous_review_head, session_expires_at: ($previous_session_expires_at | tonumber? // null), sessions: $previous_sessions} end), diff: $diff, files: ($files | split("\n") | map(select(length > 0))), agents: $agents, reviewers: .}' \
    "$manifest"
else
  jq -s --arg range "$resolved_range" --arg repo_root "$repo_root" --argjson agents "$agents_json" '{status: "ready", range: $range, repo_root: $repo_root, agents: $agents, reviewers: .}' "$manifest"
fi
