#!/usr/bin/env bash
set -uo pipefail

input=$(cat)
tool_name=$(jq -r '.tool_name // empty' <<< "$input")
if [[ "$tool_name" != "Bash" ]]; then
  exit 0
fi

deny_pre_tool_use() {
  jq -nc --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
}

if ! runok_output=$(printf '%s\n' "$input" | runok hook --agent codex); then
  deny_pre_tool_use "runok could not produce a hook response."
  exit 0
fi

if [[ -n "$runok_output" ]] && ! jq -e 'type == "object"' <<< "$runok_output" > /dev/null 2>&1; then
  deny_pre_tool_use "runok returned an invalid hook response."
  exit 0
fi

if [[ -n "$runok_output" ]]; then
  printf '%s\n' "$runok_output"
fi
