#!/usr/bin/env bash
# Idempotently register this repo's hooks in Codex's hooks.json:
# the PreToolUse guards (default-branch-edit-guard, ponytail-comment-guard,
# agent-guard, and the combined Bash runok/attribution proxy), the SessionStart
# context injection (all of `gen-claude-template context`, the same set Claude
# Code gets), and the tq session tracking hooks
# (SessionStart / Stop / SessionEnd), the armyknife session tracking hooks
# (`a agent hook`), and the Codex subagent completion handler.
#
# `runok init` checks for its exact command without checking the matcher. Keep
# an inactive PreToolUse entry so init does not register a competing handler.
set -euo pipefail

hooks_path="${1:?Usage: install-hooks <hooks.json path>}"

mkdir -p "$(dirname "$hooks_path")"

if [[ -s "$hooks_path" ]]; then
  content=$(cat "$hooks_path")
else
  content='{}'
fi

# tab-separated: event, matcher regex, command, [timeout seconds]
#
# Append-only: Codex trusts hooks by position (`source_path:event:group:handler`),
# so inserting before an existing entry would force re-approval of every hook
# after it. Add new entries at the end of this list.
#
# tq hooks: `--provider codex` is required because tq defaults to `claude_code`,
# which would record Codex sessions as Claude Code. `|| true` is needed because
# the config/bin/tq wrapper can exit non-zero (e.g. locked 1Password vault)
# before reaching the CLI's own never-fail guarantee.
entries=$'PreToolUse\t^apply_patch$\t~/.claude/hooks/default-branch-edit-guard
PreToolUse\t^apply_patch$\t~/.claude/hooks/ponytail-comment-guard
PreToolUse\t^spawn_agent$\t~/.claude/hooks/agent-guard
PreToolUse\t^Bash$\t~/.codex/codex-pre-tool-use-proxy
SessionStart\t.*\tgen-claude-template context
SessionStart\t.*\t~/.claude/hooks/tq-session-start --provider codex
Stop\t.*\ttq hook Stop --provider codex || true
SessionEnd\t.*\ttq hook SessionEnd --provider codex || true
SessionStart\t.*\ta agent hook session-start --engine codex
UserPromptSubmit\t.*\ta agent hook user-prompt-submit --engine codex
PostToolUse\t.*\ta agent hook post-tool-use --engine codex
PermissionRequest\t.*\ta agent hook permission-request --engine codex
Stop\t.*\ta agent hook stop --engine codex
SessionEnd\t.*\ta agent hook session-end --engine codex\t3
SubagentStop\t.*\ta agent codex-subagent-stop'

# Commands this script used to register. An already-deployed hooks.json still
# has them, and the append-only loop below would leave both old and new
# registered (duplicate SessionStart output).
legacy_commands=$'gen-claude-template context repo-language-rules'

# tab-separated: old command, new command. Rewritten in place instead of
# removed via legacy_commands, which would shift every later hook's position
# and force its re-approval.
replaced_commands=$'tq hook SessionStart --provider codex || true\t~/.claude/hooks/tq-session-start --provider codex'

# Retain every existing runok command under a matcher that matches no tool.
# Mixed groups keep their original matcher and unrelated handlers.
runok_pre_tool_use_command='runok hook --agent codex'
content=$(jq --arg runok "$runok_pre_tool_use_command" '
  def retain_runok_sentinel($groups; $runok):
    reduce $groups[] as $group
      ({groups: [], detached: [], found: false};
       ($group.hooks // []) as $handlers
       | [$handlers[] | select(.command == $runok)] as $runok_handlers
       | [$handlers[] | select(.command != $runok)] as $other_handlers
       | if ($runok_handlers | length) == 0 then
           .groups += [$group]
         elif ($other_handlers | length) == 0 then
           .groups += [($group | .matcher = "^$")]
           | .found = true
         else
           .groups += [($group | .hooks = $other_handlers)]
           | .detached += $runok_handlers
           | .found = true
         end)
    | if (.detached | length) > 0 then
        .groups += [{matcher: "^$", hooks: .detached}]
      else . end
    | if .found then .groups
      else .groups + [{matcher: "^$", hooks: [{type: "command", command: $runok}]}]
      end;
  .hooks = (.hooks // {})
  | .hooks.PreToolUse = retain_runok_sentinel((.hooks.PreToolUse // []); $runok)
' <<< "$content")

while IFS= read -r command; do
  content=$(jq --arg command "$command" '
    if .hooks then .hooks |= map_values(map(select(all(.hooks[]?; .command != $command)))) else . end
  ' <<< "$content")
done <<< "$legacy_commands"

while IFS=$'\t' read -r old new; do
  content=$(jq --arg old "$old" --arg new "$new" '
    if .hooks then .hooks |= map_values(map(.hooks |= map(if .command == $old then .command = $new else . end))) else . end
  ' <<< "$content")
done <<< "$replaced_commands"

while IFS=$'\t' read -r event matcher command timeout; do
  content=$(jq --arg event "$event" --arg matcher "$matcher" --arg command "$command" --arg timeout "$timeout" '
    (.hooks[$event] // []) as $arr
    | if ($arr | any(.hooks[]?.command == $command))
      then .
      else .hooks[$event] = ($arr + [{matcher: $matcher, hooks: [{type: "command", command: $command} + (if $timeout == "" then {} else {timeout: ($timeout | tonumber)} end)]}])
      end
  ' <<< "$content")
done <<< "$entries"

tmp="$(mktemp "${TMPDIR:-/tmp}/codex-hooks.XXXXXX")"
printf '%s\n' "$content" | jq . > "$tmp"
mv "$tmp" "$hooks_path"
