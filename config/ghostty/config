font-family = HackGen35 Console NF
font-size = 12

# Half-width glyphs look too wide without this
adjust-cell-width = -7%

# Base16 variant of Material Darker. The built-in "Material Darker" theme
# has different ANSI palette values (e.g. black=#000000 vs #212121).
theme = material-darker-base16

window-decoration = none
command = zsh -c tmux-attach

# Both Option keys act as Alt for tmux/neovim keybindings
macos-option-as-alt = true

# tmux handles tabs, splits, search and scrollback, so drop every default
# keybind and redefine only the few still needed. Unbound keys then reach
# tmux (e.g. alt+arrow for pane navigation).
keybind = clear
keybind = super+q=quit
keybind = super+shift+comma=reload_config
keybind = super+v=paste_from_clipboard
# terminal-browser zooms the page through the terminal's font size keybinds
keybind = super+equal=increase_font_size:1
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Send CSI u sequences for ctrl+number keys (tmux pane selection).
# unbind alone doesn't work because ctrl+number has no legacy escape sequence.
keybind = ctrl+one=csi:49;5u
keybind = ctrl+two=csi:50;5u
keybind = ctrl+three=csi:51;5u
keybind = ctrl+four=csi:52;5u
keybind = ctrl+five=csi:53;5u
keybind = ctrl+six=csi:54;5u
keybind = ctrl+seven=csi:55;5u
keybind = ctrl+eight=csi:56;5u
keybind = ctrl+nine=csi:57;5u

# terminal-browser zooms with ctrl+0 / ctrl+equal and crit submits comments
# with ctrl+enter; like ctrl+number, these lose ctrl in the legacy encoding.
keybind = ctrl+zero=csi:48;5u
keybind = ctrl+equal=csi:61;5u
keybind = ctrl+enter=csi:13;5u
# tmux cannot relay the super modifier, so reuse ctrl+enter for crit's
# cmd+enter submit.
keybind = super+enter=csi:13;5u
# Same for terminal-browser's cmd+[ / cmd+] back/forward, which it also
# accepts as ctrl+[ / ctrl+].
keybind = super+bracket_left=csi:91;5u
keybind = super+bracket_right=csi:93;5u
# Sent as ctrl+alt+<key> for tmux to turn back into cmd+<key> for
# terminal-browser (see tmux.conf).
keybind = super+a=csi:97;7u
keybind = super+c=csi:99;7u
# Handled by tmux itself: opens terminal-browser's page in the default browser.
keybind = super+o=csi:111;7u

# Prevent AquaSKK mode-switch keys (sent by Karabiner-Elements) from
# leaking into the terminal as literal characters.
keybind = ctrl+apostrophe=ignore
keybind = ctrl+j=ignore
