<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fohte.agent-watch-web-reloader</string>

  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.cargo/bin/a</string>
  </array>

  <key>ProgramArguments</key>
  <array>
    <string>__LAUNCHD_DIR__/run-with-log</string>
    <string>__HOME__/.local/state/agent-watch-web-reloader/reloader.log</string>
    <string>--</string>
    <string>__LAUNCHD_DIR__/agent-watch-web-reload</string>
  </array>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
