#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "usage: run-with-log <log-path> -- <command> [args...]" >&2
  exit 2
}

[[ $# -ge 3 && $2 == -- ]] || usage

log_file="$1"
shift 2
log_writer="${BASH_SOURCE[0]%/*}/write-log"

# The writer's umask applies only to log files, not to the service process.
# Keep the child as launchd's job process so signals reach it directly.
exec "$@" > >("$log_writer" "$log_file") 2>&1
