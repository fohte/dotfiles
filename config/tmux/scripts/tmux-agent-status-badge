#!/usr/bin/env bash
# Print a pane-border badge for the kind set by `a agent status set`.
# armyknife does not export it as a tmux option, so read its session file.
set -euo pipefail

file="$HOME/.cache/armyknife/cc/sessions/${1:-}.json"
[ -f "$file" ] || exit 0
# Kinds missing here fall back to the `you` colour, matching armyknife treating
# unconfigured kinds as user turns.
jq -r '
  .agent_status.kind // empty
  | ({wait: "bg=colour240,fg=colour231", done: "bg=colour141,fg=colour16"}[.] // "bg=colour220,fg=colour16") as $style
  | "#[push-default]#[\($style),bold] \(.) #[default]#[pop-default] "
' "$file"
