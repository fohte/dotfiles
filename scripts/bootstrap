#!/usr/bin/env bash
#
# Bootstrap the development environment.
#
# Usage:
#   scripts/bootstrap

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# The mise installer puts the binary here before shell activation is configured.
export PATH="$HOME/.local/bin:$PATH"

# Install tool versions managed by mise
if ! command -v mise > /dev/null 2>&1; then
  echo "error: mise is required. Install it from https://mise.jdx.dev/installing-mise.html" >&2
  exit 1
fi
# On WSL, install only the tools needed to render and deploy configuration.
# The full global tool list includes macOS-specific tools and native builds.
if grep -qi microsoft /proc/version 2>/dev/null; then
  mise install aqua:jqlang/jq aqua:BurntSushi/ripgrep aqua:google/go-jsonnet aqua:mikefarah/yq
else
  mise install
fi

# Install git hooks via lefthook (hooks live in the common .git/hooks, shared across worktrees)
if command -v lefthook > /dev/null 2>&1; then
  lefthook install
fi
